<%-include("../partials/user/header.ejs") %>

    <style>
        body,
        html {
            height: 90%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }
        .forgot-container {
            background: rgba(255, 255, 255, 0.95);
            display:flexbox;
            align-items: center;
            padding: 30px 50px;
            border-radius: 12px;
            max-width: 450px;
            height: 300px;
            margin: auto;
            margin-top: 230px;
            border: 1px solid #efe9e9;
            box-shadow: 5px 5px 5px #c9a12f;
        }
        .form-control:focus {
            box-shadow: unset;
            border-color: #c9a12f;
        }
        .btn-forgot {
            background-color: #c9a12f;
            color: rgb(255, 255, 255);
            font-weight: bold;
            max-width: 200px;
            width: 100%;
            margin-top: 40px;
            margin-left: 80px;
        }
        .btn-forgot:hover {
            background-color: #eec50f;
            color: #fff;
        }
        .backToLog{
            color: black;
            text-decoration: none;
        }
        .backToLog:hover{
            color: blue;
            text-decoration: underline;
        }
        h2 {
            font-weight: 700;
            color: #333;
        }
    </style>

    <div class="forgot-container">
        <h2 class="text-center mb-4">Forgot your Account</h2>
        <form id="forgotForm" method="POST" action="/forgotPassword">
            
            <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Enter email address" >
                <small id="emailError" style="color: red;"></small>
            </div>
            <div class="mb-3" style="margin-top: 10px;">
                <a href="/login" class="backToLog">Back to login?</a>
            </div>

            <%if(locals.message && message.length > 0){%>
                <div class="alert alert-danger text-center"><%=message%></div>
            <%}%>

            <button type="submit" class="btn btn-forgot w-100 mb-2">Continue</button>
        </form>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded",() => {
            const form = document.getElementById("forgotForm");
            const emailInput = document.getElementById("email");
            let emailError = document.getElementById("emailError");

            emailInput.addEventListener("blur",() => {
                const email = emailInput.value.trim();
                emailError.textContent = "";

                if(!email){
                    emailError.textContent = "Email should required";
                }else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
                    emailError.textContent = "Invalid email format";
                }
            });

            form.addEventListener("submit",(e) =>{
                let isValid = true;
                let email = emailInput.value.trim();
                emailError.textContent = "";

                if(!email){
                    emailError.textContent = "Email is required";
                    isValid = false;
                }else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
                    emailError = "Invalid email format";
                    isValid = false;
                }

                if(!isValid){
                    e.preventDefault();
                }
            });
        });
    </script>