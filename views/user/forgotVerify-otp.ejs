<%-include("../partials/user/header.ejs") %>

    <style>
        body,
        html {
            height: 100%;
            margin: 0;
            font-family: "Nunito Sans", sans-serif;
        }
        .forgot-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 93%;
            margin-top: 0px;
        }
        .login_wrap {
            width: 90%;
            max-width: 400px;
            padding: 20px;
            border-radius: 5px;
            background: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        .heading_s1 h3 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
            color: #333;
            text-align: center;
            margin-bottom: 30px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .otp-timer {
            display: inline-block;
            margin-left: 10px;
            font-size: 14px;
            position: relative;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            line-height: 60px;
            text-align: center;
            background: #f2f2f2;
            border: 2px solid #ddd;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        #timerValue {
            display: block;
            font-size: 24px;
            font-weight: bold;
            color: #333;
            line-height: 60px;
        }
        #timerValue.expired {
            font-size: 14px;
            color: red;
        }
        .btn-primary {
            background-color: #c9a12f;
            border: none;
            width: 100%;
            margin-top: 10px;
            display: block;
        }
        .btn-primary:hover {
            background-color: #db4437;
        }

        .btn-secondary {
            width: 100%;
            background-color: #db4437;
            border: none;
            margin-top: 10px;
            display: block;
        }
        .btn-secondary:hover {
            background-color: #c9a12f;
        }
        .alert-danger {
            margin-top: 15px;
            text-align: center;
        }
        .text-center {
            text-align: center;
            margin-top: 15px;
        }
        .text-muted {
            color: #6c757d;
            text-align: center;
        }
        .pt-25 {
            padding-top: 25px;
        }
    </style>

    <div class="forgot-container">
        <div class="login_wrap">
            <div class="padding_eight_all bg-white">
                <div class="heading_s1">
                    <h3>Email verification for forgot password</h3>
                </div>
                <form id="forgotOtpForm" >
                    <div class="form-group">
                        <label for="otp">Enter OTP:</label>
                        <input type="text" id="otp" name="otp" class="form-control" required maxlength="6" pattern="\d*" />
                        <small id="otpError" style="color: red;"></small>
                    </div>
                    <button type="submit" class="btn btn-primary">Verify Email</button>
                    <div class="form-group text-center">
                        <div id="otpTimer" class="otp-timer">
                            <span id="timerValue">60</span>
                        </div>
                        <button type="button" class="btn btn-secondary" id="resendBtn">Resend OTP</button>
                    </div>
                    <% if (locals.message && message.length> 0) { %>
                        <div class="alert alert-danger">
                            <%= message %>
                        </div>
                        <% } %>
                </form>
                <div class="text-muted text-center pt-25">
                    Already verified? <a style="color: #c9a12f;" href="/login">Login</a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        
        function validation(){
            const otp = document.getElementById("otp").value.trim();
            let isValid = true;
            const errorMsg = document.getElementById("otp");
            errorMsg.textContent = "";

            if(!otp){
                errorMsg.textContent = "OTP is required!";
                isValid = false;
            }else if(!/^\d{6}$/.test(otp)){
                errorMsg.textContent = "OTP is 6 digit number"
                isValid = false;
            }
            return isValid
        }

        document.getElementById("otp").focus();
        let timerInterval;

        function startTimer(duration = 60){
            clearInterval(timerInterval);
            let timer = duration;
            const otpField = document.getElementById("otp");
            const timerValue = document.getElementById("timerValue");

            otpField.disabled = false;
            timerValue.classList.remove("expired");
            timerValue.textContent = timer;

            timerInterval = setInterval(() => {
                timer--;
                timerValue.textContent = timer;
                if(timer < 0){
                    clearInterval(timerInterval)
                    timerValue.classList.add("expired");
                    timerValue.textContent = "Expired";
                    otpField.disabled = true;
                }
            },1000);
        }
        startTimer();

        document.getElementById('forgotOtpForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!validation())return
            const otpInput = document.getElementById('otp').value.trim();

            try {
                const res = await fetch('/forgotVerifyotp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp: otpInput })
                });

                const response = await res.json();

                if (response.success) {
                    await Swal.fire({ icon: 'success', title: 'OTP verified successfully', showConfirmButton: false, timer: 500 });
                    window.location.href = response.redirectUrl;
                } else {
                    await Swal.fire({ icon: 'error', title: 'Error', text: response.message||"Invalid OTP" });
                }
            } catch (err) {
                console.error('Fetch error:', err);
                await Swal.fire({ icon: 'error', title: 'Something went wrong', text: 'Please try again' });
            }
        });

        document.getElementById("resendBtn").addEventListener("click",async () => {
            try {
                startTimer()

                const res = await fetch("/resendForgotOtp", { method: "POST" });
                const response = await res.json();

                if (response.success) {
                    Swal.fire({
                        icon: "success",
                        title: "OTP resend successfull.",
                        showConfirmButton: false,
                        timer: 1500
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: response.message||"An error occured in resend OTP.Please try again"
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: "error",
                    title: "Oops!",
                    text: "Something wrong while processing ."
                });
            }
        });

    </script>