<%-include("../partials/user/header.ejs") %>

<link rel="stylesheet" href="/css/profile.css">

<div class="main-container">
        <div class="profile-layout">
            <!-- Sidebar -->
            <aside class="sidebar">
                <a href="/profile" class="sidebar-item">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span>Profile Info</span>
                </a>
                <a href="/addresses" class="sidebar-item active">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Manage Addresses</span>
                </a>
                <a href="/orders" class="sidebar-item">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span>Orders</span>
                </a>
                <a href="/wallet" class="sidebar-item">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span>Wallet</span>
                </a>
                <a href="/manage-password" class="sidebar-item">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span>Manage Password</span>
                </a>
                <a href="/logout" class="sidebar-item logout">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span>Logout</span>
                </a>
            </aside>

            <!-- Content Area -->
            <main class="content">
                <div class="content-header">
                    <h2>Add New Address</h2>
                    <a href="/addresses" class="btn-link">← Back to Addresses</a>
                </div>

                <form class="profile-form" id="addressForm">
                    <!-- Address Type -->
                    <div class="form-group">
                        <label for="addressType">Address Type *</label>
                        <select name="addressType" id="addressType" style="width: 100%; padding: 0.75rem 1rem; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 1rem;">
                            <option value="">Select Address Type</option>
                            <option value="Home"<%= locals.address && address.addressType === 'Home' ? 'selected' : "" %>>Home</option>
                            <option value="Work" <%= locals.address && address.addressType === 'Work' ? 'selected' : "" %> >Work</option>
                            <option value="Other" <%= locals.address && address.addressType === 'Other' ? 'selected' : "" %> >Other</option>
                        </select>
                        <small id="addressTypeError" class="errorMsg" ></small>
                    </div>

                    <!-- Name -->
                    <div class="form-group">
                        <label for="name">Full Name *</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <input type="text" id="name" name="name" placeholder="Enter full name" value="<%= locals.address ? address.name : '' %>">
                        </div>
                        <small id="nameError" class="errorMsg"></small>
                    </div>

                    <!-- Address -->
                     <div class="form-group">
                        <label for="address">Address *</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                            <input type="text" id="address" name="address" placeholder="Enter address" value="<%= locals.address ? address.address : '' %>">
                        </div>
                        <small id="addressError" class="errorMsg"></small>
                    </div>

                    <!-- Phone Numbers Row -->
                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone">Phone Number *</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                <input type="tel" id="phone" name="phone" placeholder="Enter 10-digit mobile number"  value="<%= locals.address ? address.phone : '' %>">
                            </div>
                            <small id="phoneError" class="errorMsg"></small>
                        </div>

                        <div class="form-group">
                            <label for="altPhone">Alternate Phone(optional)</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                <input type="tel" id="altPhone" name="altPhone" placeholder="Enter 10-digit mobile number"
                                  value="<%= locals.address ? address.altPhone : '' %>">
                            </div>
                            <small id="altPhoneError" class="errorMsg"></small>
                        </div>
                    </div>

                    <!-- City, State, Pincode Row -->
                    <div class="form-row">

                        <div class="form-group">
                            <label for="city">Street *</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                <input type="text" id="street" name="street" placeholder="Enter street" value="<%= locals.address ? address.city : '' %>">
                            </div>
                            <small id="streetError" class="errorMsg"></small>
                        </div>

                        <div class="form-group">
                            <label for="city">City *</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                <input type="text" id="city" name="city" placeholder="Enter city" value="<%= locals.address ? address.city : '' %>">
                            </div>
                            <small id="cityError" class="errorMsg"></small>
                        </div>

                        <div class="form-group">
                            <label for="state">State *</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <select id="state" name="state" style="width: 100%; padding: 0.75rem 2rem; border: 2px solid #e2e8f0; border-radius: 8px; color: rgb(133, 134, 133);">
                                    <option value="">Select State</option>
                                </select>
                            </div>
                            <small id="stateError" class="errorMsg"></small>
                        </div>

                        <div class="form-group">
                            <label for="pincode">Pincode *</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <input type="text" id="pincode" name="pincode" placeholder="6-digit pincode" value="<%= locals.address ? address.pincode : '' %>">
                            </div>
                            <small id="pincodeError" class="errorMsg"></small>
                        </div>
                    </div>

                    <!-- Landmark -->
                    <div class="form-group">
                        <label for="landMark">Landmark *</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            <input type="text" id="landMark" name="landMark" placeholder="Nearby landmark" value="<%= locals.address ? address.landMark : '' %>">
                        </div>
                        <small id="landmarkError" class="errorMsg"></small>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Address</button>
                        <a href="/addresses" class="btn btn-secondary" style="text-align: center; text-decoration: none; display: block;">Cancel</a>
                    </div>
                </form>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        const states = [
            "Andaman and Nicobar Islands", "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chandigarh",
            "Chhattisgarh", "Dadra and Nagar Haveli and Daman and Diu", "Delhi", "Goa", "Gujarat", "Haryana",
            "Himachal Pradesh", "Jammu and Kashmir", "Jharkhand", "Karnataka", "Kerala", "Ladakh", "Lakshadweep",
            "Madhya Pradesh", "Maharashtra", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Puducherry",
            "Punjab", "Rajasthan", "Sikkim", "Tamil Nadu", "Telangana", "Tripura", "Uttar Pradesh", "Uttarakhand", "West Bengal"
        ];

        // Pincode ranges by state (approximate; based on standard postal zones)
        const pincodeRanges = {
            "Andaman and Nicobar Islands": ["744101-744304"],
            "Andhra Pradesh": ["500001-534999"],
            "Arunachal Pradesh": ["791001-792999"],
            "Assam": ["781001-788999"],
            "Bihar": ["800001-854999"],
            "Chandigarh": ["160001-160036"],
            "Chhattisgarh": ["490001-497999"],
            "Dadra and Nagar Haveli and Daman and Diu": ["396210-396220", "396230-396240"],
            "Delhi": ["110001-110099"],
            "Goa": ["403001-403999"],
            "Gujarat": ["360001-396999"],
            "Haryana": ["121001-136999"],
            "Himachal Pradesh": ["171001-177999"],
            "Jammu and Kashmir": ["180001-190999"],
            "Jharkhand": ["815001-834999"],
            "Karnataka": ["560001-577999"],
            "Kerala": ["670001-695999"],
            "Ladakh": ["194001-194999"],
            "Lakshadweep": ["682001-682559"],
            "Madhya Pradesh": ["450001-488999"],
            "Maharashtra": ["400001-444999"],
            "Manipur": ["795001-795159"],
            "Meghalaya": ["793001-794999"],
            "Mizoram": ["796001-796999"],
            "Nagaland": ["797001-798999"],
            "Odisha": ["751001-770017"],
            "Puducherry": ["605001-609999"],
            "Punjab": ["140001-160999"],
            "Rajasthan": ["300001-349999"],
            "Sikkim": ["737101-737139"],
            "Tamil Nadu": ["600001-643999"],
            "Telangana": ["500001-509999"],
            "Tripura": ["799001-799289"],
            "Uttar Pradesh": ["200001-285999"],
            "Uttarakhand": ["246001-263999"],
            "West Bengal": ["700001-743999"]
        };

        // Populate state dropdown
        const stateSelect = document.getElementById("state");
        const initialState = "<%= locals.address ? address.state : '' %>".trim();
        states.forEach(state => {
            const option = document.createElement("option");
            option.value = state;
            option.textContent = state;
            if (state === initialState) {
                option.selected = true;
            }
            stateSelect.appendChild(option);
        });

        const addressForm = document.getElementById("addressForm");
        const addressTypeInput = document.getElementById("addressType");
        const nameInput = document.getElementById("name");
        const addressInput = document.getElementById("address");
        const phoneInput = document.getElementById("phone");
        const altPhoneInput = document.getElementById("altPhone");
        const streetInput = document.getElementById("street");
        const cityInput = document.getElementById("city");
        const stateInput = document.getElementById("state");
        const pincodeInput = document.getElementById("pincode");
        const landMarkInput = document.getElementById("landMark");

        function isValidPincodeForState(pincode, state) {
            if (!state || !pincode) return false;
            const ranges = pincodeRanges[state] || [];
            const pinNum = parseInt(pincode);
            for (let rangeStr of ranges) {
                const [startStr, endStr] = rangeStr.split('-');
                const start = parseInt(startStr);
                const end = parseInt(endStr);
                if (pinNum >= start && pinNum <= end) {
                    return true;
                }
            }
            return false;
        }

        function validation(){
            document.querySelectorAll(".errorMsg").forEach(el => el.textContent = "");
            let isValid = true;
            const addressType = addressTypeInput.value.trim() ,name = nameInput.value.trim() , address = addressInput.value.trim() ,
            phone = phoneInput.value.trim() , altPhone = altPhoneInput.value.trim() , street = streetInput.value.trim() ,
            city = cityInput.value.trim() , state = stateInput.value.trim() , pincode = pincodeInput.value.trim() ,
            landMark = landMarkInput.value.trim();

            const errors = {
                addressTypeError: "",
                nameError: "",
                addressError: "",
                phoneError: "",
                altPhoneError: "",
                streetError: "",
                cityError: "",
                stateError: "",
                pincodeError: "",
                landmarkError: ""
            };

            if(!addressType)errors.addressTypeError = "Please select an address type";

            if(!name||!/^(?=.*[A-Za-z])[A-Za-z\s._]+$/.test(name)){
                errors.nameError = "Name should have Charactors"
            }else if(name.length < 5 || name.length > 20)errors.nameError = "Name should contain 5 to 20 characters";

            if(!address)errors.addressError = "Address should required";

            if(!phone||!/^(?!([6-9])\1{9})[6-9]\d{9}$/.test(phone))errors.phoneError = "Phone number should be 10 digit valid number(not like this 0000000000)";

            if(!city||!/^[A-Za-z\s]+$/.test(city))errors.cityError = "City name should required";

            if(!state)errors.stateError = "State name should required";

            if(!street)errors.streetError = "Street name should required";

            if(!pincode || !/^[1-9][0-9]{5}$/.test(pincode)){
                errors.pincodeError = "Pincode should required 6-digits number(not allow 000000)";
            }else if(state && !isValidPincodeForState(pincode, state)){
                errors.pincodeError = `Pincode ${pincode} is not valid for ${state}. Please enter a pincode from ${state}.`;
            }

            if(!landMark ||!/^[A-Za-z\s]+$/.test(landMark))errors.landmarkError = "Landmark should required";

            Object.keys(errors).forEach(id => {
                document.getElementById(id).textContent = errors[id];
                if(errors[id])isValid = false
            });

            return isValid
        }

        addressForm.addEventListener("submit",async(event) => {
            try {
                event.preventDefault();

                const formData = {
                    addressType:addressTypeInput.value.trim(),
                    name:nameInput.value.trim(),
                    address:addressInput.value.trim(),
                    phone:phoneInput.value.trim(),
                    altPhone:altPhoneInput.value.trim(),
                    street:streetInput.value.trim(),
                    city:cityInput.value.trim(),
                    state:stateInput.value.trim(),
                    pincode:pincodeInput.value.trim(),
                    landMark:landMarkInput.value.trim()
                }

                if(!validation())return

                const response = await fetch("/addAddress",{
                    method:"POST",
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify(formData)
                });

                const data = await response.json();

                if(data.success){
                    Swal.fire({
                        icon:"success",
                        title:"Created.",
                        text:data.message||"Address created successfully.",
                        showConfirmButton:false,
                        timer:1500
                    })
                    .then(() => window.location.href = data.redirectUrl)
                }else{
                    Swal.fire({
                        icon:"error",
                        title:"Error!",
                        text:data.message||"Error occure while adding address",
                    })
                }

            } catch (error) {
                Swal.fire({
                    icon:"error",
                    title:"Something Wrong!",
                    text:"Something went wrong while adding address",
                })
            }
        });

    </script>