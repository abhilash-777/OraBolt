<%- include("../partials/user/header.ejs") %> 
<%-include("../partials/bread_crumb.ejs",{pageTitle:"Cart",pageName:"Cart"}) %>

	<section class="ftco-section ftco-cart">
		<div class="container">
			<div class="row">
				<div class="col-md-12 ftco-animate">
					<div class="cart-list">
						<table class="table">
							<thead class="thead-primary">
								<tr class="text-center">
									<th>&nbsp;</th>
									<th>Image</th>
									<th>Product</th>
									<th>Price</th>
									<th>Quantity</th>
									<th>Total</th>
								</tr>
							</thead>
							<tbody>
								<% if (cartItems.length> 0) { %>
									<% cartItems.forEach(item=> { %>
										<tr class="text-center <%= item.isOutOfStock ? 'text-muted' : '' %>">
											<td class="product-remove">
												<a href="/cart/remove/<%= item.productId._id %>"><span class="ion-ios-close"></span></a>
											</td>
											<td class="image-prod">
												<img src="/uploads/productsImages/<%= item.productId.image[0] %>" width="80" height="80">
											</td>
											<td class="product-name">
												<a href="/product/<%= item.productId._id %>" style="color: black;" >
													<%= item.productId?.productName %>
												</a><br>
												<% if (item.availabilityStatus === "Available") { %>
                                                    <small class="text-success">Available</small>
                                                <% } else if (item.availabilityStatus === "Out of Stock") { %>
                                                    <small class="text-warning">Out of Stock</small>
                                                <% } else { %>
                                                    <small class="text-danger">Not Available</small>
                                                <% } %>
											</td>
											<td class="price">&#8377;<%= item.price %></td>
											<td class="quantity align-middle">
												<div class="input-group input-group-sm justify-content-center" style="max-width: 130px;">
													<button class="btn btn-outline-dark btn-sm decrease" data-id="<%= item.productId._id %>"
														style="width:35px; border-radius: 6px 0 0 6px;" 
														<%= item.isOutOfStock ? 'disabled' : '' %> >−</button>
													<input type="text" class="form-control text-center border-dark" value="<%= item.quantity %>" readonly
														style="max-width: 55px;">
													<button class="btn btn-outline-dark btn-sm increase" data-id="<%= item.productId._id %>"
														style="width:35px; border-radius: 0 6px 6px 0;" 
														<%= item.isOutOfStock ? 'disabled' : '' %> >+</button>
												</div>
											</td>
											<td class="total">&#8377;<%= item.totalPrice = item.quantity * item.price %></td>
										</tr>
									<% }) %>
								<% } else { %>
									<tr>
										<td colspan="6" class="text-center py-5">
                                            <div>
												<i class="icon-shopping_cart display-1 text-muted mb-3 d-block"></i>
                                                <h5 class="mb-3">Your cart is empty</h5>
                                                <a href="/shop" class="btn btn-primary px-4 py-2">Start Shopping</a>
                                            </div>
                                        </td>
									</tr>
								<% } %>
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<% if (cartItems && cartItems.length> 0) {
				const subTotal = cartItems.reduce((sum, item) => sum + item.totalPrice, 0);
				%>
				<div class="row justify-content-start">
					<div class="col col-lg-5 col-md-6 mt-5 cart-wrap ftco-animate">
						<div class="cart-total mb-3">
							<h3>Cart Totals</h3>
							<p class="d-flex">
								<span>Subtotal</span>
								<span>&#8377;<%= subTotal %></span>
							</p>
							<p class="d-flex">
								<span>Delivery</span>
								<span>&#8377;0.00</span>
							</p>
							<p class="d-flex">
								<span>Discount</span>
								<span>&#8377;0.00</span>
							</p>
							<hr>
							<p class="d-flex total-price">
								<span>Total</span>
								<span>&#8377;<%= subTotal %></span>
							</p>
						</div>
						<p class="text-center">
							<a href="/checkout" class="btn btn-primary py-3 px-4">
								Proceed to Checkout
							</a>
						</p>
					</div>
				</div>
			<% } %>
		</div>
	</section>

    <!-- jQuery (required for Bootstrap) -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <!-- Popper.js (required for Bootstrap dropdowns) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <script>
            Swal.fire({
                icon: "warning",
                title: "Stock Alert",
                text: "<%= errorMsg %>",
                confirmButtonText: "OK"
            });
			
        </script>
    <% } %>
	<script>
        document.addEventListener("DOMContentLoaded", () => {
    const increaseBtns = document.querySelectorAll(".increase");
    const decreaseBtns = document.querySelectorAll(".decrease");

    // Function to update quantity
    const updateQuantity = async (productId, action) => {
        try {
            const response = await fetch("/cart/update", {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ productId, action }),
            });

            const data = await response.json();
            
            if (data.success) {
                // Find the row for this product
                const row = document.querySelector(`button[data-id="${productId}"]`).closest('tr');
                const quantityInput = row.querySelector('input[type="text"]');
                const totalCell = row.querySelector('.total');
                const priceCell = row.querySelector('.price');
                
                // Get current values
                let currentQty = parseInt(quantityInput.value);
                const price = parseInt(priceCell.textContent.replace('₹', '').trim());
                
                // Update quantity
                if (action === "increase") {
                    currentQty += 1;
                } else if (action === "decrease") {
                    currentQty -= 1;
                }
                
                // Update the DOM
                quantityInput.value = currentQty;
                const newTotal = currentQty * price;
                totalCell.textContent = `₹${newTotal}`;
                
                // Update cart totals
                updateCartTotals();
                
            } else {
                Swal.fire({
                    icon: "error",
                    title: "Item quantity reached!",
                    text: data.message || "You can only add upto 5 unit of this product",
                    showConfirmButton: true
                });
            }
        } catch (error) {
            console.error("Error updating quantity:", error);
            Swal.fire({
                icon: "error",
                title: "Oops!",
                text: "Something went wrong while updating quantity",
            });
        }
    };

    // Function to recalculate and update cart totals
    const updateCartTotals = () => {
        let subtotal = 0;
        
        // Calculate subtotal from all rows
        document.querySelectorAll('tbody tr').forEach(row => {
            const totalCell = row.querySelector('.total');
            if (totalCell) {
                const total = parseInt(totalCell.textContent.replace('₹', '').trim());
                if (!isNaN(total)) {
                    subtotal += total;
                }
            }
        });
        
        // Update the cart totals section
        const subtotalElement = document.querySelector('.cart-total .d-flex span:last-child');
        const totalElement = document.querySelector('.cart-total .total-price span:last-child');
        
        if (subtotalElement) {
            subtotalElement.textContent = `₹${subtotal}`;
        }
        if (totalElement) {
            totalElement.textContent = `₹${subtotal}`;
        }
    };

    // Increase quantity
    increaseBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            const productId = btn.dataset.id;
            updateQuantity(productId, "increase");
        });
    });

    // Decrease quantity
    decreaseBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            const productId = btn.dataset.id;
            updateQuantity(productId, "decrease");
        });
    });
});
    </script>

	<%- include("../partials/user/footer.ejs") %>