<%-include("../partials/user/header.ejs") %>

<%-include("../partials/bread_crumb.ejs",{pageTitle:product.productName,pageName:product.productName}) %>

    <style>
		.product-image-gallery {
    display: flex;
    gap: 15px;
    height: 500px; /* Fixed height to match main image */
    align-items: flex-start;
}

.main-image-container {
    position: relative;
    flex: 1; /* Take remaining space */
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    background: #f8f9fa;
    border: 1px solid rgba(0, 0, 0, 0.05);
}

.main-image {
    width: 100%;
    height: 400px;
    object-fit: fill;
    cursor: zoom-in;
    transition: all 0.1s ease;
    display: block;
}

.main-image:hover {
    transform: scale(1.03);
}

/* Zoomed state for in-place zoom */
.main-image.zoomed {
    cursor: grab;
    transition: none; /* Instant for pan */
}

.main-image.zoomed:active {
    cursor: grabbing;
}

.image-counter {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    z-index: 10;
    backdrop-filter: blur(10px);
}

.vertical-thumbnail-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 85px; /* Fixed width for thumbnails */
    height: 100%;
    overflow-y: auto;
    padding: 0 5px;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: #dee2e6 #f8f9fa;
    flex-shrink: 0; /* Prevent shrinking */
}

.vertical-thumbnail-container::-webkit-scrollbar {
    width: 8px;
}

.vertical-thumbnail-container::-webkit-scrollbar-track {
    background: #f8f9fa;
    border-radius: 10px;
}

.vertical-thumbnail-container::-webkit-scrollbar-thumb {
    background: #dee2e6;
    border-radius: 10px;
    transition: background 0.3s ease;
}

.vertical-thumbnail-container::-webkit-scrollbar-thumb:hover {
    background: #adb5bd;
}

.thumbnail {
    width: 100%;
    height: 85px;
    object-fit: cover;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 3px solid transparent;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    opacity: 0.8;
    flex-shrink: 0;
}

.thumbnail:hover {
    transform: translateY(-2px) scale(1.05);
    border-color: #0066cc;
    opacity: 1;
    box-shadow: 0 4px 15px rgba(0, 102, 204, 0.3);
}

.thumbnail.active {
    border-color: #007bff;
    transform: translateY(-2px) scale(1.05);
    opacity: 1;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4);
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 5;
}

.gallery-nav:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: translateY(-50%) scale(1.1);
}

.gallery-nav.prev {
    left: 15px;
}

.gallery-nav.next {
    right: 15px;
}

.image-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 450px;
    background: #f8f9fa;
    border-radius: 12px;
}

.loading-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #e9ecef;
    border-top: 4px solid #007bff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.product-details h3 {
    font-size: 2.2rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 15px;
    line-height: 1.2;
}

.product-price {
    font-size: 1.8rem;
    font-weight: 700;
    color: #e74c3c;
    margin-bottom: 20px;
}

.product-description {
    color: #6c757d;
    line-height: 1.6;
    margin-bottom: 25px;
    font-size: 1.1rem;
}

.stock-info {
    background: #d4edda;
    color: #155724;
    padding: 8px 15px;
    border-radius: 6px;
    display: inline-block;
    font-weight: 500;
    margin-bottom: 20px;
}

.stock-info.low-stock {
    background: #f8d7da;
    color: #721c24;
}

@media (max-width: 992px) {
    .product-details {
        padding-left: 0 !important;
        margin-top: 30px;
        margin-left: 20px;
    }
    .product-image-gallery {
        flex-direction: column;
        height: auto;
        gap: 15px;
    }
    .vertical-thumbnail-container {
        flex-direction: row;
        width: auto;
        height: 85px;
        overflow-x: auto;
        overflow-y: hidden;
        gap: 12px;
    }

    .thumbnail {
        width: 85px;
        height: 100%;
        min-width: 85px;
    } 
}

@media (max-width: 768px) {
    .main-image-container {
        aspect-ratio: 1 / 1;
        max-height: 350px;
    }

    .main-image{
        height: 100%;
        margin-left: 20px;
    }
    
    .thumbnail {
        width: 70px;
        height: 70px;
        min-width: 70px;
    }
    
    .vertical-thumbnail-container {
        gap: 8px;
    }
    
    .product-details h3 {
        font-size: 1.8rem;
    }
    
    .gallery-nav {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    .image-counter {
        font-size: 12px;
        padding: 6px 10px;
    }

    /* Mobile zoom: simple scale on double-tap */
    .main-image.zoomed {
        transform: scale(1.5) !important;
        cursor: zoom-out;
    }
}

@media (max-width: 576px) {
    .main-image {
        height: 250px;
    }
    
    .thumbnail {
        width: 60px;
        height: 60px;
    }
    
    .product-details h3 {
        font-size: 1.6rem;
    }
    
    .vertical-thumbnail-container {
        gap: 6px;
    }
}

* {
    -webkit-tap-highlight-color: transparent;
}

.thumbnail,
.main-image,
.gallery-nav {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
}

.thumbnail:focus,
.gallery-nav:focus {
    outline: 2px solid #007bff;
    outline-offset: 2px;
}

.main-image:focus {
    outline: 2px solid #007bff;
    outline-offset: 4px;
}
/* Wishlist icon on product image */
        .wishlist-icon {
	        position: absolute;
	        top: 10px;
        	right: 10px;
        	border-radius: 50%;
            margin-right: 50px;
            margin-top: 10px;
        	z-index: 10;
           	color: #fbcccc;
        	font-size: 18px;
          	transition: all 0.2s ease;
        	text-decoration: none;
        }

        .wishlist-icon:hover {
	        color: #ff4d4d;
	        transform: scale(1.1);
        }

		.heart-icon {
            font-size: 24px;
            color: #ccc;
            transition: all 0.3s ease;
        }

        /* Heart icon when in wishlist - filled/darker */
        .heart-icon.in-wishlist {
            color: #e74c3c;  /* Red color for filled heart */
        }

        /* Hover effect */
        .wishlist-icon:hover .heart-icon {
            transform: scale(1.2);
        }

        .wishlist-icon:hover .heart-icon:not(.in-wishlist) {
            color: #e74c3c;
            opacity: 0.7;
        }

        .img-prod {
        	position: relative;
        	display: block;
           	overflow: hidden;
        }
        /* User Review Card Styles */
        .border-left-primary {
            border-left: 4px solid #007bff !important;
        }

        .alert-info.border-left-primary {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Star Rating Styles */
        .star-rating-input .stars-interactive {
            font-size: 40px;
            cursor: pointer;
            display: inline-block;
        }

        .star-input {
            color: #ddd;
            transition: color 0.2s;
            cursor: pointer;
            margin: 0 3px;
        }

        .star-input:hover,
        .star-input.active {
            color: #f4c430;
        }

        .rating-bars .progress {
            background-color: #f0f0f0;
        }

        .review-images img {
            cursor: pointer;
            transition: transform 0.2s;
        }

        .review-images img:hover {
            transform: scale(1.05);
        }

        .helpful-btn.marked {
            background-color: #007bff;
            color: white;
        }
	</style>

	<section class="ftco-section">
		<div class="container">
			<div class="row">
				<div class="col-lg-6 mb-5 ftco-animate">
                <div class="product-image-gallery">
                    <!-- Vertical Thumbnails (Left Side) -->
                    <% if (product.image && product.image.length > 1) { %>
                        <div class="vertical-thumbnail-container">
                            <% product.image.forEach((image, index) => { %>
                                <img src="/uploads/productsImages/<%= image %>" 
                                     alt="<%= product.productName %> - Image <%= index + 1 %>" 
                                     class="thumbnail <%= index === 0 ? 'active' : '' %>" 
                                     data-index="<%= index %>">
                            <% }); %>
                        </div>
                    <% } %>
                    
                    <!-- Main Image Display -->
                    <div class="main-image-container">
                        <% if(user && user !== 'undefined'){ %>
                            <button class="wishlist-icon" title="<%= isWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
							    onclick="event.stopPropagation(); addToWishlist('<%= product._id %>')"
			     			    style="background: none; border: none; cursor: pointer; position: absolute; top: 10px; right: 10px; z-index: 10;">
							    <span class="icon-heart heart-icon <%= isWishlist ? 'in-wishlist' : '' %>"></span>
						    </button>
                        <% } %>
                        <% if (product.image && product.image.length > 0) { %>
                            <img id="mainImage" 
                                 src="/uploads/productsImages/<%= product.image[0] %>" 
                                 class="img-fluid main-image" 
                                 alt="<%= product.productName %>">
                        <% } else { %>
                            <img id="mainImage" 
                                 src="/uploads/productsImages/default.png" 
                                 class="img-fluid main-image" 
                                 alt="<%= product.productName %>">
                        <% } %>
                        
                        <!-- Image Counter -->
                        <div class="image-counter">
                            <span id="currentImageIndex">1</span> / <span id="totalImages"><%= product.image ? product.image.length : 1 %></span>
                        </div>
                    </div>
                </div>
            </div>
				<div class="col-lg-6 product-details pl-md-5 ftco-animate">
					<h3><%= product.productName %></h3>
					<div class="rating d-flex">
						<p class="text-left mr-4">
							<a href="#" class="mr-2">5.0</a>
							<a href="#"><span class="ion-ios-star-outline"></span></a>
							<a href="#"><span class="ion-ios-star-outline"></span></a>
							<a href="#"><span class="ion-ios-star-outline"></span></a>
							<a href="#"><span class="ion-ios-star-outline"></span></a>
							<a href="#"><span class="ion-ios-star-outline"></span></a>
						</p>
						<p class="text-left mr-4">
							<a href="#" class="mr-2" style="color: #000;">100 <span
									style="color: #bbb;">Rating</span></a>
						</p>
					</div>
					<div class="pricing">
                        <% if (product.hasOffer) { %>
                            <p class="price">
                                <span style="text-decoration: line-through; color: #999; font-size: 14px; margin-right: 8px;">
                                    &#8377;<%= product.regularPrice %>
                                </span>
                                <span style="color: #000; font-weight: bold;">
                                    &#8377;<%= product.offerPrice %>
                                </span>
                            </p>
                            <p style="color: #28a745; font-size: 12px; margin-top: -8px;">
                                You save &#8377;<%= product.savings %>
                            </p>
                            <% } else { %>
                                <p class="price"><span>&#8377;<%= product.regularPrice %></span></p>
                            <% } %>
                        </div>
					<p></p>
					<p><%= product.description %></p>
					<div class="row mt-4">
						<div class="w-100"></div>
						<div class="input-group col-md-6 d-flex mb-3">
							<span class="input-group-btn mr-2">
								<button type="button" class="quantity-left-minus btn" data-type="minus" data-field=""
                                <% if(product.quantity <= 0 || categoryUnlisted) { %>disabled<% } %>>
									<i class="ion-ios-remove"></i>
								</button>
							</span>
							<input type="text" id="quantity" name="quantity" class="quantity form-control input-number"
								value="1" min="1" max="<% product.quantity > 0 ? product.quantity : 0 %>" 
                                <% if(product.quantity <= 0 || categoryUnlisted) { %>readonly disabled<% } %>>
							<span class="input-group-btn ml-2">
								<button type="button" class="quantity-right-plus btn" data-type="plus" data-field=""
                                <% if(product.quantity <= 0 || categoryUnlisted) { %>disabled<% } %>>
									<i class="ion-ios-add"></i>
								</button>
							</span>
						</div>
						<div class="w-100"></div>
                        <% if(categoryUnlisted) { %>
                            <div class="col-md-12 mb-3">
                                <div class="alert alert-warning" role="alert" 
                                style="border-left: 4px solid #ff9800; background-color: #fff3cd; padding: 15px; margin-top: 5px; border-radius: 5px;">
                                    <strong><i class="ion-ios-alert" style="font-size: 15px; margin-right: 5px;"></i> Product Unavailable</strong>
                                    <p style="margin: 10px 0 0 0; color: #856404;"><%= unavailableMessage %></p>
                                </div>
                            </div>
                        <% } %>
						<% if(product.quantity <= 0){ %>
                            <div class="col-md-12">
							    <p style="color: #ff0202;">Stock : Out Of Stock %></p>
                                <a href="/shop" class="btn btn-primary py-3 px-5">Back to Shop Page</a>
						    </div>
                        <% }else{ %>
                            <div class="col-md-12">
							    <p style="color: #000;"><%= product.isListed ? product.status :"Unavailable" %></p>
						    </div>
                            <div class="col-md-12">
							    <p style="color: #000;">Stock : <%= product.quantity %></p>
						    </div>
                            <% if(user){ %>
                                <% if(categoryUnlisted === true){ %>
                                    <a href="/" class="btn btn-primary py-3 px-5">Back to Home Page</a>
                                <% } else { %>
                                    <p>
                                        <a href="#" class=" add-to-cart btn btn-black py-3 px-5 mr-2" data-id="<%= product._id %>">Add to Cart</a>
						                <a href="/checkout?productId=<%= product._id %>&qty=1" class="btn btn-primary py-3 px-5">Buy now</a>
                                    </p>
                                <% } %>
                            <% } else { %>
                                <p>
                                    <a href="/login" class="btn btn-black py-3 px-5 mr-2">Add to Cart</a>
						            <a href="/login" class="btn btn-primary py-3 px-5">Buy now</a>
                                </p>
                            <% } %>
                        <% } %>
					</div>
				</div>
			</div>

			<div class="row mt-3">
				<div class="col-md-12 nav-link-wrap">
					<div class="nav nav-pills d-flex text-center" id="v-pills-tab" role="tablist"
						aria-orientation="vertical">
						<a class="nav-link ftco-animate active mr-lg-1" id="v-pills-1-tab" data-toggle="pill"
							href="#v-pills-1" role="tab" aria-controls="v-pills-1" aria-selected="true">Description</a>

						<a class="nav-link ftco-animate mr-lg-1" id="v-pills-2-tab" data-toggle="pill" href="#v-pills-2"
							role="tab" aria-controls="v-pills-2" aria-selected="false">Manufacturer</a>

						<a class="nav-link ftco-animate" id="v-pills-3-tab" data-toggle="pill" href="#v-pills-3"
							role="tab" aria-controls="v-pills-3" aria-selected="false">Reviews</a>

					</div>
				</div>
				<div class="col-md-12 tab-wrap">

					<div class="tab-content bg-light" id="v-pills-tabContent">

						<div class="tab-pane fade show active" id="v-pills-1" role="tabpanel"
							aria-labelledby="day-1-tab">
							<div class="p-4">
								<h3 class="mb-4"><%= product.productName %></h3>
								<p><%= product.description %></p>
							</div>
						</div>

						<div class="tab-pane fade" id="v-pills-2" role="tabpanel" aria-labelledby="v-pills-day-2-tab">
							<div class="p-4">
								<h3 class="mb-4">Manufactured By Rolex</h3>
								<p>On her way she met a copy. The copy warned the Little Blind Text, that where it came
									from it would have been rewritten a thousand times and everything that was left from
									its origin would be the word "and" and the Little Blind Text should turn around and
									return to its own, safe country. But nothing the copy said could convince her and so
									it didn’t take long until a few insidious Copy Writers ambushed her, made her drunk
									with Longe and Parole and dragged her into their agency, where they abused her for
									their.</p>
							</div>
						</div>
						<!-- Reviews Tab Content -->
                        <div class="tab-pane fade" id="v-pills-3" role="tabpanel" aria-labelledby="v-pills-day-3-tab">
                            <div class="row p-4">
                                <!-- Left Column: Reviews List -->
                                <div class="col-md-8">
                                    <!-- Rating Summary -->
                                    <div class="rating-summary mb-4">
                                        <div class="d-flex align-items-center mb-3">
                                            <h2 class="display-4 mb-0 mr-3"><%= ratingData.average.toFixed(1) %></h2>
                                            <div>
                                                <div class="stars mb-1">
                                                    <% for(let i = 1; i <= 5; i++) { %>
                                                        <i class="<%= i <= Math.round(ratingData.average) ? 'ion-ios-star' : 'ion-ios-star-outline' %>"></i>
                                                    <% } %>
                                                </div>
                                                <p class="text-muted mb-0"><%= ratingData.total %> reviews</p>
                                            </div>
                                        </div>

                                        <!-- Rating Distribution -->
                                        <div class="rating-bars">
                                            <% for(let star = 5; star >= 1; star--) { %>
                                                <div class="d-flex align-items-center mb-2">
                                                    <span class="mr-2"><%= star %> <i class="ion-ios-star"></i></span>
                                                    <div class="progress flex-grow-1 mr-2" style="height: 8px;">
                                                        <% const percentage = ratingData.total > 0 ? (ratingData.distribution[star] / ratingData.total * 100) : 0; %>
                                                        <div class="progress-bar bg-warning" role="progressbar" 
                                                            style="width: <%= percentage %>%"></div>
                                                    </div>
                                                    <span class="text-muted small"><%= ratingData.distribution[star] %></span>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Write Review Button OR User's Review -->
                                    <% if(user && userReview) { %>
                                        <!-- User's Existing Review -->
                                        <div class="alert alert-info border-left-primary mb-4">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h5 class="mb-2">
                                                        <i class="ion-ios-checkmark-circle text-success"></i> Your Review
                                                    </h5>
                                                    <div class="stars mb-2">
                                                        <% for(let i = 1; i <= 5; i++) { %>
                                                            <i class="<%= i <= userReview.rating ? 'ion-ios-star' : 'ion-ios-star-outline' %>" 
                                                               style="color: #f4c430; font-size: 18px;"></i>
                                                        <% } %>
                                                    </div>
                                                    <h6 class="mb-1"><%= userReview.title %></h6>
                                                    <p class="mb-0"><%= userReview.comment %></p>
                                                    <small class="text-muted">
                                                        Posted on <%= new Date(userReview.createdAt).toLocaleDateString('en-US', { 
                                                            year: 'numeric', month: 'long', day: 'numeric' 
                                                        }) %>
                                                    </small>
                                                </div>
                                                <div class="ml-3">
                                                    <button class="btn btn-sm btn-outline-primary mb-2" 
                                                        onclick="editUserReview('<%= userReview._id %>', <%= userReview.rating %>, '<%= userReview.title.replace(/'/g, "\\'") %>', '<%= userReview.comment.replace(/'/g, "\\'").replace(/\n/g, "\\n") %>')">
                                                        <i class="ion-ios-create"></i> Edit
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                        onclick="deleteUserReview('<%= userReview._id %>')">
                                                        <i class="ion-ios-trash"></i> Delete
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    <% } else if(user && canReview && !userReview) { %>
                                        <button class="btn btn-primary mb-4" data-toggle="modal" data-target="#reviewModal">
                                            <i class="ion-ios-create"></i> Write a Review
                                        </button>
                                    <% } else if(!canReview && user) { %>
                                        <div class="alert alert-info">
                                            <i class="ion-ios-information-circle"></i> Purchase and receive this product to write a review
                                        </div>
                                    <% } %>

                                    <!-- Filter and Sort -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <select id="ratingFilter" class="form-control form-control-sm d-inline-block w-auto">
                                                <option value="">All Ratings</option>
                                                <option value="5">5 Stars</option>
                                                <option value="4">4 Stars</option>
                                                <option value="3">3 Stars</option>
                                                <option value="2">2 Stars</option>
                                                <option value="1">1 Star</option>
                                            </select>
                                        </div>
                                        <div>
                                            <select id="sortReviews" class="form-control form-control-sm">
                                                <option value="recent">Most Recent</option>
                                                <option value="helpful">Most Helpful</option>
                                                <option value="rating-high">Highest Rating</option>
                                                <option value="rating-low">Lowest Rating</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Reviews List -->
                                    <div id="reviewsList">
                                        <% if(recentReviews && recentReviews.length > 0) { %>
                                            <% recentReviews.forEach(review => { %>
                                                <div class="review mb-4 pb-4 border-bottom">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <h5 class="mb-1"><%= review.userId?.name || 'Anonymous' %></h5>
                                                            <div class="stars mb-1">
                                                                <% for(let i = 1; i <= 5; i++) { %>
                                                                    <i class="<%= i <= review.rating ? 'ion-ios-star' : 'ion-ios-star-outline' %>" 
                                                                        style="color: #f4c430;"></i>
                                                                <% } %>
                                                            </div>
                                                            <p class="text-muted small mb-0">
                                                                <%= new Date(review.createdAt).toLocaleDateString('en-US', { 
                                                                    year: 'numeric', month: 'long', day: 'numeric' 
                                                                }) %>
                                                                <% if(review.isVerifiedPurchase) { %>
                                                                    <span class="badge badge-success ml-2">Verified Purchase</span>
                                                                <% } %>
                                                            </p>
                                                        </div>
                                                    </div>
                            
                                                    <h6 class="mb-2"><%= review.title %></h6>
                                                    <p class="mb-2"><%= review.comment %></p>
                            
                                                    <% if(user) { %>
                                                        <button class="btn btn-sm btn-outline-secondary helpful-btn" 
                                                            data-review-id="<%= review._id %>">
                                                            <i class="ion-ios-thumbs-up"></i> 
                                                            Helpful (<span class="helpful-count"><%= review.helpfulCount %></span>)
                                                        </button>
                                                    <% } else { %>
                                                        <span class="text-muted small">
                                                            <i class="ion-ios-thumbs-up"></i> <%= review.helpfulCount %> people found this helpful
                                                        </span>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-5">
                                                <i class="ion-ios-chatbubbles" style="font-size: 48px; color: #ccc;"></i>
                                                <p class="text-muted mt-3">No reviews yet. Be the first to review this product!</p>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Load More Button -->
                                    <div class="text-center mt-4" id="loadMoreContainer" style="display: none;">
                                        <button class="btn btn-outline-primary" id="loadMoreReviews">
                                            Load More Reviews
                                        </button>
                                    </div>
                                </div>

                                <!-- Right Column -->
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title mb-3">Customer Reviews</h5>
                                            <div class="text-center mb-3">
                                                <h2>
                                                    <%= ratingData.average.toFixed(1) %>
                                                </h2>
                                                <div class="stars">
                                                    <% for(let i=1; i <=5; i++) { %>
                                                        <i class="<%= i <= Math.round(ratingData.average) ? 'ion-ios-star' : 'ion-ios-star-outline' %>"
                                                            style="color: #f4c430;"></i>
                                                    <% } %>
                                                </div>
                                                <p class="text-muted small">Based on <%= ratingData.total %> reviews</p>
                                            </div>
                                
                                            <% if(user && canReview && !userReview) { %>
                                                <button class="btn btn-primary btn-block" data-toggle="modal" data-target="#reviewModal">
                                                    Write a Review
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                </div>
                                </div>

                        <!-- Review Modal (for Add/Edit) -->
                        <div class="modal fade" id="reviewModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog modal-lg" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="reviewModalTitle">Write a Review</h5>
                                        <button type="button" class="close" data-dismiss="modal">
                                            <span>&times;</span>
                                        </button>
                                    </div>
                                    <form id="reviewForm">
                                        <div class="modal-body">
                                            <!-- Rating -->
                                            <div class="form-group">
                                                <label>Rating *</label>
                                                <div class="star-rating-input">
                                                    <input type="hidden" id="rating" name="rating" value="0" required>
                                                    <div class="stars-interactive">
                                                        <i class="ion-ios-star-outline star-input" data-rating="1"></i>
                                                        <i class="ion-ios-star-outline star-input" data-rating="2"></i>
                                                        <i class="ion-ios-star-outline star-input" data-rating="3"></i>
                                                        <i class="ion-ios-star-outline star-input" data-rating="4"></i>
                                                        <i class="ion-ios-star-outline star-input" data-rating="5"></i>
                                                    </div>
                                                </div>
                                                <small class="form-text text-muted">Click to rate</small>
                                            </div>
                        
                                            <!-- Title -->
                                            <div class="form-group">
                                                <label for="reviewTitle">Review Title *</label>
                                                <input type="text" class="form-control" id="reviewTitle"
                                                    placeholder="Sum up your review in one line" maxlength="100" required>
                                                <small class="form-text text-muted">Max 100 characters</small>
                                            </div>
                        
                                            <!-- Comment -->
                                            <div class="form-group">
                                                <label for="reviewComment">Your Review *</label>
                                                <textarea class="form-control" id="reviewComment" rows="5"
                                                    placeholder="Tell us what you think about this product" maxlength="1000"
                                                    required></textarea>
                                                <small class="form-text text-muted">
                                                    <span id="commentCount">0</span>/1000 characters
                                                </small>
                                            </div>
                        
                                            <input type="hidden" id="productId" value="<%= product._id %>">
                                            <input type="hidden" id="reviewId" value="">
                                            <input type="hidden" id="isEditing" value="false">
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary" id="submitReviewBtn">
                                                <i class="ion-ios-checkmark"></i> Submit Review
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
					</div>
				</div>
			</div>

            <div class="container similar-product-section">
                <h3 class="mb-4">Similar Products</h3>
                <div class="row">
                    <% if (similarProducts && similarProducts.length> 0) { %>
                        <% similarProducts.forEach(product=> { %>
                            <div class="col-sm-12 col-md-6 col-lg-3 ftco-animate d-flex mb-4">
                                <div class="product d-flex flex-column">
                                    <a href="/product/<%= product._id %>" class="img-prod">
                                        <img class="img-fluid" src="/uploads/productsImages/<%= product.image[0] %>"
                                            alt="<%= product.productName %>"
                                            onerror="this.src='/uploads/productsImages/default.jpg'">
                                        <% if (product.productOffer> 0) { %>
                                            <span class="status">
                                                <%= product.productOffer %>% OFF
                                            </span>
                                            <% } %>
                                                <div class="overlay"></div>
                                    </a>
                                    <div class="text py-3 pb-4 px-3">
                                        <div class="d-flex justify-content-between">
                                            <h3><a href="/product/<%= product._id %>">
                                                    <%= product.productName %>
                                                </a></h3>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="pricing">
                                                <% if (product.productOffer> 0) { %>
                                                    <p class="price">
                                                        <span class="mr-2 price-dc">&#8377;<%= product.regularPrice %></span>
                                                        <span class="price-sale">&#8377;<%= product.salePrice %></span>
                                                    </p>
                                                    <% } else { %>
                                                        <p class="price"><span>&#8377;<%= product.salePrice %></span></p>
                                                        <% } %>
                                            </div>
                                            <div class="rating">
                                                <span class="text-muted small">
                                                    <%= product.status %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No similar product found.</p>
                    <% } %>
                </div>
            </div>

		</div>
	</section>

    <script src="/js/review.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>

        async function addToWishlist(productId) {
			try {
				const response = await fetch(`/wishlist/add/${productId}`,{
					method:"POST",
				});
				const data = await response.json();
				if(data.success){
					Swal.fire({
						icon:"success",
						title:"Added.",
						text:data.message,
						showConfirmButton:false,
						timer:1500
					})
					window.location.href = `/product/${productId}`
				}else{
					Swal.fire({icon:"error",title:"Failed!",text:"Failed to add item into wishlist"});
				}
			} catch (error) {
				console.log("something went wrong while adding into cart");
				Swal.fire({icon:"error",title:"Oops!",text:"something went wrong while adding into cart"});
			}
		};

		document.addEventListener('DOMContentLoaded', function() {
            const productImages = [
                <% if (product.image && product.image.length > 0) { %>
                    <% product.image.forEach((image, index) => { %>
                '       <%= "/uploads/productsImages/" + image %>'<%= index < product.image.length - 1 ? ',' : '' %>
                    <% }); %>
                <% } else { %>
                    '/uploads/productsImages/default.png'
                <% } %>
            ];

            let currentImageIndex = 0;
            const mainImage = document.getElementById('mainImage');
            const thumbnails = document.querySelectorAll('.thumbnail');
            const currentImageIndexElement = document.getElementById('currentImageIndex');
            const ZOOM_SCALE = 2.5; // Adjust zoom level (2.5x)
    
            thumbnails.forEach((thumbnail, index) => {
                thumbnail.addEventListener('click', () => {
                    switchImage(index);
                });
            });

            function switchImage(index) {
                if (index >= 0 && index < productImages.length) {
            
                    mainImage.src = productImages[index];
                    thumbnails.forEach(thumb => thumb.classList.remove('active'));
                    if (thumbnails[index]) {
                        thumbnails[index].classList.add('active');
                        thumbnails[index].style.borderColor = '#007bff';
                    }
            
                    thumbnails.forEach((thumb, i) => {
                        if (i !== index) {
                            thumb.style.borderColor = 'transparent';
                        }
                    });
            
                    currentImageIndex = index;
                    if (currentImageIndexElement) {
                        currentImageIndexElement.textContent = index + 1;
                    }
                    // Reset zoom when switching images
                    resetZoom();
                }
            }
    
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft' && currentImageIndex > 0) {
                    switchImage(currentImageIndex - 1);
                } else if (e.key === 'ArrowRight' && currentImageIndex < productImages.length - 1) {
                    switchImage(currentImageIndex + 1);
                }
            });

            const stockQuantity = <%- product.quantity || 0 %>;
            const maxOrderQuantity = <%- product.quantity < 5 ? product.quantity : 5 %>;
            const quantityInput = document.getElementById('quantity');
            const MAX_ALLOWED = Math.min(stockQuantity,maxOrderQuantity);

            document.querySelector('.quantity-left-minus')?.addEventListener('click', function() {
                const currentValue = parseInt(quantityInput.value);
                if (currentValue > 1) {
                    quantityInput.value = currentValue - 1;
                }else {
                    Swal.fire({
                        icon: "warning",
                        title: "Minimum quantity reached!",
                        text: "You must add at least 1 unit.",
                        showConfirmButton: true
                    });
                }
            });

            document.querySelector('.quantity-right-plus')?.addEventListener('click', function() { 
                const currentValue = parseInt(quantityInput.value);
                if (currentValue < MAX_ALLOWED) {
                    quantityInput.value = currentValue + 1;
                }else{
                    let message = '';
            if (currentValue >= maxOrderQuantity && currentValue >= stockQuantity) {
                message = `Maximum limit reached! You can only order ${maxOrderQuantity} units per order and only ${stockQuantity} units are in stock.`;
            } else if (currentValue >= maxOrderQuantity) {
                message = `Maximum order limit reached! You can only order up to ${maxOrderQuantity} units per order.`;
            } else if (currentValue >= stockQuantity) {
                message = `Stock limit reached! Only ${stockQuantity} units are available in stock.`;
            }
            
            Swal.fire({
                icon: "warning",
                title: "Limit Reached!",
                text: message,
                showConfirmButton: true
            });
                }
            });

            // On mouseleave, reset to normal
            mainImage.addEventListener('mousemove', (e) => {
                if (window.innerWidth <= 768) return;
                const rect = mainImage.getBoundingClientRect();
                const x = ((e.clientX - rect.left) / rect.width) * 100;
                const y = ((e.clientY - rect.top) / rect.height) * 100;
                mainImage.style.transformOrigin = `${x}% ${y}%`;
                mainImage.style.transform = `scale(${ZOOM_SCALE})`;
            });

            mainImage.addEventListener('mouseleave', () => {
                if (window.innerWidth <= 768) return;
                mainImage.style.transform = '';
                mainImage.style.transformOrigin = 'center center';
            });

            // Mobile: Double-tap to toggle fixed zoom
            let tapCount = 0;
            let tapTimer;
            mainImage.addEventListener('click', (e) => {
                if (window.innerWidth > 768) return; // Desktop uses hover
                e.stopPropagation();
                tapCount++;
                if (tapCount === 1) {
                    tapTimer = setTimeout(() => {
                        tapCount = 0;
                    }, 300);
                } else {
                    clearTimeout(tapTimer);
                    tapCount = 0;
                    toggleMobileZoom();
                }
            });

            function toggleMobileZoom() {
                mainImage.classList.toggle('zoomed');
                if (mainImage.classList.contains('zoomed')) {
                    mainImage.style.transformOrigin = 'center center';
                    mainImage.style.transform = `scale(1.5)`; // Fixed scale for mobile
                } else {
                    resetZoom();
                }
            }

            function resetZoom() {
                mainImage.classList.remove('zoomed');
                mainImage.style.transform = '';
                mainImage.style.transformOrigin = 'center center';
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    resetZoom();
                }
            });

            document.querySelectorAll('.add-to-cart').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const productId = btn.dataset.id.trim();
                    const quantity = parseInt(quantityInput.value) || 1;
                    if (quantity > MAX_ALLOWED) {
                        Swal.fire({
                            icon: "warning",
                            title: "Quantity limit exceeded!",
                            text: `You can only add up to ${MAX_ALLOWED} units.`,
                            showConfirmButton: true
                        });
                        return;
                    }
                    if (!productId) {
                        console.error('Product ID missing');
                        return;
                    }
                    try {
                        const res = await fetch('/cart/add', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept':'application/json'
                            },
                            body: JSON.stringify({ productId,quantity })
                        });

                        const data = await res.json();
                        if (res.status === 401 && data.redirectUrl) {
                            window.location.href = data.redirectUrl || "/login";
                        }else if (res.ok) {
                            Swal.fire({
                                icon:"success",
                                text:"Successfully product added into cart.",
                                title:"Done.",
                                showConfirmButton:false,
                                timer:1000
                            }).then(() => window.location.href = "/cart")
                        } else {
                            Swal.fire({
                                icon:"error",
                                text:"Error!",
                                title:data.message||"Failed to add product into cart",
                            })
                        }
                    } catch (error) {
                        Swal.fire({
                            icon:"error",
                            text:"Oops.",
                            title:error.status||"Something went wrong",
                        })
                    }
                });
            });
        });

        // Edit User Review
        function editUserReview(reviewId, rating, title, comment) {
            console.log('Editing review:', reviewId);
    
            // Set modal title
            document.getElementById('reviewModalTitle').textContent = 'Edit Your Review';
    
            // Set form values
            document.getElementById('reviewId').value = reviewId;
            document.getElementById('isEditing').value = 'true';
            document.getElementById('rating').value = rating;
            document.getElementById('reviewTitle').value = title;
            document.getElementById('reviewComment').value = comment;
            document.getElementById('commentCount').textContent = comment.length;
    
            // Update star display
            const starInputs = document.querySelectorAll('.star-input');
            starInputs.forEach(star => {
                const starRating = parseInt(star.dataset.rating);
                if (starRating <= rating) {
                    star.classList.remove('ion-ios-star-outline');
                    star.classList.add('ion-ios-star', 'active');
                } else {
                    star.classList.remove('ion-ios-star', 'active');
                    star.classList.add('ion-ios-star-outline');
                }
            });
    
            // Change submit button text
            document.getElementById('submitReviewBtn').innerHTML = '<i class="ion-ios-checkmark"></i> Update Review';
    
            // Open modal
            if (typeof $ !== 'undefined' && $.fn.modal) {
                $('#reviewModal').modal('show');
            } else if (typeof bootstrap !== 'undefined') {
                const modal = new bootstrap.Modal(document.getElementById('reviewModal'));
                modal.show();
            }
        }

        // Delete User Review
        async function deleteUserReview(reviewId) {
            const result = await Swal.fire({
                title: 'Delete Your Review?',
                text: "This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            });
    
            if (!result.isConfirmed) return;
    
            try {
                const response = await fetch(`/review/delete/${reviewId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
        
                const data = await response.json();
        
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: 'Your review has been deleted',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'Failed to delete review'
                    });
                }
            } catch (error) {
                console.error('Error deleting review:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong. Please try again.'
                });
            }
        }
	</script>

<%-include("../partials/user/footer.ejs") %>