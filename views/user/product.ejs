<%-include("../partials/user/header.ejs") %>

    <style>
		.product-image-gallery {
    position: relative;
    width: 100%;
}

.main-image-container {
    position: relative;
    margin-bottom: 20px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    background: #f8f9fa;
}

.main-image {
    width: 100%;
    height: 450px;
    object-fit: cover;
    cursor: zoom-in;
    transition: all 0.4s ease;
    display: block;
}

.main-image:hover {
    transform: scale(1.03);
}

.image-counter {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    z-index: 10;
    backdrop-filter: blur(10px);
}

.thumbnail-container {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 15px 5px;
    margin-top: 10px;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: #dee2e6 #f8f9fa;
}

.thumbnail-container::-webkit-scrollbar {
    height: 8px;
}

.thumbnail-container::-webkit-scrollbar-track {
    background: #f8f9fa;
    border-radius: 10px;
}

.thumbnail-container::-webkit-scrollbar-thumb {
    background: #dee2e6;
    border-radius: 10px;
    transition: background 0.3s ease;
}

.thumbnail-container::-webkit-scrollbar-thumb:hover {
    background: #adb5bd;
}

.thumbnail {
    flex-shrink: 0;
    width: 85px;
    height: 85px;
    object-fit: cover;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 3px solid transparent;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    opacity: 0.8;
}

.thumbnail:hover {
    transform: translateY(-2px) scale(1.05);
    border-color: #0066cc;
    opacity: 1;
    box-shadow: 0 4px 15px rgba(0, 102, 204, 0.3);
}

.thumbnail.active {
    border-color: #007bff;
    transform: translateY(-2px) scale(1.05);
    opacity: 1;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4);
}

.image-zoom-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    cursor: pointer;
    animation: fadeIn 0.3s ease;
}

.image-zoom-modal img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 5;
}

.gallery-nav:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: translateY(-50%) scale(1.1);
}

.gallery-nav.prev {
    left: 15px;
}

.gallery-nav.next {
    right: 15px;
}

.image-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 450px;
    background: #f8f9fa;
    border-radius: 12px;
}

.loading-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #e9ecef;
    border-top: 4px solid #007bff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.product-details h3 {
    font-size: 2.2rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 15px;
    line-height: 1.2;
}

.product-price {
    font-size: 1.8rem;
    font-weight: 700;
    color: #e74c3c;
    margin-bottom: 20px;
}

.product-description {
    color: #6c757d;
    line-height: 1.6;
    margin-bottom: 25px;
    font-size: 1.1rem;
}

.stock-info {
    background: #d4edda;
    color: #155724;
    padding: 8px 15px;
    border-radius: 6px;
    display: inline-block;
    font-weight: 500;
    margin-bottom: 20px;
}

.stock-info.low-stock {
    background: #f8d7da;
    color: #721c24;
}

@media (max-width: 992px) {
    .product-details {
        padding-left: 0 !important;
        margin-top: 30px;
    }
}

@media (max-width: 768px) {
    .main-image {
        height: 300px;
    }
    
    .thumbnail {
        width: 70px;
        height: 70px;
    }
    
    .thumbnail-container {
        gap: 8px;
        padding: 10px 0;
    }
    
    .product-details h3 {
        font-size: 1.8rem;
    }
    
    .gallery-nav {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    .image-counter {
        font-size: 12px;
        padding: 6px 10px;
    }
}

@media (max-width: 576px) {
    .main-image {
        height: 250px;
    }
    
    .thumbnail {
        width: 60px;
        height: 60px;
    }
    
    .product-details h3 {
        font-size: 1.6rem;
    }
    
    .thumbnail-container {
        gap: 6px;
    }
}

* {
    -webkit-tap-highlight-color: transparent;
}

.thumbnail,
.main-image,
.gallery-nav {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
}

.thumbnail:focus,
.gallery-nav:focus {
    outline: 2px solid #007bff;
    outline-offset: 2px;
}

.main-image:focus {
    outline: 2px solid #007bff;
    outline-offset: 4px;
}
/* Wishlist icon on product image */
        .wishlist-icon {
	        position: absolute;
	        top: 10px;
        	right: 10px;
        	border-radius: 50%;
            margin-right: 50px;
            margin-top: 10px;
        	z-index: 10;
           	color: #fbcccc;
        	font-size: 18px;
          	transition: all 0.2s ease;
        	text-decoration: none;
        }

        .wishlist-icon:hover {
	        color: #ff4d4d;
	        transform: scale(1.1);
        }

		.heart-icon {
            font-size: 24px;
            color: #ccc;
            transition: all 0.3s ease;
        }

        /* Heart icon when in wishlist - filled/darker */
        .heart-icon.in-wishlist {
            color: #e74c3c;  /* Red color for filled heart */
        }

        /* Hover effect */
        .wishlist-icon:hover .heart-icon {
            transform: scale(1.2);
        }

        .wishlist-icon:hover .heart-icon:not(.in-wishlist) {
            color: #e74c3c;
            opacity: 0.7;
        }

        .img-prod {
        	position: relative;
        	display: block;
           	overflow: hidden;
        }
	</style>

	<div class="hero-wrap hero-bread" style="background-image: url('/images/bg_6.jpg');">
		<div class="container">
			<div class="row no-gutters slider-text align-items-center justify-content-center">
				<div class="col-md-9 ftco-animate text-center">
					<p class="breadcrumbs"><span class="mr-2"><a href="/">Home</a></span> <span>Shop</span></p>
					<h1 class="mb-0 bread">Product</h1>
				</div>
			</div>
		</div>
	</div>

