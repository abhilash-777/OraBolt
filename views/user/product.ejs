                                                    </p>
                                                    <% } else { %>
                                                        <p class="price"><span>&#8377;<%= product.salePrice %></span></p>
                                                        <% } %>
                                            </div>
                                            <div class="rating">
                                                <span class="text-muted small">
                                                    <%= product.status %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No similar product found.</p>
                    <% } %>
                </div>
            </div>

		</div>
	</section>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>

        async function addToWishlist(productId) {
			try {
				const response = await fetch(`/wishlist/add/${productId}`,{
					method:"POST",
				});
				const data = await response.json();
				if(data.success){
					Swal.fire({
						icon:"success",
						title:"Added.",
						text:data.message,
						showConfirmButton:false,
						timer:1500
					})
					window.location.href = `/product/${productId}`
				}else{
					Swal.fire({icon:"error",title:"Failed!",text:"Failed to add item into wishlist"});
				}
			} catch (error) {
				console.log("something went wrong while adding into cart");
				Swal.fire({icon:"error",title:"Oops!",text:"something went wrong while adding into cart"});
			}
		};

		document.addEventListener('DOMContentLoaded', function() {
            const productImages = [
                <% if (product.image && product.image.length > 0) { %>
                    <% product.image.forEach((image, index) => { %>
                '       <%= "/uploads/productsImages/" + image %>'<%= index < product.image.length - 1 ? ',' : '' %>
                    <% }); %>
                <% } else { %>
                    '/uploads/productsImages/default.png'
                <% } %>
            ];

            let currentImageIndex = 0;
            const mainImage = document.getElementById('mainImage');
            const thumbnails = document.querySelectorAll('.thumbnail');
            const currentImageIndexElement = document.getElementById('currentImageIndex');
    
            thumbnails.forEach((thumbnail, index) => {
                thumbnail.addEventListener('click', () => {
                    switchImage(index);
                });
            });

            function switchImage(index) {
                if (index >= 0 && index < productImages.length) {
            
                    mainImage.src = productImages[index];
                    thumbnails.forEach(thumb => thumb.classList.remove('active'));
                    if (thumbnails[index]) {
                        thumbnails[index].classList.add('active');
                        thumbnails[index].style.borderColor = '#007bff';
                    }
            
                    thumbnails.forEach((thumb, i) => {
                        if (i !== index) {
                            thumb.style.borderColor = 'transparent';
                        }
                    });
            
                    currentImageIndex = index;
                    if (currentImageIndexElement) {
                        currentImageIndexElement.textContent = index + 1;
                    }
                }
            }
    
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft' && currentImageIndex > 0) {
                    switchImage(currentImageIndex - 1);
                } else if (e.key === 'ArrowRight' && currentImageIndex < productImages.length - 1) {
                    switchImage(currentImageIndex + 1);
                }
            });
            
            const MAX_QTY = 5;
            const quantityInput = document.getElementById('quantity');
            document.querySelector('.quantity-left-minus')?.addEventListener('click', function() {
                const currentValue = parseInt(quantityInput.value);
                if (currentValue > 1) {
                    quantityInput.value = currentValue - 1;
                }else {
                    Swal.fire({
                        icon: "warning",
                        title: "Minimum quantity reached!",
                        text: "You must add at least 1 unit.",
                        showConfirmButton: true
                    });
                }
            });

            document.querySelector('.quantity-right-plus')?.addEventListener('click', function() { 
                const currentValue = parseInt(quantityInput.value);
                if (currentValue < MAX_QTY) {
                    quantityInput.value = currentValue + 1;
                }else{
                    Swal.fire({
                        icon:"warning",
                        title:"Max limit reached!",
                        text:"you can add upto 5 unit in this product",
                        showConfirmButton:true
                    })
                }
            });

    
            mainImage.addEventListener('click', function() {
        
                const modal = document.createElement('div');
                modal.style.cssText = `
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0,0,0,0.9);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    z-index: 9999;
                    cursor: pointer;
                `;
        
                const zoomedImg = document.createElement('img');
                zoomedImg.src = this.src;
                zoomedImg.style.cssText = `
                    max-width: 90%;
                    max-height: 90%;
                    object-fit: contain;
                `;
        
                modal.appendChild(zoomedImg);
                document.body.appendChild(modal);
        
        
                modal.addEventListener('click', () => {
                    document.body.removeChild(modal);
                });
        
        
                const handleEscape = (e) => {
                    if (e.key === 'Escape') {
                        document.body.removeChild(modal);
                        document.removeEventListener('keydown', handleEscape);
                    }
                };
                document.addEventListener('keydown', handleEscape);
            });

            document.querySelectorAll('.add-to-cart').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const productId = btn.dataset.id.trim();
                    const quantity = parseInt(quantityInput.value) || 1;
                    if (quantity > MAX_QTY) {
                        Swal.fire({
                            icon: "warning",
                            title: "Quantity limit exceeded!",
                            text: `You can only add up to ${MAX_QTY} units.`,
                            showConfirmButton: true
                        });
                        return;
                    }
                    if (!productId) {
                        console.error('Product ID missing');
                        return;
                    }
                    try {
                        const res = await fetch('/cart/add', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept':'application/json'
                            },
                            body: JSON.stringify({ productId,quantity })
                        });

                        const data = await res.json();
                        if (res.status === 401 && data.redirectUrl) {
                            window.location.href = data.redirectUrl || "/login";
                        }else if (res.ok) {
                            Swal.fire({
                                icon:"success",
                                text:"Successfully product added into cart.",
                                title:"Done.",
                                showConfirmButton:false,
                                timer:1000
                            })
                        } else {
                            Swal.fire({
                                icon:"error",
                                text:"Error!",
                                title:data.message||"Failed to add product into cart",
                            })
                        }
                    } catch (error) {
                        Swal.fire({
                            icon:"error",
                            text:"Oops.",
                            title:error.status||"Something went wrong",
                        })
                    }
                });
            });

        });

	</script>


<%-include("../partials/user/footer.ejs")%>