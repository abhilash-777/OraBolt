<%-include("../partials/user/header.ejs") %>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <div class="main-container">
        <div class="profile-layout">
            <!-- Sidebar -->
            <aside class="sidebar">
                <a href="/profile" class="sidebar-item <%= activeTab === 'profile' ? 'active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Profile</span>
                </a>
                
                <a href="/addresses" class="sidebar-item <%= activeTab === 'addresses' ? 'active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>Manage Address</span>
                </a>
                
                <a href="/orders" class="sidebar-item <%= activeTab === 'orders' ? 'active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <path d="M9 11l3 3 5-5"></path>
                    </svg>
                    <span>Orders</span>
                </a>
                
                <a href="/wallet" class="sidebar-item <%= activeTab === 'wallet' ? 'active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 12h.01"></path>
                    </svg>
                    <span>Wallet</span>
                </a>
                
                <a href="/manage-password" class="sidebar-item <%= activeTab === 'password' ? 'active' : '' %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>Manage Password</span>
                </a>
                
                <a href="/logout" class="sidebar-item logout">
                    <span>Logout</span>
                </a>
            </aside>

            <!-- Main Content -->
            <main class="content">
                <% if (activeTab === 'profile') { %>
                    <span class="badge badge-blue">User Referral Code : <%= user.referralCode %></span>
                    <div class="content-header">
                        <h2>My Profile</h2>
                    </div>
                    <!-- Profile Photo -->
                    <div class="profile-photo-section">
                        <div class="profile-photo">
                            <% if (user.profileImage) { %>
                                <img src="<%= user.profileImage %>" alt="Profile">
                            <% } else { %>
                                <span class="profile-initial"><%= user.name.charAt(0) %></span>
                            <% } %>
                        </div>
                        <button class="photo-upload-btn" onclick="document.getElementById('photoInput').click()">
                            <svg class="icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        </button>
                        <% if (user.profileImage) { %>
                            <button class="photo-remove-btn" onclick="removeProfileImage('<%= user._id %>')">
                                <svg class="icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M6 18L18 6M6 6l12 12"></path>
                                </svg>Remove Photo
                            </button>
                        <% } %>
                        <input type="file" id="photoInput" accept="image/*" style="display: none;">
                    </div>

                    <!-- Profile Form -->
                    <form id="profileForm">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Full Name</label>
                                <div class="input-wrapper">
                                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <input type="text" name="name" value="<%= user.name %>" readonly id="nameInput">
                                    <small id="nameError" class="errorMsg" style="color: red;"></small>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Phone Number</label>
                                <div class="input-wrapper">
                                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                    <input type="tel" name="phone" value="<%= user.phone %>" readonly id="phoneInput">
                                    <small id="phoneError" class="errorMsg" style="color: red;"></small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <input type="email" name="email" value="<%= user.email %>" readonly id="emailInput">
                                <small id="emailError" class="errorMsg" style="color: red;"></small>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-primary" id="editBtn">
                                <a href="/editProfile">Edit Profile</a>
                            </button>
                        </div>
                    </form>
                <% } %>

                <% if (activeTab === 'addresses') { %>
                    <div class="content-header">
                        <h2>My Addresses</h2>
                        <button class="btn btn-primary"><a href="/addAddress">+ Add New Address</a></button>
                    </div>

                    <% if (addresses && addresses.length> 0) { %>
                        <% addresses.sort((a, b)=> b.isDefault - a.isDefault).forEach((addr) => { %>
                            <div class="address-card <%= addr.isDefault ? 'default-address' : '' %>">
                                <div class="address-header">
                                    <span class="badge badge-blue"><%= addr.addressType.toUpperCase() %></span>
                                    <% if (addr.isDefault) { %>
                                        <span class="badge badge-green">Default</span>
                                    <% } %>
                                </div>
                    
                                <h3><%= addr.name %></h3>
                                <p><%= addr.address %>, <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %></p>
                                <p><i class="fa-solid fa-phone text-green"></i> <%= addr.phone %></p>
                    
                                <div class="address-actions">
                                    <% if (!addr.isDefault) { %>
                                        <button type="submit" class="btn-link text-green btn-set-default" data-address-id="<%= addr._id %>" data-user-id="<%= user._id %>">
                                            <i class="fa-solid fa-star"></i> Set as Default
                                        </button>
                                    <% } %>
                    
                                    <a href="/editAddress/<%= addr._id %>" class="btn-link"><i class="fa-solid fa-pen"></i> Edit</a>
                    
                                    <% if (!addr.isDefault) { %>
                                        <form class="deleteForm" data-user="<%= user._id %>" data-address="<%= addr._id %>" style="display:inline;">
                                            <button type="submit" class="btn-link text-red"><i class="fa-solid fa-trash"></i> Delete</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            <p>No addresses added yet.</p>
                            <button class="btn btn-primary"><a href="/addAddress">+ Add Address</a></button>
                        </div>
                    <% } %>

                <% } %>

                <% if (activeTab === 'orders') { %>
                    <div class="content-header">
                        <h2>My Orders</h2>
                    </div>
                    
                    <% if (orders && orders.length> 0) { %>
                        <div class="orders-table-container">
                            <table class="orders-table">
                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Order Status</th>
                                        <th>Payment Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% orders.forEach(order=> { %>
                                        <tr>
                                            <td data-label="Order ID" class="order-id">#<%= order.orderId %></td>
                                            <td data-label="Date" class="order-date">
                                                <%= new Date(order.createdOn).toLocaleDateString('en-IN', { day: '2-digit' , month: 'short'
                                                    , year: 'numeric' }) %>
                                            </td>
                                            <td data-label="Items" class="order-items-cell">
                                                <small><%= order.orderedItems.length %> item(s)</small>
                                            </td>
                                            <td data-label="Total" class="order-total">₹<%= order.finalPrice.toLocaleString('en-IN') %></td>
                                            <td data-label="Order Status">
                                                <span class="badge badge-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>">
                                                    <%= order.status %>
                                                </span>
                                            </td>
                                            <td data-label="Payment">
                                                <span
                                                    class="badge badge-payment badge-<%= (order.paymentStatus || 'pending').toLowerCase().replace(/\s+/g, '-') %>">
                                                    <%= order.paymentStatus || order.paymentMethod || 'COD' %>
                                                </span>
                                            </td>
                                            <td data-label="Action" class="order-actions">
                                                <% if(order.paymentStatus === "Failed" && order.status === "Payment Pending"){ %>
                                                    <button class="btn btn-warning btn-sm" onclick="retryPayment('<%= order.orderId %>')">
                                                        <i class="fas fa-redo"></i> Retry Payment
                                                    </button>
                                                <% } else { %>
                                                    <a href="/orders/details/<%= order._id %>" class="btn-view-details">
                                                        <i class="fas fa-eye"></i> <span>View</span>
                                                    </a>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-shopping-bag"></i>
                            <p>No orders yet</p>
                            <a href="/shop" class="btn btn-primary">Start Shopping</a>
                        </div>
                    <% } %>
                <% } %>


                <% if (activeTab === 'wallet') { %>
                    <div class="content-header">
                        <h2>My Wallet</h2>
                    </div>
                    <div class="wallet-card">
                        <p class="wallet-label">Available Balance</p>
                        <p class="wallet-amount">&#8377;<%= wallet && wallet.balance ? wallet.balance.toFixed(2) : '0:00' %></p>
                        <% if (user && user.referralCode) { %>
                            <div class="referral-code" style="margin-top: 15px; padding: 10px; background: #f8f9fa; border-radius: 5px;">
                                <p style="margin: 0; color: #666; font-size: 14px;">Your Referral Code</p>
                                <p style="margin: 5px 0; font-size: 20px; font-weight: bold; color: rebeccapurple">
                                    <%= user.referralCode %>
                                </p>
                            </div>
                        <% } %>
                    </div>
                    <div class="transactions-section" style="margin-top: 30px;">
                        <h3 style="margin-bottom: 20px; font-size: 18px; color: #333;">Transaction History</h3>
                        
                        <% if (wallet && wallet.transactions && wallet.transactions.length> 0) { %>
                            <div class="transactions-list">
                                <% wallet.transactions.forEach((transaction, index)=> { %>
                                    <div class="transaction-item"
                                        style="display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 1px solid #e0e0e0; border-radius: 8px; margin-bottom: 10px; background: <%= transaction.type === 'credit' ? '#f0fff4' : '#fff5f5' %>;">
                                        <div class="transaction-details" style="flex: 1;">
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <span class="transaction-icon"
                                                    style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: <%= transaction.type === 'credit' ? '#10b981' : '#ef4444' %>; color: white; font-weight: bold;">
                                                    <%= transaction.type==='credit' ? '+' : '-' %>
                                                </span>
                                                <div>
                                                    <p style="margin: 0; font-weight: 600; color: #333; font-size: 15px;">
                                                        <%= transaction.description %>
                                                    </p>
                                                    <p style="margin: 5px 0 0 0; color: #666; font-size: 13px;">
                                                        <%= new Date(transaction.date).toLocaleDateString('en-IN', { year: 'numeric' ,
                                                            month: 'short' , day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="transaction-amount" style="text-align: right;">
                                            <p
                                                style="margin: 0; font-size: 18px; font-weight: bold; color: <%= transaction.type === 'credit' ? '#10b981' : '#ef4444' %>;">
                                                <%= transaction.type==='credit' ? '+' : '-' %>₹<%= transaction.amount.toFixed(2) %>
                                            </p>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="empty-state"
                                style="text-align: center; padding: 60px 20px; background: #f8f9fa; border-radius: 8px;">
                                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="2"
                                    style="margin-bottom: 20px;">
                                    <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"></path>
                                    <path d="M4 6v12c0 1.1.9 2 2 2h14v-4"></path>
                                    <path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"></path>
                                </svg>
                                <p style="color: #999; font-size: 16px; margin: 0;">No transactions yet</p>
                                <p style="color: #ccc; font-size: 14px; margin-top: 10px;">Your wallet transactions will appear here</p>
                            </div>
                        <% } %>
                    </div>
                <% } %>

                <% if (activeTab === 'password') { %>
                    <div class="content-header">
                        <h2>Change Password</h2>
                    </div>
                    <form id="passwordForm">
                        <div class="form-group">
                            <input type="hidden" id="userId" value="<%= user._id %>">
                            <label>Current Password</label>
                            <div class="password-wrapper">
                                <input type="password" name="currPassword" id="currPassword" autocomplete="current-password">
                                <i class="fa-solid fa-eye toggle-password" data-target="currPassword"></i>
                            </div>
                            <small id="currPassError" class="errorMsg"></small>
                        </div>
                        
                        <div class="form-group">
                            <label>New Password</label>
                            <div class="password-wrapper">
                                <input type="password" name="newPassword" id="newPassword" autocomplete="new-password">
                                <i class="fa-solid fa-eye toggle-password" data-target="newPassword"></i>
                            </div>
                            <small id="newPassError" class="errorMsg"></small>
                        </div>
                        
                        <div class="form-group">
                            <label>Confirm New Password</label>
                            <div class="password-wrapper">
                                <input type="password" name="confirmPassword" id="confirmPassword" autocomplete="new-password">
                                <i class="fa-solid fa-eye toggle-password" data-target="confirmPassword"></i>
                            </div>
                            <small id="confirmPassError" class="errorMsg"></small>
                        </div>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </form>
                <% } %>
            </main>
        </div>
    </div>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
    
            const deleteForms = document.querySelectorAll(".deleteForm");
            const passwordForm = document.getElementById("passwordForm");
            const photoInput = document.getElementById("photoInput");
            const setDefaultButton = document.querySelectorAll(".btn-set-default");

            setDefaultButton.forEach(btn => {
                btn.addEventListener("click",async (e) => {
                    e.preventDefault();
                    const userId = btn.dataset.userId;
                    const addressId = btn.dataset.addressId;
                    try {
                        const response = await fetch(`/setDefault/${userId}/${addressId}`,{
                            method:"POST",
                            headers:{
                                'Content-Type':'application/json'
                            }
                        });

                        const data = await response.json();
                        if(data.success){
                            Swal.fire({
                                icon:"success",
                                title:"Done.",
                                text:data.message||"Address is setted default.",
                                showConfirmButton:false,
                                timer:1500
                            })
                            .then(() => window.location.reload())
                        }else{
                            Swal.fire({
                                icon:"error",
                                title:"Failed!",
                                text:data.message||"Failed to set address as default"
                            })
                        }
                    } catch (error) {
                        Swal.fire({
                            icon:"error",
                            title:"Oops!",
                            text:error.message||"Something went wrong"
                        })
                    }
                })
            });

            deleteForms.forEach(form => {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const userId = form.dataset.user;
                    const addressId = form.dataset.address;

                    const confirmResult = await Swal.fire({
                        icon: "warning",
                        title: "Are you sure?",
                        text: "You won't be able recover this address!",
                        showCancelButton: true,
                        confirmButtonColor: "#3085d6",
                        cancelButtonColor: "#d33",
                        confirmButtonText: "Yes, delete it!"
                    });

                    if (!confirmResult.isConfirmed) return;
            
                    try {
                        const response = await fetch(`/deleteAddress/${addressId}`, {
                            method: "DELETE"
                        });
                        const data = await response.json();
                
                        if (data.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Deleted.",
                                text: data.message || "Address deleted successfully.",
                                showConfirmButton:false,
                                timer: 1000
                            }).then(() => window.location.href = data.redirectUrl || `/addresses`);
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Error!",
                                text: data.message || "Error occure while deleting address",
                            });
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: "error",
                            title: "Oops!",
                            text: "Something went wrong while delete address.",
                        });
                    }
                });
            });

            if (photoInput) {
                photoInput.addEventListener("change", async (e) => {
                    const file = e.target.files[0];
                    if (!file) return;

                    const formData = new FormData();
                    formData.append("profileImage", file);

                    try {
                        const response = await fetch(`/uploadProfileImage`, {
                            method: "POST",
                            body: formData
                        });
                        const data = await response.json();

                        if (data.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Success",
                                text: data.message,
                                timer: 1000,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = data.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: data.message || "Failed to upload profile image",
                            });
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: "error",
                            title: "Oops!",
                            text: "Something went wrong while uploading the image",
                        });
                    }
                });
            }

            const toggleIcons = document.querySelectorAll(".toggle-password");
            toggleIcons.forEach(icon => {
                icon.addEventListener("click", () => {
                    const targetId = icon.getAttribute("data-target");
                    const input = document.getElementById(targetId);

                    if (input.type === "password") {
                        input.type = "text";
                        icon.classList.remove("fa-eye");
                        icon.classList.add("fa-eye-slash");
                    } else {
                        input.type = "password";
                        icon.classList.remove("fa-eye-slash");
                        icon.classList.add("fa-eye");
                    }
                });
            });

            if (passwordForm) {
        
                passwordForm.addEventListener("submit", async (e) => {

                    e.preventDefault();
                    if (!validation())return

                    const userId = document.getElementById("userId").value.trim();
                    const currentPassword = document.getElementById("currPassword").value.trim();
                    const newPassword = document.getElementById("newPassword").value.trim();
                    const confirmPassword = document.getElementById("confirmPassword").value.trim();

                    const confirmChangePassword = await Swal.fire({
                        icon: "warning",
                        title: "Are you sure?",
                        text: "Do you want to change your password?",
                        showCancelButton: true,
                        confirmButtonColor: "#3085d6",
                        cancelButtonColor: "#d33",
                        confirmButtonText: "Yes, Change it."
                    });
                    if (!confirmChangePassword.isConfirmed)return

                    try {

                        const response = await fetch(`/manage-password`, {
                            method: "PUT",
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ 
                                currPassword: currentPassword, 
                                newPassword, 
                                confirmPassword 
                            })
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                        }

                        const data = await response.json();
                        if (data.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Changed",
                                text: data.message,
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                window.location.href = data.redirectUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: data.message || "Error changing password",
                            });
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: "error",
                            title: "Oops!",
                            text: error.message||"Something went wrong while changing password",
                        });
                    }
                });
            }
        });

        function validation() {

            const currPassword = document.getElementById("currPassword").value.trim();
            const newPassword = document.getElementById("newPassword").value.trim();
            const confirmPassword = document.getElementById("confirmPassword").value.trim();

            document.querySelectorAll(".errorMsg").forEach(el => el.textContent = "");
            let isValid = true;

            const errors = {
                currPassError: "",
                newPassError: "",
                confirmPassError: ""
            };

            if (!currPassword) {
                errors.currPassError = "Password is required";
            } else if (currPassword.length < 8) {
                errors.currPassError = "Password must be at least 8 characters";
            } else if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/.test(currPassword)) {
                errors.currPassError = "Your password is week. Add special charactors in between the password";
            }

            if (!newPassword) {
                errors.newPassError = "New password is required";
            } else if (newPassword.length < 8) {
                errors.newPassError = "New password must be at least 8 characters";
            } else if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/.test(newPassword)) {
                errors.newPassError = "Your password is week. Add special charactors(@#$) in between the password";
            } else if (newPassword === currPassword) {
                errors.newPassError = "New password must be different from current password";
            }

            if (!confirmPassword) {
                errors.confirmPassError = "Confirm password is required";
            } else if (confirmPassword !== newPassword) {
                errors.confirmPassError = "Passwords don't match";
            }
    
            Object.keys(errors).forEach(id => {
                const errorElement = document.getElementById(id);
                if (errorElement) {
                    errorElement.textContent = errors[id];
                }
                if (errors[id]) isValid = false;
            });
            return isValid;
        }

        async function removeProfileImage(userId) {
                const confirmResult = await Swal.fire({
                    icon: "warning",
                    title: "Are you sure?",
                    text: "This will remove your profile image!",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, remove it!"
                });
                if (!confirmResult.isConfirmed) return;

                try {
                    const response = await fetch(`/removeProfileImage`, {
                        method: "DELETE"
                    });
                    const data = await response.json();

                   if (data.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Removed",
                            text: data.message,
                            timer: 1000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = data.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: data.message || "Failed to remove profile image",
                        });
                    }
                } catch (error) {
                    Swal.fire({
                        icon: "error",
                        title: "Oops!",
                        text: "Something went wrong while removing the image",
                    });
                }
            };

        async function retryPayment(orderId) {
        try {
            Swal.fire({
                title: 'Initializing Payment...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Step 1: Create new Razorpay order for retry
            const response = await fetch('/order/retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId })
            });

            const data = await response.json();

            if (!data.success) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Failed',
                    text: data.message || 'Failed to initiate payment'
                });
            }

            Swal.close();

            // Step 2: Configure Razorpay options
            const options = {
                key: data.key,
                amount: data.amount,
                currency: data.currency,
                name: 'OraBolt',
                description: `Payment for Order #${orderId}`,
                order_id: data.orderId,
                handler: async function (razorpayResponse) {
                    await verifyRetryPayment(razorpayResponse, orderId);
                },
                modal: {
                    ondismiss: function() {
                        Swal.fire({
                            icon: 'info',
                            title: 'Payment Cancelled',
                            text: 'You can retry payment anytime from the orders page',
                            confirmButtonColor: '#ffc107'
                        });
                    }
                },
                theme: {
                    color: '#ffc107'
                }
            };

            const rzp = new Razorpay(options);

            rzp.on('payment.failed', function (response) {
                console.error('Payment failed:', response.error);
                Swal.fire({
                    icon: 'error',
                    title: 'Payment Failed',
                    html: `<p><b>${response.error.description}</b></p><p style="color: #666; font-size: 14px;">You can retry payment anytime.</p>`,
                    confirmButtonColor: '#d33'
                });
            });

            rzp.open();

        } catch (error) {
            console.error('Error retrying payment:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'Failed to retry payment'
            });
        }
        }

        async function verifyRetryPayment(razorpayResponse, orderId) {
            try {
                Swal.fire({
                    title: 'Verifying Payment...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const verifyResponse = await fetch('/checkout/verify-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        razorpay_order_id: razorpayResponse.razorpay_order_id,
                        razorpay_payment_id: razorpayResponse.razorpay_payment_id,
                        razorpay_signature: razorpayResponse.razorpay_signature
                    })
                });

                const verifyData = await verifyResponse.json();

                if (!verifyData.success) {
                    return Swal.fire({
                        icon: 'error',
                        title: 'Verification Failed',
                        text: 'Payment verification failed. Please contact support.'
                    });
                }

                const updateResponse = await fetch('/order/update-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderId: orderId,
                        razorpayPaymentId: razorpayResponse.razorpay_payment_id,
                        razorpayOrderId: razorpayResponse.razorpay_order_id
                    })
                });

                const updateData = await updateResponse.json();

                if (updateData.success) {
                    Swal.fire({
                        title: 'Payment Successful!',
                        html: `
                            <div style="text-align: center; padding: 10px;">
                                <p style="font-size: 16px; margin: 10px 0;"><b>Order ID:</b> ${orderId}</p>
                                <p style="color: #28a745; margin-top: 15px;">
                                    <i class="fas fa-check-circle"></i> Payment completed successfully!
                                </p>
                            </div>
                        `,
                        icon: 'success',
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed',
                        text: updateData.message || 'Failed to update order'
                    });
                }

            } catch (error) {
                console.error('Error verifying retry payment:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message || 'Payment verification failed'
                });
            }
        }
    </script>

