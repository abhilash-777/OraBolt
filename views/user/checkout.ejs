<%-include("../partials/user/header.ejs")%>

<%-include("../partials/bread_crumb.ejs",{pageTitle:'Checkout',pageName:'Checkout'}) %>

<style>
	.errorMsg{
		color: red;
	}
	.card{
		margin: 10px 0px;
	}
	.coupon-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    cursor: pointer;
}
.coupon-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}
.coupon-card .card-body {
    padding: 12px;
}
.coupon-card .btn {
    font-size: 0.8rem;
    padding: 4px 8px;
}
</style>

	<section class="container py-4">
		<div class="row align-items-start">
            <!-- LEFT SIDE: Address List -->
			<div class="col-lg-7 col-md-12 mb-4">
				<h5 class="mb-3 fw-semibold">Select Delivery Address</h5>
			
				<% if (addresses && addresses.length> 0) { %>
					<% addresses.forEach((address, index)=> { %>
						<div class="card mb-3 border <%= address.isDefault ? 'border-success' : '' %>">
							<div class="card-body d-flex justify-content-between align-items-start"">
								<div>
									<div class="d-flex align-items-center gap-2 mb-1">
										<strong><%= address.addressType %> — <%= address.name %></strong>
										<% if (address.isDefault) { %>
											<span class="badge bg-success">Default</span>
										<% } %>
									</div>
									<div class="text-muted small">
										<%= address.address %><br>
										<%= address.street %>, <%= address.city %><br>
										<%= address.state %> — <%= address.pincode %><br>
										Phone: <%= address.phone %>
									</div>
								</div>
								<div class="text-end">
									<button class="btn btn-sm btn-outline-primary editAddressBtn" data-bs-toggle="modal"
										data-bs-target="#addAddressModal" data-id="<%= address._id %>"
										data-addresstype="<%= address.addressType %>" data-name="<%= address.name %>"
										data-address="<%= address.address %>" data-street="<%= address.street %>"
										data-city="<%= address.city %>" data-state="<%= address.state %>"
										data-pincode="<%= address.pincode %>" data-landmark="<%= address.landMark %>"
										data-phone="<%= address.phone %>" data-altphone="<%= address.altPhone %>">Edit</button>
									<div class="form-check mt-2">
										<input class="form-check-input" type="radio" name="selectedAddress"
											value="<%= address._id %>" <%=address.isDefault ? 'checked' : '' %>>
										<label class="form-check-label small">Deliver here</label>
									</div>
								</div>
							</div>
						</div>
					<% }); %>
				<% } else { %>
					<p class="text-muted">No address found. Please add one.</p>
				<% } %>
			
				<button id="addNewAddressBtn" class="btn btn-success mt-2" data-bs-toggle="modal"
					data-bs-target="#addAddressModal">
					+ Add New Address
				</button>
			</div>

			<!-- Right Side: Apply Coupon -->
    <div class="col-lg-5 col-md-12 mb-4">
      <div class="card mb-12">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="fas fa-tag me-2"></i>Apply Coupon
          </h5>
        </div>
        <div class="card-body">
          <div class="input-group mb-3">
            <input type="text" class="form-control" id="couponCode" placeholder="Enter coupon code">
            <button class="btn btn-outline-primary" type="button" id="applyCouponBtn">Apply Coupon</button>
          </div>

          <div id="couponMessage"></div>

          <!-- Available Coupons Section -->
          <div id="availableCoupons" class="mt-3" style="display: none;">
            <h6 class="text-success">Available Coupons for You:</h6>
            <div id="couponsList" class="row"></div>
          </div>
        </div>
      </div>
    </div>
			
			<!-- RIGHT SIDE: Order Summary & Payment -->
			<div class="col-md-6">
				<div class="card mb-4">
					<div class="card-header fw-semibold">Order Summary</div>
					<div class="card-body">
						<% if (cartItems && cartItems.length> 0) { %>
							<% let hasBlockedItems=false; %>
							<% cartItems.forEach(item=> { %>
								<% const isBlocked=item.productId?.isBlocked || item.productId?.status==='unlisted' ; if (isBlocked)
									hasBlockedItems=true; %>
								<div class="d-flex align-items-center mb-3 border-bottom pb-2">
									<% if (item.productId && item.productId.image && item.productId.image.length> 0) { %>
										<img src="/uploads/productsImages/<%= item.productId?.image[0] %>"
											alt="<%= item.productId?.productName || item.productId?.name %>"
											style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px; <%= isBlocked ? 'opacity: 0.6;' : '' %>">
									<% } else { %>
										<div class="bg-light d-flex align-items-center justify-content-center"
											style="width: 70px; height: 70px; border-radius: 8px;">
											<small>No Image</small>
										</div>
									<% } %>
									<div class="ms-3 flex-grow-1">
										<div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
										    <strong><%= item.productId?.productName || 'Unknown Product' %></strong>
											<% if (item.productId?.isBlocked) { %>
												<span class="badge bg-danger" style="color: white;">Product Blocked</span>
											<% } else if (item.productId?.status==='unlisted' ) { %>
												<span class="badge bg-warning text-dark">Product Unlisted</span>
											<% } %>
										</div>
										<small class="text-muted">Status: <%= item.productId?.status || 'In stock' %></small><br>
										<small>Qty: <%= item.quantity %></small>
										<% if (isBlocked) { %>
		    								<br><small class="text-danger"> Remove this item to proceed</small>
										<% } %>
									</div>
									<div class="text-end">
										<div class="mb-2">₹ <%= item.totalPrice || (item.productId?.regularPrice * item.quantity) %></div>
										<% if (isBlocked) { %>
											<button class="btn btn-sm btn-outline-danger"
												onclick="removeFromCart('<%= item.productId._id %>')">
												Remove
											</button>
										<% } %>
									</div>
									<% if(isDirectBuy && cartItems.length > 0){ %>
									    <input type="hidden" id="directProductId" value="<%= cartItems[0].productId._id %>">
                                        <input type="hidden" id="directQty" value="<%= cartItems[0].quantity %>">
									<% } %>
								</div>
							<% }); %>
					
							<% if (hasBlockedItems) { %>
								<div class="alert alert-warning mt-3 mb-0" role="alert">
									<strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Action Required!</strong><br>
									<small>Some items are blocked or unlisted by admin. Please remove them from your cart to
										continue placing your order.</small>
								</div>
							<% } %>
						<% } else { %>
							<p class="text-muted">Your cart is empty.</p>
						<% } %>
					
						<div class="d-flex justify-content-between fw-semibold mt-3">
							<span>Subtotal</span>
							<span id="subtotalAmount">₹ <%= subTotal %></span>
						</div>
						<div class="d-flex justify-content-between mb-2 text-success" id="discountRow" style="display: none;">
                            <span>Discount:</span>
                            <span id="discountAmount">-₹0</span>
                        </div>
						<div class="d-flex justify-content-between mb-2">
							<span>Shipping:</span>
							<span>Free</span>
						</div>
						<hr>
						<div class="d-flex justify-content-between mb-3">
							<strong>Total:</strong>
							<strong id="finalAmount">₹<%= finalPrice %></strong>
						</div>
						<!-- Hidden field to store applied coupon -->
                        <input type="hidden" id="appliedCouponCode" name="appliedCouponCode">
                        <input type="hidden" id="appliedCouponId" name="appliedCouponId">
					</div>
				</div>
					
					<div class="card">
						<div class="card-header fw-semibold">Payment Options</div>
						<div class="card-body">
							<% if (cartItems && cartItems.length> 0) { %>
								<% let hasBlockedItems=false; %>
									<% cartItems.forEach(item=> {
										if (item.productId?.isBlocked || item.productId?.status === 'unlisted') {
										    hasBlockedItems = true;
										}
									}); %>
					
									<div class="form-check mb-2">
										<input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="Cash On Delivery"
											<%=hasBlockedItems ? 'disabled' : 'checked' %>>
										<label class="form-check-label <%= hasBlockedItems ? 'text-muted' : '' %>" for="cod">
											Cash on Delivery
										</label>
									</div>
									<div class="form-check mb-2">
										<input class="form-check-input" type="radio" name="paymentMethod" id="razorpay" value="Razorpay"
											<%=hasBlockedItems ? 'disabled' : '' %>>
										<label class="form-check-label <%= hasBlockedItems ? 'text-muted' : '' %>" for="razorpay">
											Pay with Razorpay
										</label>
									</div>
									<div class="form-check mb-2">
										<input class="form-check-input" type="radio" name="paymentMethod" id="wallet" value="Wallet"
											<%=hasBlockedItems ? 'disabled' : '' %>>
										<label class="form-check-label <%= hasBlockedItems ? 'text-muted' : '' %>" for="wallet">
											Pay with Wallet
										</label>
										<p><strong>Wallet Balance:</strong> 
                                            <span id="walletBalance">Loading...</span>
                                        </p>
									</div>
				
									<% if (!hasBlockedItems) { %>
										<button id="placeOrderBtn" class="btn btn-warning w-100 fw-semibold">
											Place Order
										</button>
						            <% } else { %>
							            <div class="d-grid">
								            <button class="btn btn-secondary w-100 fw-semibold" disabled>
								                <i class="bi bi-lock-fill me-2"></i>Remove Blocked Items to Place Order
								            </button>
							            </div>
							        <% } %>
						    <% } else { %>
							    <button class="btn btn-secondary w-100 fw-semibold" disabled>
							        Cart is Empty
						        </button>
					        <% } %>
					    </div>
				    </div>
				<!-- ADD NEW ADDRESS MODAL -->
				<div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
					<div class="modal-dialog modal-lg">
						<div class="modal-content">
							<form id="newAddressForm">
								<input type="hidden" id="addressId" name="addressId">
								<div class="modal-header">
									<h5 class="modal-title" id="addAddressModalLabel">Add New Address</h5>
									<button type="button" class="btn btn-sm btn-outline-success" id="addNewAddressBtn"
                                    data-bs-toggle="modal" data-bs-target="#addAddressModal"></button>
								</div>
								<div class="modal-body">
									<div class="row g-3">
										<div class="col-md-6">
											<label class="form-label">Address Type</label>
											<select name="addressType" class="form-select" style="color: rgb(133, 134, 133);">
												<option value="">Select one</option>
												<option value="Home">Home</option>
												<option value="Work">Work</option>
												<option value="Other">Other</option>
											</select>
											<small class="errorMsg" id="addressTypeError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">Name</label>
											<input type="text" name="name" class="form-control" placeholder="Please Enter Name">
											<small class="errorMsg" id="nameError"></small>
										</div>
										<div class="col-12">
											<label class="form-label">Address</label>
											<input type="text" name="address" class="form-control" placeholder="Please Enter Address">
											<small class="errorMsg" id="addressError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">Street</label>
											<input type="text" name="street" class="form-control" placeholder="Please Enter Street">
											<small class="errorMsg" id="streetError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">City</label>
											<input type="text" name="city" class="form-control" placeholder="Please Enter City">
											<small class="errorMsg" id="cityError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">State</label>
											<select id="state" name="state" style="width: 100%; padding: 0.75rem 1rem; border: 2px solid #e2e8f0; border-radius: 8px; color: rgb(133, 134, 133);">
                                                <option value="">Select State</option>
                                            </select>
											<small class="errorMsg" id="stateError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">Pincode</label>
											<input type="number" name="pincode" class="form-control" placeholder="Please Enter Pincode">
											<small class="errorMsg" id="pincodeError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">Landmark</label>
											<input type="text" name="landMark" class="form-control" placeholder="Please Enter landMark">
											<small class="errorMsg" id="landmarkError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">Phone</label>
											<input type="text" name="phone" class="form-control" placeholder="Please Enter Phone Number">
											<small class="errorMsg" id="phoneError"></small>
										</div>
										<div class="col-md-6">
											<label class="form-label">Alt Phone (Optional)</label>
											<input type="text" name="altPhone" class="form-control" placeholder="Please Enter Phone Number">
											<small class="errorMsg" id="altPhoneError"></small>
										</div>
									</div>
								</div>
								<div class="modal-footer">
									<button type="submit" class="btn btn-primary">Save Address</button>
								</div>
							</form>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- jQuery (required for Bootstrap) -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <!-- Popper.js (required for Bootstrap dropdowns) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
	<script>

		async function loadWalletBalance(params) {
			const response = await fetch("/wallet-balance");
			const data = await response.json();
			document.getElementById("walletBalance").textContent = `₹${data.balance ?? 0}`
		}
		loadWalletBalance();

		const states = [
            "Andaman and Nicobar Islands", "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chandigarh",
            "Chhattisgarh", "Dadra and Nagar Haveli and Daman and Diu", "Delhi", "Goa", "Gujarat", "Haryana",
            "Himachal Pradesh", "Jammu and Kashmir", "Jharkhand", "Karnataka", "Kerala", "Ladakh", "Lakshadweep",
            "Madhya Pradesh", "Maharashtra", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Puducherry",
            "Punjab", "Rajasthan", "Sikkim", "Tamil Nadu", "Telangana", "Tripura", "Uttar Pradesh", "Uttarakhand", "West Bengal"
        ];

        // Pincode ranges by state
        const pincodeRanges = {
            "Andaman and Nicobar Islands": ["744101-744304"],
            "Andhra Pradesh": ["500001-534999"],
            "Arunachal Pradesh": ["791001-792999"],
            "Assam": ["781001-788999"],
            "Bihar": ["800001-854999"],
            "Chandigarh": ["160001-160036"],
            "Chhattisgarh": ["490001-497999"],
            "Dadra and Nagar Haveli and Daman and Diu": ["396210-396220", "396230-396240"],
            "Delhi": ["110001-110099"],
            "Goa": ["403001-403999"],
            "Gujarat": ["360001-396999"],
            "Haryana": ["121001-136999"],
            "Himachal Pradesh": ["171001-177999"],
            "Jammu and Kashmir": ["180001-190999"],
            "Jharkhand": ["815001-834999"],
            "Karnataka": ["560001-577999"],
            "Kerala": ["670001-695999"],
            "Ladakh": ["194001-194999"],
            "Lakshadweep": ["682001-682559"],
            "Madhya Pradesh": ["450001-488999"],
            "Maharashtra": ["400001-444999"],
            "Manipur": ["795001-795159"],
            "Meghalaya": ["793001-794999"],
            "Mizoram": ["796001-796999"],
            "Nagaland": ["797001-798999"],
            "Odisha": ["751001-770017"],
            "Puducherry": ["605001-609999"],
            "Punjab": ["140001-160999"],
            "Rajasthan": ["300001-349999"],
            "Sikkim": ["737101-737139"],
            "Tamil Nadu": ["600001-643999"],
            "Telangana": ["500001-509999"],
            "Tripura": ["799001-799289"],
            "Uttar Pradesh": ["200001-285999"],
            "Uttarakhand": ["246001-263999"],
            "West Bengal": ["700001-743999"]
        };

        // Populate state dropdown
        const stateSelect = document.getElementById("state");
        const initialState = "<%= locals.address ? address.state : '' %>".trim();
        states.forEach(state => {
            const option = document.createElement("option");
            option.value = state;
            option.textContent = state;
            if (state === initialState) {
                option.selected = true;
            }
            stateSelect.appendChild(option);
        });

		function isValidPincodeForState(pincode, state) {
            if (!state || !pincode) return false;
            const ranges = pincodeRanges[state] || [];
            const pinNum = parseInt(pincode);
            for (let rangeStr of ranges) {
                const [startStr, endStr] = rangeStr.split('-');
                const start = parseInt(startStr);
                const end = parseInt(endStr);
                if (pinNum >= start && pinNum <= end) {
                    return true;
                }
            }
            return false;
        }
		
        document.addEventListener('DOMContentLoaded', function () {
			
			const modal = document.getElementById("addAddressModal");
			const modalTitle = document.getElementById("addAddressModalLabel");
			const form = document.getElementById('newAddressForm');
			const submitBtn = form.querySelector("button[type='submit']");
			const editButtons = document.querySelectorAll(".editAddressBtn");
			const addNewBtn = document.getElementById("addNewAddressBtn");

			editButtons.forEach(btn => {
                btn.addEventListener("click", () => {
					modalTitle.textContent = "Edit Address";
					submitBtn.textContent = "Update Address";

					document.getElementById("addressId").value = btn.dataset.id;
					form.querySelector("select[name='addressType']").value = btn.dataset.addresstype;
					form.querySelector("input[name='name']").value = btn.dataset.name;
					form.querySelector("input[name='address']").value = btn.dataset.address;
					form.querySelector("input[name='street']").value = btn.dataset.street;
					form.querySelector("input[name='city']").value = btn.dataset.city;
					form.querySelector("select[name='state']").value = btn.dataset.state;
					form.querySelector("input[name='pincode']").value = btn.dataset.pincode;
					form.querySelector("input[name='landMark']").value = btn.dataset.landmark;
					form.querySelector("input[name='phone']").value = btn.dataset.phone;
					form.querySelector("input[name='altPhone']").value = btn.dataset.altphone;
				});
			});

            addNewBtn.addEventListener("click", () => {
                modalTitle.textContent = "Add New Address";
				submitBtn.textContent = "Save Address";
				form.reset();
				document.getElementById("addressId").value = "";
			});

			function validation(payload){
				let isValid = true;
				document.querySelectorAll(".errorMsg").forEach(elem => elem.textContent = "");
				let errors = {
					addressTypeError:"",
					nameError:"",
					addressError:"",
					phoneError:"",
					altPhoneError:"",
					streetError:"",
					cityError:"",
					stateError:"",
					pincodeError:"",
					landmarkError:""
				};

				if(!payload.addressType)errors.addressTypeError = "Please select an address type";

                if(!payload.name){
                    errors.nameError = "Name should required"
                }else if(!/^[A-Za-z]+(?:[\s'-][A-Za-z]+)*$/.test(payload.name)){
					errors.nameError = "Name should contain alphabetis characters(Name should not contain digits and special characters)";
				}else if(payload.name.length < 5 || payload.name.length > 20)errors.nameError = "Name should contain 5 to 20 characters";
                if(!payload.address){
					errors.addressError = "Address should required";
				}else if(!/^[a-zA-Z0-9\s.,'#\-\/]{3,}$/.test(payload.address)){
					errors.addressError = "Invalid address format. Example(123 Main St, city, district and state names)not allowed special characters(exclude '#').";
				}
                if(!payload.phone||!/^(?!([6-9])\1{9})[6-9]\d{9}$/.test(payload.phone))errors.phoneError = "Phone number should be 10 digit valid number";
                if(!payload.city){
					errors.cityError = "City name should required";
				}else if(!/^[a-zA-Z]+(?:[\s-][a-zA-Z]+)*$/.test(payload.city)){
					errors.cityError = "Invalid city name.Not allowed digits, accent and special characters";
				}
                if(!payload.state)errors.stateError = "State name should required";
                if(!payload.street){
					errors.streetError = "Street name should required";
				} else if(!/^[a-zA-Z0-9\s,.'-]{3,}$/.test(payload.street)){
					errors.streetError = "Invalid street name format. Example(123 Main Street).Not allowed special characters.";
				}
                if(!payload.pincode || !/^[1-9][0-9]{5}$/.test(payload.pincode)){
                    errors.pincodeError = "Pincode should required 6-digits number(not allow 000000)";
                }else if(payload.state && !isValidPincodeForState(payload.pincode, payload.state)){
                    errors.pincodeError = `Pincode ${payload.pincode} is not valid for ${payload.state}. Please enter a pincode from ${payload.state}.`;
                }
                if(!payload.landMark ||!/^[A-Za-z\s]+$/.test(payload.landMark))errors.landmarkError = "Landmark should required";

				Object.keys(errors).forEach(id => {
					document.getElementById(id).textContent = errors[id]
					if(errors[id])isValid = false
				});
				return isValid
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const id = document.getElementById("addressId").value;
				const payload = {
			        addressType: form.querySelector("select[name='addressType']").value.trim(),
					name: form.querySelector("input[name='name']").value.trim(),
					address: form.querySelector("input[name='address']").value.trim(),
					street: form.querySelector("input[name='street']").value.trim(),
					city: form.querySelector("input[name='city']").value.trim(),
					state: form.querySelector("select[name='state']").value.trim(),
					pincode: form.querySelector("input[name='pincode']").value.trim(),
					landMark: form.querySelector("input[name='landMark']").value.trim(),
					phone: form.querySelector("input[name='phone']").value.trim(),
					altPhone: form.querySelector("input[name='altPhone']").value.trim(),
				};

				if(!validation(payload))return

				const uri = id ? `/address/edit/${id}` : "/address/add";
				if(uri === `/address/edit/${id}`){
					let result = await Swal.fire({
						icon:"warning",
						title:"Are you sure?",
						text:"Do you really want to update this address?",
						showCancelButton:true,
						confirmButtonColor:"#3085d6",
                        cancelButtonColor:"#d33",
                        confirmButtonText:"Yes, update it!",
						cancelButtinText:"Cancel"
					});
					if(!result.isConfirmed)return
				}

				try {
					const res = await fetch(uri, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
						body: JSON.stringify(payload)
					});

					const data = await res.json();

					if (res.status === 401 && data.redirectUrl) {
						// not logged in
						window.location.href = data.redirectUrl;
						return;
					}

					if (data.success) {
						Swal.fire({ 
							icon: 'success',
							title: 'Saved', 
							text: 'Address saved successfully.', 
							timer: 1100, 
							showConfirmButton: false 
						}).then(() => {
							window.location.reload();
						});
					} else {
						Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Failed to save address.' });
					}
				} catch (err) {
					console.error('Address save error', err);
					Swal.fire({ icon: 'error', title: 'Network error', text: 'Could not reach server.' });
				}
			});

			modal.addEventListener("hidden.bs.modal", () => {
                form.reset();
				document.getElementById("addressId").value = "";
				modalTitle.textContent = "Add New Address";
				submitBtn.textContent = "Save Address";
			});

			const placeOrderBtn = document.getElementById('placeOrderBtn');
            if (!placeOrderBtn) {
                console.error("Place Order button not found!");
                return;
            }
			placeOrderBtn.addEventListener('click', async () => {
				
                const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked')?.value;
                if (!selectedAddress) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Address Selected',
                        text: 'Please select a delivery address before placing your order.',
                        confirmButtonColor: '#ffc107'
                    });
                    return;
                }

                // validate address
                const addressResponse = await fetch('/checkout/select-address', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedAddress })
                });
				
                const addressData = await addressResponse.json();
                if (!addressData.success) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: addressData.message || "Failed to select address"
                    });
                    return;
                }

                const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;
                if (!paymentMethod) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Select Payment Method',
                        text: 'Please select a payment method',
                        confirmButtonColor: '#ffc107'
                    });
                    return;
                }

				if(paymentMethod === "Razorpay"){
					await handleRazorpayPayment();
				}else if(paymentMethod === "Cash On Delivery"){
					await handleCODPayment();
				}else if(paymentMethod === "Wallet"){
					await handleWalletPayment();
				}

            });

			// Load available coupons on page load
			loadAvailableCoupons();
		});

		async function handleCODPayment() {
			const finalPrice = document.querySelector(".d-flex.justify-content-between.mb-3")?.textContent;
			const confirm = await Swal.fire({
                title: 'Confirm Cash on Delivery Order',
                html: `
                    <div style="text-align:left">
                        <p><b>Payment Method:</b> Cash On Delivery</p>
                        <p>${finalPrice}</p>
                        <p>'You will pay when you receive your order.'</p>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Confirm Order!',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d'
            });

            if (!confirm.isConfirmed) return;

			await placeOrder("Cash On Delivery");
		};

		async function handleWalletPayment() {
			const finalPrice = document.querySelector(".d-flex.justify-content-between.mb-3")?.textContent;
			const confirm = await Swal.fire({
			    title: 'Confirm Wallet Payment',
			    html: `
				    <div style="text-align:left; padding: 10px;">
					    <p><b>Payment Method:</b> Wallet</p>
					    <p> ₹${finalPrice}</p>
					    <p>Amount will be deducted from your wallet.</p>
				    </div>
			    `,
			    icon: 'question',
			    showCancelButton: true,
			    confirmButtonText: 'Yes, Pay Now!',
			    cancelButtonText: 'Cancel',
			    confirmButtonColor: '#198754',
			    cancelButtonColor: '#6c757d',
				didOpen:async () => {
					const res = await fetch("/wallet-balance");
					const data = await res.json();
					document.getElementById("walletBalance").textContent = `${data.balance}`
				}
		    });

		    if (!confirm.isConfirmed) return;

		    await placeOrder('Wallet');
		};

		async function handleRazorpayPayment() {
		try {
			// Show loading
			Swal.fire({
				title: 'Initializing Payment...',
				text: 'Please wait',
				allowOutsideClick: false,
				didOpen: () => {
					Swal.showLoading();
				}
			});

			// Get order amount from page
			const finalAmountText = document.getElementById("finalAmount")?.textContent || "";
			console.log("Final amount text:",finalAmountText);
			const finalAmount = parseFloat(finalAmountText?.replace(/[^0-9.]/g, '') || '<%= finalPrice %>');
			console.log("final amount:",finalAmount);

			if (!finalAmount || finalAmount <= 0) {
                return Swal.fire({ icon: 'error', title: 'Invalid Amount', text: 'Cannot process payment.' });
            }

			// Step 1: Create Razorpay order
			const response = await fetch('/checkout/create-razorpay-order', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ finalAmount })
			});

			const data = await response.json();

			if (!data.success) {
				console.log("Failed to create payment order.");
				Swal.close();
				return Swal.fire({
					icon:'error',
					title:"Failed!",
					text:"Failed to create payment order."
				});
			}

			Swal.close(); // Close loading

			// Step 2: Configure Razorpay options
			const options = {
				key: data.key,
				amount: data.amount,
				currency: data.currency,
				name: 'OraBolt', 
				description: 'Order Payment',
				order_id: data.orderId,
				handler: async function (razorpayResponse) {
					// Payment successful - verify and place order
					await verifyAndPlaceOrder(razorpayResponse);
				},
				prefill: {
					name: '<%= user?.name || "" %>',
					email: '<%= user?.email || "" %>',
					contact: '<%= user?.phone || "" %>'
				},
				notes: {
					order_type: 'product_purchase'
				},
				theme: {
					color: '#ffc107' // Match your site theme
				},
				modal: {
					ondismiss: async function (params) {
						await handlePaymentFailure(data.orderId,"Payment cancelled by user");
					}
				}
			};

			// Step 3: Initialize Razorpay
			const rzp = new Razorpay(options);

			// Handle payment failure
			rzp.on('payment.failed', async function (response) {
				console.error('Payment failed:', response.error);
				await handlePaymentFailure(data.orderId,response.error.description||"Payment failed");
			});

			// Open Razorpay checkout
			rzp.open();

		} catch (error) {
			console.error('Error initiating Razorpay:', error);
			Swal.close();
			Swal.fire({
				icon: 'error',
				title: 'Payment Error',
				text: error.message || 'Failed to initialize payment'
			});
		}
	}

	    async function handlePaymentFailure(razorpayOrderId,errorMessage) {
		    try {
			    Swal.fire({
                    title: 'Processing...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

	    		// Place order with payment failed status
                await placeOrder('Razorpay', {
                    razorpayOrderId: razorpayOrderId,
                    isPaymentFailed: true
                });
	    	} catch (error) {
		    	console.error('Error handling payment failure:', error);
				Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to process. Please contact support.'
                });
    		}
	    }

	    // Verify Razorpay payment and place order
	    async function verifyAndPlaceOrder(razorpayResponse) {
		    try {
			    // Show verifying dialog
			    Swal.fire({
				    title: 'Verifying Payment...',
				    text: 'Please wait',
				    allowOutsideClick: false,
				    didOpen: () => {
					    Swal.showLoading();
				    }
			    });

			    // Step 1: Verify payment signature
			    const verifyResponse = await fetch('/checkout/verify-payment', {
				    method: 'POST',
				    headers: { 'Content-Type': 'application/json' },
				    body: JSON.stringify({
					    razorpay_order_id: razorpayResponse.razorpay_order_id,
					    razorpay_payment_id: razorpayResponse.razorpay_payment_id,
					    razorpay_signature: razorpayResponse.razorpay_signature
				    })
			    });

			    const verifyData = await verifyResponse.json();

			    if (!verifyData.success) {
				    console.log("Payment verification failed.")
					return await handlePaymentFailure(razorpayResponse.razorpay_order_id,"Payment verification failed");
			    }

			    // Step 2: Place order after successful verification
			    await placeOrder('Razorpay', {
				    razorpayPaymentId: razorpayResponse.razorpay_payment_id,
				    razorpayOrderId: razorpayResponse.razorpay_order_id,
					isPaymentFailed:false
			    });

		    } catch (error) {
			    console.error('Error verifying payment:', error);
				Swal.close();
			    Swal.fire({
				    icon: 'error',
				    title: 'Verification Failed',
				    html: `
					    <p>Payment verification failed.</p>
					    <p><b>Payment ID:</b> ${razorpayResponse.razorpay_payment_id}</p>
					    <p style="color: #666; font-size: 14px;">Please contact support with this payment ID if amount was deducted.</p>
				    `,
				    confirmButtonColor: '#d33'
			    });
		    }
	    };

	    async function placeOrder(paymentMethod, paymentDetails = {}) {
			try {
			    Swal.fire({
				    title: 'Creating Order...',
				    text: 'Please wait',
				    allowOutsideClick: false,
				    didOpen: () => {
				    	Swal.showLoading();
				    }
			    });

				const appliedCouponCode = document.getElementById('appliedCouponCode').value;
				const productId = document.getElementById("directProductId");
			    const quantity = document.getElementById("directQty");

				const bodyData = {
					paymentMethod,
					appliedCouponCode:appliedCouponCode||null,
				    ...paymentDetails
			    };

				if(productId && quantity){
					bodyData.productId = productId.value;
					bodyData.quantity = quantity.value || 1;
				}

			    const orderResponse = await fetch('/checkout/place-order', {
				    method: 'POST',
				    headers: { 'Content-Type': 'application/json' },
				    body: JSON.stringify(bodyData)
			    });

			    const orderData = await orderResponse.json();

				Swal.close();

				if (orderData.paymentFailed) {
                    // Payment failed but order created
                    return Swal.fire({
                        title: 'Payment Failed!',
                        html: `
                            <div style="text-align: center; padding: 10px;">
                                <p style="font-size: 16px; margin: 10px 0;"><b>Order ID:</b> ${orderData.orderId}</p>
                                <p style="font-size: 16px; margin: 10px 0;"><b>Amount:</b> ₹${orderData.amount}</p>
                                <p style="color: #dc3545; margin-top: 15px;">
                                    <i class="fas fa-exclamation-circle"></i> Your order was created but payment failed.
                                </p>
                                <p style="font-size: 14px; color: #666;">
                                    You can retry payment from the orders page.
                                </p>
                            </div>
                        `,
                        icon: 'error',
						showConfirmButton:true,
                        confirmButtonColor: '#dc3545',
						confirmButtonText:'Go to Orders'
                    }).then(() => {
                        window.location.href = "/orders";
                    });
			    } else if (orderData.success) {
                    // Successful order
                    return Swal.fire({
                        title: 'Order Placed Successfully.',
                        html: `
                            <div style="text-align: center; padding: 10px;">
                                <p style="font-size: 16px; margin: 10px 0;"><b>Order ID:</b> ${orderData.orderId}</p>
                                <p style="font-size: 16px; margin: 10px 0;"><b>Total Amount:</b> ₹${orderData.amount}</p>
                                <p style="color: #28a745; margin-top: 15px;">
                                    <i class="fas fa-check-circle"></i> Your order has been confirmed!
                                </p>
                            </div>
                        `,
                        icon: 'success',
                    }).then(() => {
                        window.location.href = `/order-success?orderId=${orderData.orderId}`;
                    });
    		    } else {
				    return Swal.fire({
				        icon: 'error',
				        title: 'Failed',
				        text: orderData.message || 'Failed to place order.'
			        });
			    }

		    } catch (error) {
			    console.error('Error placing order:', error);
				Swal.close();
			    Swal.fire({
			    	icon: 'error',
			    	title: 'Order Failed',
			    	text: error.message || 'Something went wrong while placing your order.'
			    });
		    }
	    }

		async function removeFromCart(productId) {
            try {
                const result = await Swal.fire({
                    icon: 'warning',
                    title: 'Are you sure?',
                    text: 'Do you want to remove this item from checkout?',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, remove it!',
                    cancelButtonText: 'Cancel'
                });
        
                if (!result.isConfirmed) {
                    console.log("User cancelled removal");
                    return;
                }

                const response = await fetch(`/checkout/remove/${productId}`, {
                    method: "DELETE",
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    }
                });

                // Check if response is JSON
                const contentType = response.headers.get("content-type");
        
                if (!contentType || !contentType.includes("application/json")) {
                    console.error("Non-JSON response received");
                    throw new Error("Server returned non-JSON response");
                }

                const data = await response.json();

                if (response.ok && data.success) {
                    await Swal.fire({
                        icon: "success",
                        title: "Removed!",
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    window.location.href = data.redirectUrl || '/checkout';
            
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error!",
                        text: data.message || "Failed to remove item",
                    });
                }

            } catch (error) {
                console.error('Remove from cart error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to remove item from cart. Please try again.',
                });
            }
        }

        // Load available coupons for the user
        async function loadAvailableCoupons() {
            try {
                const response = await fetch('/checkout/available-coupons', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                const result = await response.json();
                if (result.success && result.coupons.length > 0) {
                    displayAvailableCoupons(result.coupons);
                } else {
                    // Hide available coupons section if no coupons
                    document.getElementById('availableCoupons').style.display = 'none';
                }
            } catch (error) {
                console.error('Error loading coupons:', error);
                document.getElementById('availableCoupons').style.display = 'none';
            }
        }

        // Display available coupons
        function displayAvailableCoupons(coupons) {
            const couponsList = document.getElementById('couponsList');
            const availableCoupons = document.getElementById('availableCoupons');
    
            couponsList.innerHTML = '';
    
            coupons.forEach(coupon => {
                const couponHtml = `
                    <div class="col-md-6 mb-2">
                        <div class="card coupon-card border-success">
                            <div class="card-body p-3">
                                <h6 class="card-title text-success">${coupon.name}</h6>
                                <p class="card-text mb-1"><small>Get ₹${coupon.offerPrice} off</small></p>
                                <p class="card-text">
                                    <small class="text-muted">
                                        Min. order: ₹${coupon.minimumPrice}<br>
                                        Valid until: ${new Date(coupon.expireOn).toLocaleDateString()}
                                    </small>
                                </p>
                                <button type="button" class="btn btn-sm btn-outline-success" 
                                    onclick="applyCouponCode('${coupon.name}')">Apply
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                couponsList.innerHTML += couponHtml;
            });
            availableCoupons.style.display = 'block';
        }

        // Apply coupon from input field
        document.getElementById('applyCouponBtn').addEventListener('click', function() {
            const couponCode = document.getElementById('couponCode').value.trim();
            if (couponCode) {
                applyCoupon(couponCode);
            } else {
                showCouponMessage('Please enter a coupon code', 'danger');
            }
        });

        // Apply coupon from available coupons list
        function applyCouponCode(couponCode) {
            document.getElementById('couponCode').value = couponCode;
            applyCoupon(couponCode);
        }

        // Replace your getCartSubtotal function with this:
        function getCartSubtotal() {
            let subtotal = 0;
    
            // Get all cart items from the order summary
            const cartItems = document.querySelectorAll('.d-flex.align-items-center.mb-3');
            cartItems.forEach(item => {
                // Find the price element (last div with text-end class)
                const priceElement = item.querySelector('.text-end div:first-child');
                if (priceElement) {
                    const priceText = priceElement.textContent.replace('₹', '').replace(/,/g, '').trim();
                    const price = parseFloat(priceText);
                    if (!isNaN(price)) {
                        subtotal += price;
                    }
                }
            });
            // If calculation failed, fallback to server value
            if (subtotal === 0) {
                subtotal = parseFloat('<%= subTotal %>');
            }
            return subtotal;
        }

        // Update the applyCoupon function in frontend
        async function applyCoupon(couponCode) {
            const subtotal = getCartSubtotal();
            const applyCouponBtn = document.getElementById('applyCouponBtn');
	
	        if (isNaN(subtotal) || subtotal <= 0) {
                showCouponMessage('Error: Could not determine order amount.', 'danger');
                return;
            }
            // Show loading state
            applyCouponBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Applying...';
            applyCouponBtn.disabled = true;

            try {
                const response = await fetch('/checkout/apply-coupon', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        couponCode: couponCode,
                        orderAmount: parseFloat(subtotal)
                    })
                });

                const result = await response.json();

                if (result.success) {
                    // Update UI with discount
                    updateOrderSummary(result.discountAmount, result.finalAmount);
            
                    // Store coupon info in hidden fields
                    document.getElementById('appliedCouponCode').value = couponCode;
                    document.getElementById('appliedCouponId').value = result.coupon._id;
            
                    showCouponMessage(`${result.message} - ₹${result.discountAmount} discount applied!`, 'success');
            
                    // Hide available coupons after applying one
                    document.getElementById('availableCoupons').style.display = 'none';
            
                    // Add remove coupon button
                    const couponMessage = document.getElementById('couponMessage');
                    couponMessage.innerHTML += `
                        <button type="button" class="btn btn-sm btn-outline-danger mt-2 remove-coupon">
                            Remove Coupon
                        </button>
                    `;
                } else {
                    showCouponMessage(result.message, 'danger');
                    removeCoupon();
                }
            } catch (error) {
                console.error('Error applying coupon:', error);
                showCouponMessage('Error applying coupon', 'danger');
                removeCoupon();
            } finally {
                // Reset button state
                applyCouponBtn.innerHTML = 'Apply Coupon';
                applyCouponBtn.disabled = false;
            }
        }

        // Update order summary with discount
        function updateOrderSummary(discountAmount, finalAmount) {
            const discountRow = document.getElementById('discountRow');
            const discountAmountElem = document.getElementById('discountAmount');
            const finalAmountElem = document.getElementById('finalAmount');
    
            discountAmountElem.textContent = `-₹${discountAmount}`;
            finalAmountElem.textContent = `₹${finalAmount}`;
            discountRow.style.display = 'flex';
        }

        // Remove applied coupon
        function removeCoupon() {
            const subtotal = parseFloat('<%= subTotal %>');
    
            document.getElementById('appliedCouponCode').value = '';
            document.getElementById('appliedCouponId').value = '';
            document.getElementById('couponCode').value = '';
    
            // Reset order summary
            document.getElementById('discountRow').style.display = 'none';
            document.getElementById('finalAmount').textContent = `₹${subtotal}`;
            // Reload available coupons
            loadAvailableCoupons();
        }

        // Show coupon message
        function showCouponMessage(message, type) {
            const couponMessage = document.getElementById('couponMessage');
            couponMessage.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
        }

        // Add remove coupon functionality
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-coupon')) {
                removeCoupon();
                showCouponMessage('Coupon removed', 'info');
            }
        });
    </script>

