				}

				const minPrice = urlParams.get('minPrice');
				const maxPrice = urlParams.get('maxPrice');
				if (minPrice) {
					const minPriceInput = document.querySelector('input[name="minPrice"]');
					if (minPriceInput) minPriceInput.value = minPrice;
				}
				if (maxPrice) {
					const maxPriceInput = document.querySelector('input[name="maxPrice"]');
					if (maxPriceInput) maxPriceInput.value = maxPrice;
				}

				const colorValue = urlParams.get('color');
				if (colorValue) {
					const colorOption = document.querySelector(`[data-color="${colorValue}"]`);
					if (colorOption) {
						colorOptions.forEach(option => option.classList.remove('active'));
						colorOption.classList.add('active');
					}
				}

				const statusValue = urlParams.get('status');
				if (statusValue) {
					const statusSelect = document.querySelector('select[name="status"]');
					if (statusSelect) statusSelect.value = statusValue;
				}

				const sortValue = urlParams.get('sortBy');
				if (sortValue) {
					const sortSelect = document.querySelector('select[name="sortBy"]');
					if (sortSelect) sortSelect.value = sortValue;
				}

				const limitValue = urlParams.get('limit');
				if (limitValue) {
					const limitSelect = document.querySelector('select[name="limit"]');
					if (limitSelect) limitSelect.value = limitValue;
				}

				const subcategoriesValue = urlParams.get('subcategories');
				if (subcategoriesValue) {
					const subcategoryCheckbox = document.querySelector(`input[name="subcategories"][value="${subcategoriesValue}"]`);
					if (subcategoryCheckbox) subcategoryCheckbox.checked = true;
				}
			}

            initializeFilters();
        });

	</script>

