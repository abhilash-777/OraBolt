<%-include("../partials/user/header.ejs") %>

    <style>
        body,
        html {
            height: 90%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }
        .resetPassword-container {
            background: rgba(255, 255, 255, 0.95);
            display:flexbox;
            align-items: center;
            padding: 30px 50px;
            border-radius: 12px;
            max-width: 450px;
            height: 430px;
            margin: auto;
            margin-top: 180px;
            border: 1px solid #f1ebeb;
            box-shadow: 5px 5px 5px #c9a12f;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #c9a12f;
        }
        .btn-login {
            background-color: #c9a12f;
            color: rgb(255, 255, 255);
            font-weight: bold;
            max-width: 200px;
            width: 100%;
            margin-top: 40px;
            margin-left: 80px;
        }
        .btn-login:hover {
            background-color: #eec50f;
            color: #fff;
        }
        .goToForgot{
            color: black;
            text-decoration: none;
        }
        .goToForgot:hover{
            color: blue;
            text-decoration: underline;
        }
        h2 {
            font-weight: 700;
            color: #333;
        }
        .option{
            margin-left: 210px;
        }
        .err_msg{
            color: red;
            font-size: 10px;
            display: none;
        }
    </style>

    <div class="resetPassword-container">
        <h2 class="text-center mb-4">Reset Password</h2>
        <form id="resetPasswordForm">
            
            <div class="mb-3">
                <label for="password" class="form-label">New Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Enter new password" >
                <small id="passwordError"></small>
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="confirm new password" >
                <small id="confirmPassError"></small>
            </div>

            <button type="submit" class="btn btn-login w-100 mb-2">Reset</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        const form = document.getElementById("resetPasswordForm");
        const passwordInput = document.getElementById("password");
        const confirmPasswordInput = document.getElementById("confirmPassword");
        let passwordError = document.getElementById("passwordError");
        let confirmPassError = document.getElementById("confirmPassError");

        function validateForm(){
            let isValid = true;
            passwordError.textContent = "";
            confirmPassError.textContent = "";

            const trimPass = passwordInput.value.trim();
            const trimCPass = confirmPasswordInput.value.trim();
            if(!trimPass||trimPass.length < 8||trimPass.length > 20){
                passwordError.textContent = "Password should be 8-20 letters";
                isValid = false;
            }else if(!/[a-zA-Z]/.test(trimPass||!/\d/.test(trimPass))){
                passwordError.textContent = "Password should contain number and alphabets";
                isValid = false;
            }

            if(trimPass !== trimCPass){
                passwordError.textContent = "Confirm password does not match";
                isValid = false;
            }

            return isValid
        }

        form.addEventListener("submit",async (event) => {
            event.preventDefault();
            if(!validateForm())return;

            try {
                const res = await fetch("/resetPassword",{
                    method:"POST",
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify({
                        password:passwordInput.value,
                        confirmPassword:confirmPasswordInput.value
                    })
                });
                const data = await res.json();
                if(data.success){
                    Swal.fire({
                        title:"Done.",
                        text:"Password reset successfully",
                        icon:"success",
                        showConfirmButton:false,
                        timer:1000
                    });
                    setTimeout(() => {
                        window.location.href = data.redirectUrl||"/login";
                    },1000);
                }else{
                    Swal.fire({ 
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'Unable to reset password'
                    });
                    setTimeout(() => {
                        window.location.href = data.redirectUrl||"/pageError";
                    },1000);
                }

            } catch (error) {
                console.error("something wrong to reset password:",error);
                Swal.fire({ icon: 'error', title: 'Network error', text: 'Please try again' });
            }
        });

    </script>