	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>

		async function addToWishlist(productId) {
			try {
				const response = await fetch(`/wishlist/add/${productId}`,{
					method:"POST",
				});
				const data = await response.json();
				if(data.success){
					Swal.fire({
						icon:"success",
						title:"Added.",
						text:data.message,
						showConfirmButton:false,
						timer:1500
					})
					window.location.href = "/"
				}else{
					Swal.fire({icon:"error",title:"Failed!",text:"Failed to add item into wishlist"});
				}
			} catch (error) {
				console.log("something went wrong while adding into cart");
				Swal.fire({icon:"error",title:"Oops!",text:"something went wrong while adding into cart"});
			}
		};

		document.querySelectorAll(".add-to-cart").forEach(btn => {
			btn.addEventListener("click",async (e) => {
				e.preventDefault();
				const productId = btn.dataset.id;
				const quantity = 1;
				try {
					const response = await fetch("/cart/add",{
						method:"POST",
						headers:{'Content-Type':'application/json'},
						body:JSON.stringify({productId,quantity})
					});

					const data = await response.json();
					if(data.success){
						Swal.fire({icon:'success',title:"Added.",text:'product added to cart',showConfirmButton:false,timer:1500})
					}else{
						Swal.fire({icon:"error",title:"Failed!",text:data.message||"Failed to add product into cart"});
					}
				} catch (error) {
					console.log("something went wrong while add to cart:",error);
					Swal.fire({icon:"error",title:"Oops!",text:error.message||"something went wrong while add to cart"});
				}
			})
		});
		
	</script>

