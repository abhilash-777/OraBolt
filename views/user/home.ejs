    <style>
		/* Wishlist icon on product image */
        .wishlist-icon {
	        position: absolute;
	        top: 10px;
        	right: 10px;
        	border-radius: 50%;
    	    padding: 8px;
        	z-index: 10;
           	color: #fbcccc;
        	font-size: 18px;
          	transition: all 0.2s ease;
        	text-decoration: none;
        }

        .wishlist-icon:hover {
	        color: #ff4d4d;
	        transform: scale(1.1);
        }

		.heart-icon {
            font-size: 24px;
            color: #ccc;
            transition: all 0.3s ease;
        }

        /* Heart icon when in wishlist - filled/darker */
        .heart-icon.in-wishlist {
            color: #e74c3c;  /* Red color for filled heart */
        }

        /* Hover effect */
        .wishlist-icon:hover .heart-icon {
            transform: scale(1.2);
        }

        .wishlist-icon:hover .heart-icon:not(.in-wishlist) {
            color: #e74c3c;
            opacity: 0.7;
        }

        .img-prod {
        	position: relative;
        	display: block;
           	overflow: hidden;
        }
	</style>

