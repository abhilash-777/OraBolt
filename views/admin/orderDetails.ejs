<%- include("../partials/admin/header.ejs") %>

<section class="content-main">
  <div class="content-header mb-3">
    <h2>Order Details</h2>
    <div>
      <a href="/admin/order-list" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Back to Orders</a>
    </div>
  </div>

  <div class="card mb-4">
  <div class="card-body">
    <p><strong>Order ID:</strong> <%= order.orderId %></p>
    <p><strong>Customer:</strong> <%= order.userId.name %> (<%= order.userId.email %>)</p>
    <p><strong>Date:</strong> <%= new Date(order.createdOn).toLocaleString() %></p>

    <p><strong>Order Status:</strong> 
      <span class="badge bg-info"><%= order.status %></span>
    </p>

    <p><strong>Payment Status:</strong> 
      <span class="badge bg-success"><%= order.paymentStatus %></span>
    </p>

    <!-- Order Status Update Form -->
    <% 
      const lockedOrderStatuses = ["Cancelled", "Returned"];
      const isOrderLocked = lockedOrderStatuses.includes(order.status);
      const lockedPaymentStatus = ["Paid","Returned","Partial Refund Initiated"];
      const isPaymentLocked = lockedPaymentStatus.includes(order.paymentStatus)
    %>
    
    <% if(!isOrderLocked){ %>
      <% if(order.status !== 'Delivered'){ %>
        <form id="orderStatusForm" class="mt-3">
          <div class="row align-items-center">
            <div class="col-md-6">
              <label class="form-label fw-bold">Change Order Status</label>
              <select name="status" class="form-select">
                <option value="Pending" <%=order.status==='Pending' ?'selected':'' %>>Pending</option>
                <option value="Processing" <%=order.status==='Processing' ?'selected':'' %>>Processing</option>
                <option value="Shipped" <%=order.status==='Shipped' ?'selected':'' %>>Shipped</option>
                <option value="Delivered" <%=order.status==='Delivered' ?'selected':'' %>>Delivered</option>
                <option value="Cancelled" <%=order.status==='Cancelled' ?'selected':'' %>>Cancelled</option>
                <option value="Returned" <%=order.status==='Returned' ?'selected':'' %>>Returned</option>
              </select>
            </div>
            <div class="col-md-3 mt-3 mt-md-0">
              <button type="submit" class="btn btn-primary w-100">Update Order Status</button>
            </div>
          </div>
        </form>
      <% }%>
    <% }else{ %>
      <div class="alert alert-danger mt-3">
        This order has been cancelled. Status updates are disabled.
      </div>
    <% } %>

    <% if(!isPaymentLocked && order.paymentStatus === "Pending" || order.paymentStatus === 'Failed'){ %>
      <form id="paymentStatusForm" class="mt-3">
        <div class="row align-items-center">
          <div class="col-md-6">
            <label class="form-label fw-bold">Change Payment Status</label>
            <select name="paymentStatus" class="form-select">
              <option value="Pending" <%=order.paymentStatus==='Pending' ?'selected':'' %>>Pending</option>
              <option value="Paid" <%=order.paymentStatus==='Paid' ?'selected':'' %>>Paid</option>
              <option value="Failed" <%=order.paymentStatus==='Failed' ?'selected':'' %>>Failed</option>
              <option value="Refunded" <%=order.paymentStatus==='Refunded' ?'selected':'' %>>Refunded</option>
            </select>
          </div>
          <div class="col-md-3 mt-3 mt-md-0">
            <button type="submit" class="btn btn-success w-100">Update Payment Status</button>
          </div>
        </div>
      </form>
    <% } %>
  </div>
</div>


  <!-- Address -->
  <div class="card mb-4">
    <div class="card-header"><h4>Shipping Address</h4></div>
    <div class="card-body">
      <p><strong><%= order.address.name %></strong></p>
      <p><%= order.address.street %>, <%= order.address.city %>, <%= order.address.state %></p>
      <p>Pincode: <%= order.address.pincode %></p>
      <p>Phone: <%= order.address.phone %></p>
    </div>
  </div>

  <!-- Ordered Items -->
  <div class="card mb-4">
    <div class="card-header"><h4>Ordered Items</h4></div>
    <div class="card-body">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Name</th>
          <th>Product Image</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Subtotal</th>
          <th>Status</th>
          <th>Return Request</th>
        </tr>
      </thead>
      <tbody>
        <% order.orderedItems.forEach(item => { %>
          <tr data-item-id="<%= item._id %>">
            <td><%= item.product ? item.product.productName : item.name %></td>
            <td>
              <img 
                src="<%= item.product && item.product.images && item.product.images.length > 0
                  ? '/uploads/productsImages/' + item.product.images[0]
                  : (item.image ? '/uploads/productsImages/' + item.image : '/admin/assets/imgs/items/default.jpg') %>"
                alt="Product"
                style="width:60px;height:60px;object-fit:cover;" 
                class="rounded me-2">
            </td>
            <td>₹<%= item.price.toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= (item.price * item.quantity).toFixed(2) %></td>

            <!-- Individual Item Status Update -->
            <td>
              <% 
                const lockedStatuses = ['Delivered', 'Cancelled', 'Returned'];
                const isLocked = lockedStatuses.includes(item.status);
              %>
              <% if(order.orderedItems.length > 1){ %>
                <% if (isLocked) { %>
                  <!-- Show locked status badge -->
                  <div class="d-flex align-items-center">
                    <span class="badge <%= 
                      item.status === 'Delivered' ? 'bg-success' : 
                      item.status === 'Cancelled' ? 'bg-danger' : 
                      item.status === 'Returned' ? 'bg-warning text-dark' : 'bg-secondary' 
                    %> me-2">
                      <%= item.status %>
                    </span>
                    <small class="text-muted"><i class="fas fa-lock"></i></small>
                  </div>
                <% } else { %>
                  <form class="singleItemStatusForm d-flex" data-item-id="<%= item._id %>">
                    <select name="status" class="form-select form-select-sm me-2" <%= item.status === 'Cancelled' ? 'disabled' : '' %>>
                      <option value="Pending" <%= item.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                      <option value="Processing" <%= item.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                      <option value="Shipped" <%= item.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                      <option value="Delivered" <%= item.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                      <option value="Cancelled" <%= item.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                      <option value="Returned" <%= item.status === 'Return Approved' ? 'selected' : '' %>>Returned</option>
                    </select>
                    <button type="submit" class="btn btn-outline-primary btn-sm" 
                      <%= item.status === 'Cancelled' ? 'disabled' : '' %>>Update
                    </button>
                  </form>
                <% } %>
              <% } else { %>
                <span><%= item.status %></span>
              <% } %>
            </td>

            <!-- Return Request Handling -->
            <td>
              <% if (item.returnRequest && item.returnRequest.status !== 'None') { %>
                <strong>Status:</strong> <%= item.returnRequest.status %><br>
                <strong>Reason:</strong> <%= item.returnRequest.reason %><br>
                <strong>Requested On:</strong> 
                <% if (item.returnRequest.requestedOn && !isNaN(new Date(item.returnRequest.requestedOn).getTime())) { %>
                  <%= new Date(item.returnRequest.requestedOn).toLocaleDateString() %>
                <% } else { %>
                  Not available
                <% } %>
                <% if (item.returnRequest.status === 'Rejected' && item.returnRequest.rejectionReason) { %>
                  <br><strong>Rejection Reason:</strong> <%= item.returnRequest.rejectionReason %>
                <% } %>
              <% } else { %>
                No return request
              <% } %>
            </td>
            <td>
              <% if (item.returnRequest?.status === 'Return Requested') { %>
                <button class="btn btn-success btn-sm" onclick="handleReturnDecision('<%= order._id %>', '<%= item._id %>', 'approve')">Approve</button>
                <button class="btn btn-danger btn-sm" onclick="showRejectModal('<%= order._id %>', '<%= item._id %>')">Reject</button>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  </div>

   <div id="rejectModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
      <div style="background: white; padding: 30px; border-radius: 10px; max-width: 500px; width: 90%;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <h3 style="margin: 0;">Reject Return Request</h3>
          <button onclick="closeRejectModal()" style="background: none; border: none; font-size: 24px; cursor: pointer;">&times;</button>
        </div>
        <form id="rejectForm">
          <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Rejection Reason <span style="color: red;">*</span></label>
            <textarea id="rejectionReason" rows="5" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px;" placeholder="Please provide the reason for rejecting the return..." required></textarea>
            <small style="color: #6c757d; display: block; margin-top: 5px;">
              <span id="rejectCharCount">0</span>/500 characters
            </small>
          </div>
          <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button type="button" onclick="closeRejectModal()" style="padding: 10px 20px; background: #6c757d; color: white; border: none; border-radius: 6px; cursor: pointer;">
              Cancel
            </button>
            <button type="submit" style="padding: 10px 20px; background: #dc3545; color: white; border: none; border-radius: 6px; cursor: pointer;">
              Submit Rejection
            </button>
          </div>
        </form>
      </div>
    </div>

  <!-- Summary -->
  <div class="card">
    <div class="card-body">
      <h4>Order Summary</h4>
      <p><strong>Total:</strong> ₹<%= order.totalPrice.toFixed(2) %></p>
      <p><strong>Discount:</strong> ₹<%= order.discount.toFixed(2) %></p>
      <p><strong>Final Price:</strong> ₹<%= order.finalPrice.toFixed(2) %></p>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const orderStatusForm = document.getElementById("orderStatusForm");
  const paymentStatusForm = document.getElementById("paymentStatusForm");
  const singleItemStatusForm = document.querySelectorAll(".singleItemStatusForm");
  const returnRequestForm = document.getElementById("returnRequestForm");

  const orderId = "<%= order._id %>";

  document.addEventListener("DOMContentLoaded",() => {
    if(orderStatusForm){
      orderStatusForm.addEventListener("submit",async (e) => {
  
        e.preventDefault();
        const status = e.target.status.value;
  
        const confirmResult = await Swal.fire({
          icon:"warning",
          title:"Update Order Status?",
          html: `
            <p>This will update the status to: <strong>${status}</strong></p>
            <p style="color: #666; font-size: 14px;">
              <i class="fas fa-info-circle"></i> Items that are already Cancelled, Returned, or Delivered will not be affected.
            </p>
          `,
          showCancelButton:true,
          confirmButtonColor:"#3085d6",
          cancelButtonColor:"#d33",
          confirmButtonText:"Yes, Do it!"
        });
        if(!confirmResult.isConfirmed)return
  
        try {
  
          const response = await fetch(`/admin/order-status/${orderId}`,{
            method:"POST",
            headers:{
              'Content-Type':'application/json'
            },
            body:JSON.stringify({status})
          });
          const data = await response.json();
          if(data.success){
            Swal.fire({
              icon:"success",
              title:"Done.",
              text:data.message||"Order status updated.",
              showConfirmButton:false,
              timer:1000
            })
            .then(() => window.location.href = data.redirectUrl||`/admin/order-details,${orderId}`)
          }else{
            Swal.fire({
              icon:"error",
              title:"Failed!",
              text:data.message||"Failed to update order status"
            })
          } 
        } catch (error) {
          console.log("Something went wrong:",error);
          Swal.fire({
            icon:"error",
            title:"Oops!",
            text:"Something went Wrong",
          })
        }
      });
    }

    if(paymentStatusForm){
      paymentStatusForm.addEventListener("submit",async (e) => {
  
        e.preventDefault();
        const paymentStatus = e.target.paymentStatus.value;
  
        const confirmResult = await Swal.fire({
          icon:"warning",
          title:"Update Payment Status?",
          text:`Change payment status to: ${paymentStatus}`,
          showCancelButton:true,
          confirmButtonColor:"#3085d6",
          cancelButtonColor:"#d33",
          confirmButtonText:"Yes, Do it!"
        });
        if(!confirmResult.isConfirmed)return
  
        try {
  
          const response = await fetch(`/admin/order/payment-status/${orderId}`,{
            method:"POST",
            headers:{
              'Content-Type':'application/json'
            },
            body:JSON.stringify({paymentStatus})
          });
          const data = await response.json();
          if(data.success){
            Swal.fire({
              icon:"success",
              title:"Done.",
              text:data.message||"Order payment status updated.",
              showConfirmButton:false,
              timer:1000
            })
            .then(() => window.location.href = data.redirectUrl||`/admin/order-details/${orderId}`)
          }else{
            Swal.fire({
              icon:"error",
              title:"Failed!",
              text:data.message||"Failed to update order payment status",
            })
          }  
        } catch (error) {
          console.log("Something went wrong:",error);
          Swal.fire({
            icon:"error",
            title:"Oops!",
            text:"Something went Wrong",
          })
        }
      });
    }

    if(singleItemStatusForm){
      singleItemStatusForm.forEach(form => {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const itemId = e.target.dataset.itemId;
          const status = e.target.elements?.status?.value;
        
          const confirmResult = await Swal.fire({
            icon:"warning",
            title:"Update Item Status?",
            text:`Change item status to: ${status}`,
            showCancelButton:true,
            confirmButtonColor:"#3085d6",
            cancelButtonColor:"#d33",
            confirmButtonText:"Yes, Do it!"
          });
          if(!confirmResult.isConfirmed)return
  
          try {
            const response = await fetch(`/admin/order/item-status/${orderId}/${itemId}`,{
              method:"POST",
              headers:{
                'Content-Type':'application/json'
              },
              body:JSON.stringify({status})
            });
            const data = await response.json();
            if(data.success){
              Swal.fire({
                icon:"success",
                title:"Done.",
                text:data.message||"Order payment status updated.",
                showConfirmButton:false,
                timer:1000
              })
              .then(() => window.location.href = data.redirectUrl||`/admin/order-details/${orderId}`)
            }else{
              Swal.fire({
                icon:"error",
                title:"Failed!",
                text:data.message||"Failed to update order payment status",
              })
            }
          
          } catch (error) {
            console.log("Something went wrong:",error);
            Swal.fire({
              icon:"error",
              title:"Oops!",
              text:"Something went Wrong",
            })
          }
        });
      });
    }
  });

  let currentOrderId = null;
  let currentItemId = null;

  function showRejectModal(orderId, itemId) {
    currentOrderId = orderId;
    currentItemId = itemId;
    document.getElementById('rejectModal').style.display = 'flex';
    document.getElementById('rejectionReason').value = '';
    document.getElementById('rejectCharCount').textContent = '0';
    document.getElementById('rejectionReason').focus();
  }

  function closeRejectModal() {
    document.getElementById('rejectModal').style.display = 'none';
    currentOrderId = null;
    currentItemId = null;
  }

  document.getElementById('rejectModal').addEventListener('click', function(e) {
    if (e.target.id === 'rejectModal') {
      closeRejectModal();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.getElementById('rejectModal').style.display === 'flex') {
      closeRejectModal();
    }
  });

  document.getElementById('rejectForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const rejectionReason = document.getElementById('rejectionReason').value.trim();
    if (rejectionReason.length < 10) {
      Swal.fire({
        icon: 'warning',
        title: 'Invalid Reason',
        text: 'Please provide at least 10 characters for the rejection reason',
      });
      return;
    }
    await processReturnAction(currentOrderId,currentItemId,"reject",{rejectionReason});
    closeRejectModal();
  });

  async function processReturnAction(orderId, itemId, action , extraData = {}) {
    try {
      const response = await fetch(`/admin/order/item-return/${orderId}/${itemId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        credentials: 'include',
        body: JSON.stringify({ action , ...extraData })
      });

      const contentType = response.headers.get('content-type');
      if (!contentType || !contentType.includes('application/json')) {
        throw new Error(`Received non-JSON response: ${response.status} ${response.statusText}`);
      }
      const data = await response.json();
      if (data.success) {
        Swal.fire({
          icon: 'success',
          title: 'Done!',
          text: data.message,
          showConfirmButton: false,
          timer: 2000
        }).then(() => {
          window.location.href = data.redirectUrl || `/admin/order-details/${orderId}`;
        });
      } else {
        Swal.fire('Error!',data.message || 'Failed to process return decision','error');
      }
    } catch (error) {
      console.error('Error processing return decision:', error);
      Swal.fire({
        icon: 'error',
        title: 'Oops!',
        text: 'Something went wrong. Please try again.',
      });
    }
  };

  async function handleReturnDecision(orderId,itemId,action) {
    if(action === 'approve'){
      const confirmResult = await Swal.fire({
        icon:'warning',
        title:'Are you sure',
        text:"Do you want to approve this return request?",
        showCancelButton:true,
        cancelButtonColor:"#d33",
        confirmButtonColor:"#3085d6",
        confirmButtonText:"Yes , Approve it!"
      });

      if(!confirmResult)return
    }
    await processReturnAction(orderId,itemId,action);
  }

  const rejectionReasonTextarea = document.getElementById('rejectionReason');
  if (rejectionReasonTextarea) {
    rejectionReasonTextarea.addEventListener('input', function() {
      const count = this.value.length;
      document.getElementById('rejectCharCount').textContent = count;
      if (count > 500) {
        this.value = this.value.substring(0, 500);
        document.getElementById('rejectCharCount').textContent = 500;
      }
    });
  }

</script>

<%- include("../partials/admin/footer.ejs") %>