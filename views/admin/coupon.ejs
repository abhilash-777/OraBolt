<%-include("../partials/admin/header.ejs") %>
    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2">Coupon Management</h1>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#couponModal" onclick="openCreateModal()">
                <i class="fas fa-plus"></i> Create New Coupon
            </button>
        </div>
    
        <!-- Coupons Table -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">All Coupons</h5>
            </div>
            <div class="card-body">
                <% if (coupons.length===0) { %>
                    <div class="alert alert-info">No coupons found. Create your first coupon!</div>
                <% } else { %>
                    <% const now=new Date(); %>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Coupon Name</th>
                                    <th>Amount</th>
                                    <th>Min Amount</th>
                                    <th>used</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Limit</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% coupons.forEach(coupon=> { %>
                                    <tr>
                                        <td>
                                            <strong><%= coupon.name %></strong>
                                            <% if (coupon.usedBy.length> 0) { %>
                                                <br>
                                                <small class="text-muted">
                                                    Used by <%= coupon.usedBy.length %> user(s)
                                                </small>
                                            <% } %>
                                        </td>
                                        <td>₹<%= coupon.offerPrice %></td>
                                        <td>₹<%= coupon.minimumPrice %></td>
                                        <td><%= coupon.usedBy.length %></td>
                                        <td><%= coupon.createdOn.toLocaleDateString() %></td>
                                        <td><%= coupon.expireOn.toLocaleDateString() %></td>
                                        <td>
                                            <%= coupon.usageLimit ? coupon.usageLimit : 'Unlimited' %>
                                            <% if (coupon.usageLimit) { %>
                                                <br>
                                                <small class="text-muted">
                                                    <%= coupon.usageLimit - coupon.usedBy.length %> left
                                                </small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% const isExpired=now> new Date(coupon.expireOn); %>
                                            <% if(isExpired){ %>
                                                <span class="badge btn-danger">Expired</span>
                                            <% } else { %>
                                                <form class="d-inline">
                                                    <button type="button" data-id="<%= coupon._id %>"
                                                        class="btn btn-sm <%= coupon.isList ? 'btn-success' : 'btn-secondary' %> status-btn">
                                                        <%= coupon.isList ? 'Active' : 'Inactive' %>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="dropdown">
                                                <a href="#" data-bs-toggle="dropdown"
                                                    class="btn btn-light rounded btn-sm font-sm">
                                                    <i class="material-icons md-more_horiz"></i>
                                                </a>
                                                <div class="dropdown-menu">
                                                    <a class="dropdown-item edit-coupon-btn" href="#"
                                                        data-id="<%= coupon._id %>"
                                                        data-name="<%= coupon.name %>"
                                                        data-offer="<%= coupon.offerPrice %>"
                                                        data-minimum="<%= coupon.minimumPrice %>"
                                                        data-start="<%= new Date(coupon.createdOn).toISOString().split('T')[0] %>"
                                                        data-end="<%= new Date(coupon.expireOn).toISOString().split('T')[0] %>"
                                                        data-limit="<%= coupon.usageLimit || '' %>">
                                                        Edit info
                                                    </a>
                                                    <a class="dropdown-item text-danger delete-btn" href="#"
                                                        data-id="<%= coupon._id %>">Delete</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Coupon Modal (Create/Edit) -->
        <div class="modal fade" id="couponModal" tabindex="-1" aria-labelledby="couponModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="couponModalLabel">Create New Coupon</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="couponForm">
                            <input type="hidden" id="couponId" name="couponId">
        
                            <div class="mb-3">
                                <label for="name" class="form-label">Coupon Name *</label>
                                <input type="text" class="form-control" id="name" name="name">
                                <div class="form-text">Unique name for the coupon (5-10 characters)</div>
                                <small id="nameError" class="text-danger"></small>
                            </div>
        
                            <div class="mb-3">
                                <label for="offerPrice" class="form-label">Discount Amount (₹) *</label>
                                <input type="number" class="form-control" id="offerPrice" name="offerPrice" min="1" step="0.01">
                                <div class="form-text">Fixed discount amount (max ₹1000)</div>
                                <small id="discountError" class="text-danger"></small>
                            </div>
        
                            <div class="mb-3">
                                <label for="minimumPrice" class="form-label">Minimum Order Amount (₹) *</label>
                                <input type="number" class="form-control" id="minimumPrice" name="minimumPrice">
                                <div class="form-text">Minimum order amount required (min ₹500)</div>
                                <small id="minimumPriceError" class="text-danger"></small>
                            </div>
        
                            <div class="mb-3">
                                <label for="usageLimit" class="form-label">Usage Limit (Optional)</label>
                                <input type="number" class="form-control" id="usageLimit" name="usageLimit" min="1"
                                    placeholder="Leave empty for unlimited">
                                <div class="form-text">Maximum number of times this coupon can be used</div>
                            </div>
        
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="startDate" class="form-label">Start Date *</label>
                                        <input type="date" class="form-control" id="startDate" name="startDate">
                                        <small id="startDateError" class="text-danger"></small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="endDate" class="form-label">End Date *</label>
                                        <input type="date" class="form-control" id="endDate" name="endDate">
                                        <small id="endDateError" class="text-danger"></small>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="saveCouponBtn">Save Coupon</button>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        let isEditMode = false;

        // Open create modal
        function openCreateModal() {
            isEditMode = false;
            document.getElementById('couponModalLabel').textContent = 'Create New Coupon';
            document.getElementById('couponForm').reset();
            document.getElementById('couponId').value = '';
            document.querySelectorAll('small').forEach(el => el.textContent = '');
            
            // Set minimum dates
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('startDate').min = today;
            document.getElementById('startDate').disabled = false;
            document.getElementById('startDate').style.backgroundColor = '';
            document.getElementById('startDate').style.cursor = '';
            document.getElementById('endDate').min = today;
        }

        // Open edit modal
        document.querySelectorAll('.edit-coupon-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                isEditMode = true;
                document.getElementById('couponModalLabel').textContent = 'Edit Coupon';
                document.querySelectorAll('small').forEach(el => el.textContent = '');
                
                // Populate form
                document.getElementById('couponId').value = this.dataset.id;
                document.getElementById('name').value = this.dataset.name;
                document.getElementById('offerPrice').value = this.dataset.offer;
                document.getElementById('minimumPrice').value = this.dataset.minimum;
                document.getElementById('startDate').value = this.dataset.start;
                document.getElementById('endDate').value = this.dataset.end;
                document.getElementById('usageLimit').value = this.dataset.limit;
                
                // Disable start date in edit mode
                const startDateInput = document.getElementById('startDate');
                startDateInput.disabled = true;
                startDateInput.style.backgroundColor = '#e9ecef';
                startDateInput.style.cursor = 'not-allowed';
                
                // Set end date minimum
                document.getElementById('endDate').min = this.dataset.start;
                
                // Show modal
                const modal = new bootstrap.Modal(document.getElementById('couponModal'));
                modal.show();
            });
        });

        // Date validation
        document.getElementById('startDate').addEventListener('change', function() {
            document.getElementById('endDate').min = this.value;
        });

        document.getElementById('endDate').addEventListener('change', function() {
            const startDate = document.getElementById('startDate').value;
            const endDate = this.value;
            const errorEl = document.getElementById('endDateError');
            
            if (startDate && new Date(endDate) < new Date(startDate)) {
                errorEl.textContent = 'End date cannot be before start date';
                this.value = '';
            } else {
                errorEl.textContent = '';
            }
        });

        function validateForm(formData) {
            let isValid = true;
            document.querySelectorAll('small').forEach(el => el.textContent = '');
            
            const errors = {};

            if (!formData.name || !/^(?=.*[A-Za-z])[A-Za-z0-9\s._]+$/.test(formData.name)) {
                errors.nameError = "Coupon name should start with alphabet characters";
                isValid = false;
            } else if (formData.name.length < 5 || formData.name.length > 10) {
                errors.nameError = "Coupon name length should be between 5 to 10 characters";
                isValid = false;
            }

            if (!formData.offerPrice || formData.offerPrice <= 0) {
                errors.discountError = "Offer price should be a positive value greater than zero";
                isValid = false;
            } else if (parseFloat(formData.offerPrice) > 1000) {
                errors.discountError = "Offer should not exceed ₹1000";
                isValid = false;
            }

            if (!formData.minimumPrice || formData.minimumPrice <= 0) {
                errors.minimumPriceError = "Minimum price should be a positive value";
                isValid = false;
            } else if (parseFloat(formData.minimumPrice) < 500) {
                errors.minimumPriceError = "Minimum price should be above ₹500";
                isValid = false;
            }

            if(!isEditMode){
                if (!formData.startDate) {
                    errors.startDateError = "Please select a start date";
                    isValid = false;
                }
            }
            if (!formData.endDate) {
                errors.endDateError = "Please select an end date";
                isValid = false;
            }

            Object.keys(errors).forEach(id => {
                const el = document.getElementById(id);
                if (el) el.textContent = errors[id];
            });
            return isValid;
        }

        document.getElementById('saveCouponBtn').addEventListener('click', async () => {
            const formData = Object.fromEntries(new FormData(document.getElementById('couponForm')));
            
            if (!validateForm(formData)) return;

            const couponId = document.getElementById('couponId').value;
            const url = isEditMode ? `/admin/edit-coupon/${couponId}` : '/admin/coupons/create';
            const method = isEditMode ? 'PUT' : 'POST';

            if (isEditMode) {
                const confirmResult = await Swal.fire({
                    icon: "warning",
                    title: "Are you sure?",
                    text: "This action will overwrite your current details",
                    showCancelButton: true,
                    cancelButtonColor: "#d33",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "Yes, update it"
                });
                if (!confirmResult.isConfirmed) return;
            }

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();
                
                if (data.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('couponModal'));
                    modal.hide();
                    
                    Swal.fire({
                        icon: "success",
                        title: isEditMode ? "Updated" : "Created",
                        text: data.message || `Coupon ${isEditMode ? 'updated' : 'created'} successfully`,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => window.location.href = "/admin/coupons");
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Failed!",
                        text: data.message || `Failed to ${isEditMode ? 'update' : 'create'} coupon`
                    });
                }
            } catch (error) {
                console.error("Error:", error);
                Swal.fire({
                    icon: "error",
                    title: "Oops!",
                    text: "Something went wrong while processing"
                });
            }
        });

        document.querySelectorAll(".delete-btn").forEach(btn => {
            btn.addEventListener("click",async () => {
                const couponId = btn.dataset.id;
                console.log("coupon id:",couponId);
                const confirmResult = await Swal.fire({
                    icon:"warning",
                    title:"Are you sure ?",
                    text:"This coupon removes permanently",
                    showCancelButton:true,
                    cancelButtonColor:"#d33",
                    confirmButtonColor:"#3085d6",
                    confirmButtonText:"Yes , Delete it."
                });
                if(!confirmResult.isConfirmed)return
                try {
                    const response = await fetch(`/admin/coupons/delete/${couponId}`,{
                        method:"PATCH",
                    });
                    const data = await response.json();
                    if(data.success){
                        Swal.fire({
                            icon:"success",
                            title:"Deleted.",
                            text:"Coupon deleted successfully.",
                            showConfirmButton:false,
                            timer:1500
                        })
                        .then(() => window.location.href = "/admin/coupons");
                    }else{
                        Swal.fire({icon:"error",title:"Failed!",text:"Failed to delete coupon."});
                    }
                } catch (error) {
                    console.log("something wrong while processing");
                    Swal.fire({icon:"error",title:"Oops!",text:"something wrong while processing"});
                }
            });
        });

        document.querySelectorAll(".status-btn").forEach(btn => {
            btn.addEventListener("click",async () => {
               const couponId = btn.dataset.id;
               const confirmResult = await Swal.fire({
                    icon:"warning",
                    title:"Are you sure ?",
                    text:"Do you want to change coupon status",
                    showCancelButton:true,
                    cancelButtonColor:"#d33",
                    confirmButtonColor:"#3085d6",
                    confirmButtonText:"Yes , Do it."
                });
                if(!confirmResult.isConfirmed)return
                try {
                    const response = await fetch(`/admin/coupons/toggle-status/${couponId}`,{
                        method:"PATCH",
                    });
                    const data = await response.json();
                    if(data.success){
                        Swal.fire({
                            icon:"success",
                            title:"Updated.",
                            text:"Coupon status updated successfully.",
                            showConfirmButton:false,
                            timer:1500
                        })
                        .then(() => window.location.href = "/admin/coupons");
                    }else{
                        Swal.fire({icon:"error",title:"Failed!",text:"Failed to update coupon."});
                    }
                } catch (error) {
                    console.log("something wrong while processing");
                    Swal.fire({icon:"error",title:"Oops!",text:"something wrong while processing"});
                }
            });
        });
        </script>

    <%-include("../partials/admin/footer.ejs") %>