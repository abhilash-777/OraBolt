<%-include("../partials/admin/header.ejs") %>
    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div
            class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2">Edit Coupon</h1>
        </div>
    
        <!-- Create Coupon Form -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Coupon Details</h5>
                    </div>
                    <div class="card-body">
                        <% if (typeof error !=='undefined' ) { %>
                            <div class="alert alert-danger">
                                <%= error %>
                            </div>
                        <% } %>
    
                        <form id="editCouponForm">
                            <div class="mb-3">
                                <label for="name" class="form-label">Coupon Name *</label>
                                <input type="text" class="form-control" id="name" name="name" value="<%= coupon.name %>">
                                <div class="form-text">Unique name for the coupon</div>
                                <small id="nameError" style="color: red;"></small>
                            </div>
                        
                            <div class="mb-3">
                                <label for="offerPrice" class="form-label">Discount Amount (₹) *</label>
                                <input type="number" class="form-control" id="offerPrice" name="offerPrice" step="0.01"
                                    value="<%= coupon.offerPrice %>">
                                <div class="form-text">Fixed discount amount</div>
                                <small id="discountError" style="color: red;"></small>
                            </div>
                        
                            <div class="mb-3">
                                <label for="minimumPrice" class="form-label">Minimum Order Amount (₹) *</label>
                                <input type="number" class="form-control" id="minimumPrice" name="minimumPrice"
                                    value="<%= coupon.minimumPrice %>">
                                <div class="form-text">Minimum order amount required to apply this coupon</div>
                                <small id="minimumPriceError" style="color: red;"></small>
                            </div>
                        
                            <div class="mb-3">
                                <label for="usageLimit" class="form-label">Usage Limit (Optional)</label>
                                <input type="number" class="form-control" id="usageLimit" name="usageLimit" min="1"
                                    placeholder="Leave empty for no limit" value="<%= coupon.usageLimit %>">
                                <div class="form-text">Maximum number of times this coupon can be used. Leave empty
                                    for unlimited usage.</div>
                            </div>
                        
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="startDate" class="form-label">Start Date *</label>
                                        <input type="date" class="form-control" id="startDate" name="startDate" readonly
                                           style=" background-color: #e9ecef; cursor: not-allowed;"
                                           value="<%= coupon.createdOn ? new Date(coupon.createdOn).toISOString().split('T')[0] : "" %>">
                                    </div>
                                    <small id="startDateError" style="color: red;"></small>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="endDate" class="form-label">End Date *</label>
                                        <input type="date" class="form-control" id="endDate" name="endDate" 
                                            value="<%= coupon.expireOn ? new Date(coupon.expireOn).toISOString().split('T')[0] : "" %>">
                                    </div>
                                    <small id="endDateError" style="color: red;"></small>
                                </div>
                            </div>
                        
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="/admin/coupons" class="btn btn-secondary me-md-2">Cancel</a>
                                <button type="submit" class="btn btn-primary edit-btn">Update Coupon</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
    
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Coupon Information</h6>
                    </div>
                    <div class="card-body">
                        <p><strong>Coupon Type:</strong> Fixed Amount</p>
                        <p class="text-muted small">
                            This coupon provides a fixed discount amount when the order total meets the minimum amount
                            requirement.
                        </p>
                        <hr>
                        <p class="small text-muted">
                            <strong>Example:</strong><br>
                            Coupon: WELCOME50<br>
                            Discount: ₹50 off<br>
                            Min Order: ₹500<br>
                            Valid: 1st Jan - 31st Jan
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        const today = new Date();
        const startDateInput = document.getElementById("startDate");
        const endDateInput = document.getElementById("endDate");
        if(startDateInput.value){
            endDateInput.min = startDateInput.value;
        }

        endDateInput.addEventListener("change",function(){
            const startDate = new Date(startDateInput.value);
            const endDate = new Date(this.value);
            const endDateError = document.getElementById("endDateError");
            if(startDate > endDate){
                endDateError.textContent = 'End date cannot be before start date;';
                this.value = "";
            }else{
                endDateError.textContent = "";
            }
        });

        function validation(payload){
            let isValid = true;
            document.querySelectorAll("small").forEach(elem => elem.textContent = "");
            const errors = {
                nameError : "",
                discountError : "",
                minimumPriceError : "",
                startDateError : "",
                endDateError : ""
            };

            if(!payload.name || !/^(?=.*[A-Za-z])[A-Za-z\s._]+$/.test(payload.name)){
                errors.nameError = "Coupon name should start with alphabet charactors.";
            }else if(payload.name.length < 5 || payload.name.length > 10){
                errors.nameError = "Coupon name length in between 5 to 10 charactors";
            }
            if(!payload.offerPrice){
                errors.discountError = "Offer price Should required";
            }else if(payload.offerPrice <= 0){
                errors.discountError = "Offer price Should be a positive value(offer price should greater than zero)."
            }else if(payload.offerPrice > 1000){
                errors.discountError = "Offer should not exceed 1000 rupees.";
            }
            if(!payload.minimumPrice){
                errors.minimumPriceError = "Minimum price Should required.";
            }else if(payload.minimumPrice <= 0){
                errors.minimumPriceError = "Minimum price Should be a positive value(zero not consider as minimum price)";
            }else if(payload.minimumPrice < 500){
                errors.minimumPriceError = "Minimum price should above 500 rupees."
            }

            Object.keys(errors).forEach(id => {
                let ele = document.getElementById(id);
                if(ele && errors[id]){
                    ele.textContent = errors[id];
                    isValid = false
                }
            });
            return isValid
        };

        document.getElementById("editCouponForm").addEventListener("submit",async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const payload = Object.fromEntries(formData);
            if(!validation(payload))return
            const couponId = "<%= coupon._id %>";
            const confirmResult = await Swal.fire({
                icon:"warning",
                title:"Are you sure ?",
                text:"This action will overwrite your current datails",
                showCancelButton:true,
                cancelButtonColor:"#d33",
                confirmButtonColor:"#3085d6",
                confirmButtonText:"Yes , Do it."
            });
            if(!confirmResult.isConfirmed)return
            try {
                const response = await fetch(`/admin/edit-coupon/${couponId}`,{
                    method:"PUT",
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify(payload)
                });
                const data = await response.json();
                if(data.success){
                    Swal.fire({
                        icon:"success",
                        title:"Updated",
                        text:data.message,
                        showConfirmButton:false,
                        timer:1500
                    }).then(() => window.location.href = "/admin/coupons");
                }else{
                    Swal.fire({icon:"error",title:"Failed!",text:data.message||"Failed to update coupon"});
                }
            } catch (error) {
                Swal.fire({icon:"error",title:"Oops!",text:"Something wrong while processing"});
            }
        });

    </script>

<%-include("../partials/admin/footer.ejs") %>