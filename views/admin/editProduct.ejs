<%-include("../partials/admin/header.ejs")%>

<link  href="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.css" rel="stylesheet">

<section class="content-main">
    <div class="row">
        <div class="col-6">
            <div class="content-header">
                <h2 class="content-title">Edit Product</h2>
            </div>
        </div>
    </div>

    <form id="editProduct" method="post" action="/admin/productLists/edit/<%= product._id %>" enctype="multipart/form-data" >

        <% if(typeof success !=='undefined' && success){ %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                    <button type="button" class="btn-closs" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if(typeof error !=='undefined' && error){ %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-closs" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row">
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <h6>1. General info</h6>
                            </div>
                            <div class="col-md-9">
                                <div class="mb-4">
                                    <label class="form-label">Product Name</label>
                                    <input type="text" value="<%= product.productName %>" name="productName" placeholder="Enter product name" class="form-control" >
                                    <div id="productName-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Description</label>
                                    <textarea name="description"  placeholder="Enter description" class="form-control" rows="4"
                                    ><%= product.description %></textarea>
                                    <div id="description-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Brand name</label>
                                    <select name="brand" class="form-select" >
                                        <option value="">Select Brand</option>
                                        <% brand.forEach(b => { %>
                                            <option value="<%= b._id %>" <%= product.brand && ((product.brand._id && product.brand._id.toString() === b._id.toString())||
                                                (product.brand && product.brand.toString() === b._id.toString()))?'selected':"" %>> <%= b.brandName %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div id="brand-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Color</label>
                                    <input type="text" value="<%= product.color %>" name="color" placeholder="Enter colour" class="form-control" >
                                    <div id="color-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Quantity</label>
                                    <input type="text" value="<%= product.quantity %>" name="quantity" placeholder="0" class="form-control" min="0" >
                                    <div id="quantity-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                            </div>
                        </div>
                        <hr class="mb-4 mt-0">
                        <div class="row">
                            <div class="col-md-3">
                                <h6>2. Pricing</h6>
                            </div>
                            <div class="col-md-9">
                                <div class="mb-4">
                                    <label class="form-label">Regular Price</label>
                                    <input type="number" value="<%= product.regularPrice %>" name="regularPrice" placeholder="0.00" 
                                    step="0.01" min="0" class="form-control" >
                                    <div id="regularPrice-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Sale Price</label>
                                    <input type="number" value="<%= product.salePrice %>" name="salePrice" placeholder="0.00" 
                                    step="0.01" min="0" class="form-control" >
                                    <div id="salePrice-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                            </div>
                        </div>
                        <hr class="mb-4 mt-0">
                        <div class="row">
                            <div class="col-md-3">
                                <h6>3. Category</h6>
                            </div>
                            <div class="col-md-9">
                                <div class="mb-4">
                                    <select name="category" class="form-select" >
                                        <option value="">Select category</option>
                                        <% category.forEach(c => { %>
                                            <option value="<%= c._id %>" 
                                                <%= product.category._id.toString() === c._id.toString() ? 'selected':"" %>><%= c.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div id="category-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <h6>4. Sub Category</h6>
                            </div>
                            <div class="col-md-9">
                                <div class="mb-4">
                                    <select name="subcategory" class="form-select" >
                                        <option value="">Select subcategory</option>
                                        <% subcategory.forEach(sub => { %>
                                            <option value="<%= sub._id %>"
                                                 <%= product.subcategory._id.toString() === sub._id.toString() ? 'selected':"" %>><%= sub.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div id="subcategory-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                            </div>
                        </div>
                        <hr class="mb-4 mt-0">
                        <div class="row">
                            <div class="col-md-9">
                                <input type="file" id="images" name="croppedImages" class="form-control"
                                 accept="image/jpeg , image/png , image/jpg" multiple>
                            </div>
                            <div id="regularPrice-error" class="error-message text-danger" style="display: none;"></div>
                            <div id="cropperContainer" class="d-none mt-3">
                                <img id="imageToCrop" style="max-width: 100%; height: 400px;" >
                                <div class="mt-2">
                                    <button type="button" id="saveCrop" class="btn btn-primary btn-sm">Save Crop</button>
                                    <button type="button" id="skipCrop" class="btn btn-secondary btn-sm">Skip Crop</button>
                                </div>
                            </div>
                            <h5 class="mt-3">Selected images:</h5>
                            <div id="croppedPreview" class="d-flex flex-wrap gap-3"></div>
                            <div id="hiddenImages"></div>

                            <div class="col-md-3">
                                <h5 class="mt-3">Current images:</h5>
                                <div id="existingImages" class="d-flex flex-wrap gap-3">
                                    <% if(product.image && product.image.length > 0){ %>
                                        <% product.image.forEach((img,index) => { %>
                                            <div class="position-relative">
                                                <img src="/uploads/productsImages/<%= img %>" alt="Product Image" 
                                                class="img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;" >
                                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0"
                                                onclick="removeImage('<%= img %>',event)" >&times;</button>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p>No image uploaded yet:</p>
                                    <% } %>
                                </div>
                            </div>
                            <input type="hidden" name="deleteImages" id="deleteImages" value="" >
                        </div>
                        <div class="row"> 
                            <div class="col-12">
                                <button type="button" id="updateButton" class="btn btn-primary">Update Product</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>
</section>

<script src="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.js"></script>

<script>

    document.addEventListener("DOMContentLoaded",() => {
        console.log("js loaded - attached event listners");

        const form = document.getElementById("editProduct");
        const submitBtn = document.getElementById("updateButton");
        const fileInput = document.getElementById("images");
        const croppedPreview = document.getElementById("croppedPreview");
        const cropperContainer = document.getElementById("cropperContainer");
        const imageToCrop = document.getElementById("imageToCrop");
        const saveCropBtn = document.getElementById("saveCrop");
        const skipCropBtn = document.getElementById("skipCrop");

        console.log("submit button:",submitBtn);
        let cropper , croppedImages = [] , fileQueue =[] , currentFileIndex = 0;

        let deleted = [];
        window.removeImage = (filename,event) => {
            if(!event) return;
            deleted.push(filename);
            document.getElementById("deleteImages").value = JSON.stringify(deleted);
            event.target.closest("div").remove();
        };

        fileInput.addEventListener("change", (event) => {
            fileQueue = Array.from(event.target.files);
            currentFileIndex = 0;

            if(fileQueue.length){
                startCropping(fileQueue[currentFileIndex]);
            }
        });

        function startCropping(file){
            const reader = new FileReader();
            reader.onload = (e) => {
                imageToCrop.src = e.target.result;
                cropperContainer.classList.remove("d-none");

                if (cropper) cropper.destroy();
                cropper = new Cropper(imageToCrop, {
                    aspectRatio: 1,
                    viewMode: 1
                });
            };
            reader.readAsDataURL(file);
        }

        saveCropBtn.addEventListener("click", () => {
            if(!cropper)return;
            cropper.getCroppedCanvas().toBlob((blob) => {
                appendCroppedImage(blob);
                nextImage();
            },"image/jpeg");
        });

        skipCropBtn.addEventListener("click",() =>{
            appendCroppedImage(fileQueue[currentFileIndex]);
            nextImage();
        });

        function appendCroppedImage(blobOrFile){
            const url = URL.createObjectURL(blobOrFile);
            const img = document.createElement("img");
            img.src = url;
            img.classList.add("img-thumbnail");
            img.style.cssText = "width:80px;height:80px;object-fit:cover;";
            croppedPreview.appendChild(img);

            const file = new File([blobOrFile],`image_${Date.now()}.jpg`,{type:"image/jpeg"});
            croppedImages.push(file);

        }

        function nextImage(){
            currentFileIndex++;
            if(currentFileIndex < fileQueue.length){
                startCropping(fileQueue[currentFileIndex]);
            }else{
                cropperContainer.classList.add("d-none");
                if(cropper)cropper.destroy();
            }
        }

        submitBtn.addEventListener("click", (event) => {
            event.preventDefault();
            console.log("update button clicked")

            if(!validateForm()){
                console.error("Form validation failed");
                return
            }

            const formData = new FormData(form);
            croppedImages.forEach(file => formData.append("croppedImages",file));

            fetch(form.action,{
                method:"POST",
                body:formData
            })
            .then(async res => {
                const text = await res.text();
                console.log("server raw response:",res);
                try {
                    return JSON.parse(text);
                } catch (error) {
                    throw new Error("server did not return json")
                }
            })
            .then(data => {
                console.log("product saved:",data);
                if(data.success){
                    alert("Product updated successfully");
                    window.location.href = `/admin/productLists/edit/${data.productId}`;
                }else{
                    alert(data.error||"update failed");
                }
            })
            .catch(err => {
                console.error("upload error:",err);
                alert("something went wrong!");
            })
        });
    });

    function validateForm() {

        clearErrorMessages();
        let isValid = true;

        const name = document.getElementsByName('productName')[0].value;
        const description = document.getElementsByName('description')[0].value;
        const brand = document.getElementsByName('brand')[0].value;
        const regularPrice = document.getElementsByName('regularPrice')[0].value;
        const salePrice = document.getElementsByName('salePrice')[0].value;
        const color = document.getElementsByName('color')[0].value;
        const category = document.getElementsByName('category')[0].value;
        const subcategory = document.getElementsByName("subcategory")[0].value;
        const quantity=document.getElementsByName('quantity')[0].value;

        if (!name||name.trim() === "") {
            displayErrorMessage('productName-error', 'Please enter a product name.');
            isValid = false;
        }
          
        if (description === '') {
           displayErrorMessage('description-error', 'Please enter a product description.');
            isValid = false;
        }

        if(brand === ""){
            displayErrorMessage("brand-error","Please select brand");
            isValid = false;
        }

        if ( quantity === "" || parseInt(quantity) < 0 || isNaN(parseInt(quantity))) {
           displayErrorMessage('quantity-error', 'Please enter a valid non-negative quantity.');
            isValid = false;
        }

        if(color.trim() === ""){
            displayErrorMessage("color-error","please enter colour");
            isValid = false;
        }

        if(category === ""){
            displayErrorMessage("category-error, please select a category");
            isValid = false;
        }

        if(subcategory === ""){
            displayErrorMessage("subcategory-error","please select sub category");
            isValid = false;
        }

        if (!/^\d+(\.\d{1,2})?$/.test(regularPrice) || parseFloat(regularPrice) < 0) {
           displayErrorMessage('regularPrice-error', 'Please enter a valid non-negative price.');
            isValid = false;
        }
        if (!/^\d+(\.\d{1,2})?$/.test(salePrice) || parseFloat(salePrice) < 0) {
           displayErrorMessage('salePrice-error', 'Please enter a valid non-negative price.');
            isValid = false;
        }

        if(parseFloat(salePrice) > parseFloat(regularPrice)){
            displayErrorMessage("salePrice-error","sale price cannot be grater than regular price");
            isValid = false;
        }
          
       return isValid;
    }
       
    function displayErrorMessage(elementId, message) {
        var errorElement = document.getElementById(elementId);
        if(errorElement){
           errorElement.innerText = message;
           errorElement.style.display = "block";
        }else{
            console.error("Error element not found:",elementId);
        }
    }

    function clearErrorMessages() {
        const errorElements = document.getElementsByClassName('error-message');
        Array.from(errorElements).forEach(element => {
           element.innerText = '';
            element.style.display = 'none';
        });
    }

</script>

<%-include("../partials/admin/footer.ejs")%>