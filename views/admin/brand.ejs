<%-include("../partials/admin/header.ejs")%>

    <style>
        .pagination-container {
            text-align: center;
            margin-top: 20px;
        }
        .pagination {
            display: inline-block;
        }
        .pagination a,
        .pagination .current-page {
            display: inline-block;
            padding: 8px 12px;
            margin: 0 2px;
            border: 1px solid #ddd;
            text-decoration: none;
            color: #333;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .pagination a:hover {
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
        }
        .pagination .current-page{
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
            cursor: default;
        }
        .pagination .disabled{
            color: #6c757d;
            pointer-events: none;
            border-color: #6c757d;
            background-color: #f8f9fa;
        }
        .pagination-info{
            text-align: center;
            margin-bottom: 10px;
            color: #666;
            font-size: 12px;
        }
        .error-message {
            color: red;
        }
    </style>

    <section class="content-main">
        <div class="content-header">
            <div>
                <h2 class="content-title card-title">Brands</h2>
            </div>
            <div>
                <form method="get" action="/admin/brand">
                    <input type="text" 
                    name="search" 
                    value="<%= typeof search !== 'undefined' ? search : '' %>" 
                    placeholder="Search Sub Categories" 
                    class="form-control bg-white">
                    <button type="submit" class="btn btn-primary mt-2">Search</button>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <form method="post" action="/admin/brand" enctype="multipart/form-data" id="brandForm">
                            <div class="mb-4">
                                <label for="product_name" class="form-label">Brand Name</label>
                                <input type="text" id="name" name="name" placeholder="Type here" class="form-control" />
                                <small id="nameError" class="error-message"></small>
                            </div>
                            <% if(typeof errorMessage!== 'undefined'){ %>
                                <div class="error-message"><%= errorMessage %></div>
                            <% } %>
                            <label for="product_name" class="form-label">Brand Image</label>
                            <div class="input-upload">
                                <img src="" alt="" />
                                <input class="form-control border" id="image" name="image" type="file" accept="image/png, image/jpeg, image/jpg" />
                                <small id="imageError" class="error-message"></small>
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-primary mt-20" type="submit">
                                    Add Brand
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-7 ml-105">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Brand</th>
                                        <th>Logo</th>
                                        <th>Status</th>
                                        <th>Block/Unblock/Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% data.forEach((brand,index) => { %>
                                    <tr>
                                        <td class="text-start"><%=brand.brandName%></td>
                                        <td class="text-start">
                                            <div class="d-flex align-items-center justify-content-center" style=" width: 40px; height: 40px; border-radius: 50%; overflow: hidden;">
                                                <img src="/uploads/images/<%= brand.brandImage[0] %>" alt="<%=brand.brandName%>" class="img-fluid rounded-circle" style="width: 100%; height: auto" />
                                            </div>
                                        </td>
                                        <td class="text-start">
                                            <% if(brand.isBlocked === true){ %>
                                            <span class="badge rounded-pill alert-danger" style="width: 60px">Blocked</span>
                                            <% } else { %>
                                            <span class="badge rounded-pill alert-success" style="width: 60px">Active</span>
                                            <% } %>
                                        </td>
                                        <td class="text-start">
                                            <% if(brand.isBlocked === true){ %>
                                            <button class="btn btn-success statusBtn" data-id="<%=brand._id%>" data-status="unblock" style="width: 60px">
                                                <a href="#" class="text-white" style=" font-size: 9px;">Unblock</a>
                                            </button>
                                            <% } else { %>
                                            <button class="btn btn-danger statusBtn" data-id="<%=brand._id%>" data-status="block" style="width: 60px">
                                                <a href="#" class="text-white" style=" font-size: 9px;">Block</a>
                                            </button>
                                            <% } %>
                                            <button class="btn btn-danger" style="font-size: 9px; width: 55px;" onclick="return confirmAndDelete('<%= brand._id %>')">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% if(totalPage > 1){ %>
            <div class="pagination-info">
                <%= ((currentPage - 1) * 5) + 1 %> to <%= Math.min(currentPage * 5,totalBrand) %> of <%= totalBrand %> brands
            </div>
            <div class="pagination-container">
                <div class="pagination">

                    <% if(currentPage > 1){ %>
                        <a href="/admin/brand?page=<%= currentPage - 1 %>&search<%= search %>">&laquo; Previous</a>
                    <% } else { %>
                        <span class="disabled">&laquo; Previous</span>
                    <% } %>

                    <% if(currentPage > 3){ %>
                        <a href="/admin/brand?page=1">1</a>
                        <% if(currentPage > 4){ %>
                            <span class="disabled">...</span>
                        <% } %>
                    <% } %>

                    <%
                        let startPage = Math.max(1,currentPage-3);
                        let endPage = Math.min(totalPage,currentPage+3);
                    %>

                    <% for(let i = startPage; i <= endPage; i++){ %>
                        <% if(i === currentPage){ %>
                            <span class="current-page"><%= i %></span>
                        <% } else { %>
                            <a href="/admin/brand?page=<%= i %>&search<%= search %>"><%= i %></a>
                        <% } %>
                    <% } %>

                    <% if(currentPage < totalPage - 2){ %>
                        <% if(currentPage < totalPage - 3){ %>
                            <span class="disabled">...</span>
                        <% } %>
                        <a href="/admin/brand?page=<%= totalPage %>"><%= totalPage %></a>
                    <% } %>

                    <% if(currentPage < totalPage){ %>
                        <a href="/admin/brand?page=<%= currentPage + 1 %>&search<%= search %>">Next &raquo;</a>
                    <% } else { %>
                        <span class="disabled">Next &raquo;</span>
                    <% } %>

                </div>
            </div>
        <% } %>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById("brandForm").addEventListener("submit",(event) => {
            let isValid = true
            const name = document.getElementById("name").value.trim();
            const image = document.getElementById("image").files[0];
            let nameError = document.getElementById("nameError");
            let imageError = document.getElementById("imageError");

            const allowedTypes = ["image/png", "image/jpeg", "image/jpg"];
            const maxSizeInBytes = 2 * 1024 * 1024; // 2 MB

            nameError.textContent = "";
            imageError.textContent = "";

            if(!name || name.length < 3 || name.length > 20){
                nameError.textContent = "Brand Name should required , atleast 3-20 characters.";
                isValid = false
            }else if(!/^[a-zA-Z\s]+$/.test(name)){
                nameError.textContent = "Brand name must in alphabetic characters.";
                isValid = false;
            }
            if(!image){
                imageError.textContent = "Brand image should required. Please upload a image";
                isValid = false;
            }else if(!allowedTypes.includes(image.type)){
                imageError.textContent = "Brand image file should be JPG,JPEG or PNG";
                isValid = false;
                image.value = "";
            }else if (image.size > maxSizeInBytes) {
                imageError.textContent = 'File size must be less than 2 MB.';
                image.value = '';
                isValid = false;
            }
            if(!isValid){
                event.preventDefault();
            }

        });

        document.querySelectorAll(".statusBtn").forEach((btn) => {
            btn.addEventListener("click",async function(){
                let isBlocked = false;
                const brandId = this.dataset.id;
                const status = this.dataset.status;
                if(status === 'block'){
                    isBlocked = true
                }
                try {

                    const confirmResult = await Swal.fire({
                        icon:'warning',
                        title:'Are you sure?',
                        text:"This action should change status of the brand.",
                        showCancelButton:true,
                        confirmButtonColor:"#d33",
                        cancelButtonColor:"#3085d6",
                        confirmButtonText:"Yes. update it"
                    });
                    if(!confirmResult.isConfirmed)return

                    const response = await fetch("/admin/brand/toggleList",{
                        method:"PATCH",
                        headers:{
                            'Content-Type':'application/json'
                        },
                        body:JSON.stringify({brandId,isBlocked})
                    });
    
                    const data = await response.json();
                    if(data.success){
                        Swal.fire({
                            icon:'success',
                            title:"Updated.",
                            text:data.message,
                            showConfirmButton:false,
                            timer:2000
                        }).then(() => window.location.reload())
                    }else{
                        Swal.fire("Error!",data.message||"Failed to change status.","error");
                    }
                } catch (error) {
                    console.log("Something went wrong",error);
                    Swal.fire('Oops!','Something wrong while processing','error');
                }
            });
        });

        async function confirmAndDelete(id) {
            if(!id)return
            Swal.fire({
                title:"Are you sure to delete?",
                text:"This cannot be undone!",
                icon:"warning",
                showCancelButton:true,
                confirmButtonColor:"#d33",
                cancelButtonColor:"#3085d6",
                confirmButtonText:"Yes. Delete it"
            }).then(result => {
                if(result.isConfirmed){
                    fetch(`/admin/brand/${id}`,{
                        method:"PATCH"
                    }).then(res => res.json())
                    .then(data => {
                        if(data.success){
                            Swal.fire({
                                title:"Done.",
                                text:"Brand deleted successfully.",
                                icon:"success",
                                timer:1000,
                                showConfirmButton:false
                            }).then(() => window.location.reload())
                        }else{
                            Swal.fire("Error",data.message||"Failed to delete!","error")
                        }
                    })
                    .catch(err => {
                        Swal.fire("Error",err.message||"Somthing went wrong","error")
                    })
                }
            })
        }
    </script>

<%-include("../partials/admin/footer.ejs")%>