<%-include ("../partials/admin/header.ejs") %>

    <!-- Font Awesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" referrerpolicy="no-referrer" />
    <!-- offers css -->
    <link rel="stylesheet" href="/css/offer.css">

    <header>
        <div class="offers-container">
            <div class="header-content">
                <h1><i class="fas fa-tags"></i> Offer Management System</h1>
                <a href="/admin/offers/add" class="btn btn-success">
                    <i class="fas fa-plus"></i> Add New Offer
                </a>
            </div>
        </div>
    </header>
    
    <div class="offers-container">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title"><i class="fas fa-list"></i> Current Offers</h2>
                <div class="offer-stats">
                    <% if(activeCount){ %>
                        <span class="stat-item">
                            <span class="status status-active"><%= activeCount %> Active</span>
                        </span>
                    <% }%>
                    <% if(inactiveCount){ %>
                        <span class="stat-item">
                            <span class="status status-inactive"><%= inactiveCount %> Inactive</span>
                        </span>
                    <% } %>
                </div>
            </div>
            
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Offer Name</th>
                            <th>Type</th>
                            <th>Discount %</th>
                            <th>Applied To</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Sample data - in real app this would come from backend -->
                        <% if(offers && offers.length > 0){ %>
                            <% offers.forEach(offer => { %>
                                <tr>
                                    <td><%= offer.name %></td>
                                    <td><%= offer.offerType %></td>
                                    <td><%= offer.percentage %></td>
                                    <td>
                                        <% if (offer.offerAppliedTo === 'category' && offer.category) { %>
                                            <%= offer.category.map(cat => cat.name).join(", ") %>
                                        <% } else if (offer.offerAppliedTo === 'product' && offer.product) { %>
                                            <%= offer.product.map(pro => pro.productName).join(", ") %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td><%= new Date(offer.startDate).toLocaleDateString() %></td>
                                    <td><%= new Date(offer.endDate).toLocaleDateString() %></td>
                                    <% if(offer.isActive) { %>
                                        <td><span class="status status-active">Active</span></td>
                                    <% } else { %>
                                        <td><span class="status status-inactive">In Active</span></td>
                                    <% } %>
                                    <td>
                                        <div class="action-buttons">
                                            <button type="button" class="action-btn edit-btn" title="Edit Offer">
                                                <a href="/admin/offers/edit?offerId=<%= offer._id %>"><i class="fas fa-pen" style="color: white;"></i></a>
                                            </button>
                                            <button type="button" class="action-btn stop-btn" data-id="<%= offer._id %>" title="Stop Offer">
                                                <i class="fas fa-stop-circle"></i>
                                            </button>
                                            <button type="button" class="action-btn delete-btn" data-id="<%= offer._id %>" title="Delete Offer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" style="text-align:center;">No offers found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        const pauseBtn = document.querySelectorAll(".stop-btn");
        const deleteBtn = document.querySelectorAll (".delete-btn");

        pauseBtn.forEach(btn => {
            btn.addEventListener("click", async (e) => {
                e.preventDefault();
                const offerId = btn.dataset.id;
                const confirmResult = await Swal.fire({
                    icon:"warning",
                    title:"Are you sure ?",
                    text:"status will change when you submit",
                    showCancelButton:true,
                    cancelButtonColor:"#d33",
                    confirmButtonColor:"#3085d6",
                    confirmButtonText:"Yes , Change it."
                });
                if(!confirmResult.isConfirmed)return
                try {
                    const response = await fetch(`/admin/offers/toggle/${offerId}`,{
                        method:"PATCH",
                    });
                    const data = await response.json();
                    if(data.success){
                        Swal.fire({icon:"success",title:"Changed.",text:data.message,showConfirmButton:false,timer:1500});
                        window.location.href = "/admin/offers";
                    }else{
                        Swal.fire({icon:"error",title:"Failed!",text:"Failed to change offer status"});
                    }
                } catch (error) {
                    console.log("something wrong while processing:",error);
                    Swal.fire({icon:"error",title:"Oops!",text:"something wrong while processing"});
                }
            });
        });
        
        deleteBtn.forEach(btn => {
            btn.addEventListener("click",async (e) => {
                e.preventDefault();
                const offerId = btn.dataset.id;
                const confirmResult = await Swal.fire({
                    icon:"warning",
                    title:"Are you sure ?",
                    text:"This action permanently remove this offer from database.",
                    showCancelButton:true,
                    cancelButtonColor:"#d33",
                    confirmButtonColor:"#3085d6",
                    confirmButtonText:"Yes , Delete it."
                });
                if(!confirmResult.isConfirmed)return
                try {
                    const response = await fetch(`/admin/offers/remove/${offerId}`,{
                        method:"DELETE",
                    });
                    const data = await response.json();
                    if(data.success){
                        Swal.fire({icon:"success",title:"Deleted.",text:data.message,showConfirmButton:false,timer:1500});
                        window.location.href = "/admin/offers";
                    }else{
                        Swal.fire({icon:"error",title:"Failed!",text:"Failed to delete offer"});
                    }
                } catch (error) {
                    console.log("something wrong while processing:",error);
                    Swal.fire({icon:"error",title:"Oops!",text:"something wrong while processing"});
                }
            });
        });
    </script>

<%-include("../partials/admin/footer.ejs") %>