<%-include("../partials/admin/header.ejs") %>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Create New Coupon</h1>
                </div>

                <!-- Create Coupon Form -->
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Coupon Details</h5>
                            </div>
                            <div class="card-body">
                                <% if (typeof error !== 'undefined') { %>
                                    <div class="alert alert-danger"><%= error %></div>
                                <% } %>

                                <form id="couponForm">
                                    <div class="mb-3">
                                        <label for="name" class="form-label">Coupon Name *</label>
                                        <input type="text" class="form-control" id="name" name="name" >
                                        <div class="form-text">Unique name for the coupon</div>
                                        <small id="nameError" style="color: red;"></small>
                                    </div>

                                    <div class="mb-3">
                                        <label for="offerPrice" class="form-label">Discount Amount (₹) *</label>
                                        <input type="number" class="form-control" id="offerPrice" name="offerPrice" 
                                               min="1" step="0.01" >
                                        <div class="form-text">Fixed discount amount</div>
                                        <small id="discountError" style="color: red;"></small>
                                    </div>

                                    <div class="mb-3">
                                        <label for="minimumPrice" class="form-label">Minimum Order Amount (₹) *</label>
                                        <input type="number" class="form-control" id="minimumPrice" name="minimumPrice" >
                                        <div class="form-text">Minimum order amount required to apply this coupon</div>
                                        <small id="minimumPriceError" style="color: red;"></small>
                                    </div>

                                    <div class="mb-3">
                                        <label for="usageLimit" class="form-label">Usage Limit (Optional)</label>
                                        <input type="number" class="form-control" id="usageLimit" name="usageLimit" min="1"
                                            placeholder="Leave empty for no limit">
                                        <div class="form-text">Maximum number of times this coupon can be used. Leave empty for unlimited usage.</div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="startDate" class="form-label">Start Date *</label>
                                                <input type="date" class="form-control" id="startDate" name="startDate" >
                                            </div>
                                            <small id="startDateError" style="color: red;"></small>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="endDate" class="form-label">End Date *</label>
                                                <input type="date" class="form-control" id="endDate" name="endDate" >
                                            </div>
                                            <small id="endDateError" style="color: red;"></small>
                                        </div>
                                    </div>

                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                        <a href="/admin/coupons" class="btn btn-secondary me-md-2">Cancel</a>
                                        <button type="submit" class="btn btn-primary">Create Coupon</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Coupon Information</h6>
                            </div>
                            <div class="card-body">
                                <p><strong>Coupon Type:</strong> Fixed Amount</p>
                                <p class="text-muted small">
                                    This coupon provides a fixed discount amount when the order total meets the minimum amount requirement.
                                </p>
                                <hr>
                                <p class="small text-muted">
                                    <strong>Example:</strong><br>
                                    Coupon: WELCOME50<br>
                                    Discount: ₹50 off<br>
                                    Min Order: ₹500<br>
                                    Valid: 1st Jan - 31st Jan
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Set minimum date to today
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('startDate').min = today;
        document.getElementById('endDate').min = today;
        // Validate end date is after start date
        document.getElementById('startDate').addEventListener('change', function() {
            document.getElementById('endDate').min = this.value;
        });

        function validation(formData){
            let isValid = true;
            const errors = {
                nameError : "",
                discountError : "",
                minimumPriceError : "",
                offerError : "",
                startDateError : "",
                endDateError : ""
            };

            if(!formData.name.trim())errors.nameError = "Coupon name Should required";
            if(!formData.offerPrice.trim() || !/^\d+$/.test(formData.offerPrice.trim()))errors.discountError = "Coupon offer price should a digit";
            if(!formData.minimumPrice.trim()||!/^\d+$/.test(formData.offerPrice.trim()))errors.minimumPriceError = "Coupon offer price should a digit";
            if(!formData.startDate)errors.startDateError = "please select a date";
            if(!formData.endDate)errors.endDateError = "please select a date";

            Object.keys(errors).forEach(id => {
                const ele = document.getElementById(id);
                if(ele && errors[id]){
                    ele.textContent = errors[id];
                    isValid = false;
                }
            });
            return isValid
        };

        const couponForm = document.getElementById("couponForm");
        couponForm.addEventListener("submit",async (e) => {
            e.preventDefault();
            const formData = Object.fromEntries(new FormData(couponForm).entries());
            if(!validation(formData))return
            console.log("form validation completed");
            try {
                const response = await fetch("/admin/coupons/create",{
                    method:"POST",
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify(formData)
                });
                const data = await response.json();
                if(data.success){
                    Swal.fire({
                        icon:"success",
                        title:"Created.",
                        text:"Coupon created successfull.",
                        showConfirmButton:false,
                        timer:1500
                    })
                    .then(() => window.location.href = "/admin/coupons");
                }else{
                    Swal.fire({icon:"error",title:"Failed!",text:data.message});
                }
            } catch (error) {
                console.log("Something wrong while processing");
                Swal.fire({icon:"error",title:"Oops!",text:"Something wrong while processing"});
            }
        });

    </script>

<%-include("../partials/admin/footer.ejs") %>