<%-include("../partials/admin/header.ejs")%>

    <style>
        .pagination-container {
            text-align: center;
            margin-top: 20px;
        }
        .pagination {
            display: inline-block;
        }
        .pagination a,
        .pagination .current-page {
            display: inline-block;
            padding: 8px 12px;
            margin: 0 2px;
            border: 1px solid #ddd;
            text-decoration: none;
            color: #333;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .pagination a:hover {
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
        }
        .pagination .current-page{
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
            cursor: default;
        }
        .pagination .disabled{
            color: #6c757d;
            pointer-events: none;
            border-color: #6c757d;
            background-color: #f8f9fa;
        }
        .pagination-info{
            text-align: center;
            margin-bottom: 10px;
            color: #666;
            font-size: 12px;
        }
    </style>

        <section class="content-main">
            <div class="content-header">
                <h2 class="content-title">Customer List</h2>
            </div>
            <div class="card mb-4">
                <header class="card-header">
                    <div class="row gx-3">
                        <div class="col-lg-4 col-md-6 me-auto">
                            <form method="get" action="/admin/user">
                                <input 
                                type="text" 
                                name="search" 
                                placeholder="Search..." 
                                class="form-control"
                                value="<%= typeof search !== 'undefined' ? search : '' %>" >
                                <button type="submit" class="btn btn-primary mt-2">Search</button>
                            </form>
                        </div>
                    </div>
                </header>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Email</th>
                                    <th>Phone No</th>
                                    <th>Status</th>
                                    <th class="text-end"> Action </th>
                                </tr>
                            </thead>
                            <tbody>
                                <%for(let i=0;i<data.length;i++){%>
                                <tr>
                                    <td width="40%">
                                        <a href="#" class="itemside">
                                            <div class="info pl-3">
                                                <h6 class="mb-0 title"><%=data[i].name%></h6>
                                            </div>
                                        </a>
                                    </td>
                                    <td><%=data[i].email%></td>
                                    <td><%=data[i].phone%></td>
                                    <td>
                                        <%if(data[i].isBlocked === false){%>
                                            <span class="badge rounded-pill alert-success">Active</span>
                                            <button class="btn btn-danger" style="width: 70px; margin-left: 200px; ">
                                                <a href="/admin/blockCustomer?id=<%=data[i]._id%>" style="font-size: 10px; color: aliceblue; ">Block</a>
                                            </button>
                                        <%}else{%>
                                            <span class="badge rounded-pill alert-danger">Blocked</span>
                                            <button class="btn btn-success" style="width: 80px; margin-left: 150px; ">
                                                <a href="/admin/unBlockCustomer?id=<%=data[i]._id%>" style="font-size: 10px; color: aliceblue; ">Unblock</a>
                                            </button>
                                        <%}%>
                                    </td>
                                </tr>
                                <%}%>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% if(totalPages > 1){ %>
                <div class="pagination-info">
                    <%= ((currendPage-1)*5)+1 %> to <%= Math.min((currentPage*5,totalUsers)) %> of <%= totalUsers %> users
                </div>
                <div class="pagination-container">
                    <div class="pagination">
                        <% if(currentPage > 1){ %>
                            <a href="/admin/user?page=<%= currentPage - 1 %>&search<%= search %>">&laquo; Previous</a>
                        <% } else { %>
                            <span class="disabled">&laquo; Previous</span>
                        <% } %>

                        <% if(currentPage > 2){ %>
                            <% if(currentPage > 3){ %>
                                <a href="/admin/user?page=1">1</a>
                            <% } %>
                            <span class="disabled">...</span>
                        <%  } %>

                        <%
                        let startPage = Math.max(1,currentPage-3);
                        let endPage = Math.min(totalPages,currentPage+3);
                        %>

                        <% for(let i = startPage; i <= endPage; i++){ %>
                            <% if(i === currentPage){ %>
                                <span class="current-page"><%= i %></span>
                            <% } else { %>
                                <a href="/admin/user?page=<%= i %>&search<%= search %>"><%= i %></a>
                            <% } %>
                        <% } %>

                        <% if(currentPage < totalPages - 1){ %>
                            <% if(currentPage < totalPages - 2){ %>
                                <span class="disabled">...</span>
                            <% } %>
                            <a href="/admin/user?page=<%= totalPages %>"><%= totalPages %></a>
                        <% } %>

                        <% if(currentPage < totalPages){ %>
                            <a href="/admin/user?page=<%= currentPage + 1 %>&search<%= search %>">Next &raquo;</a>
                        <% } else { %>
                            <span class="disabled">Next &raquo;</span>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </section>
        

<%-include("../partials/admin/footer.ejs")%>