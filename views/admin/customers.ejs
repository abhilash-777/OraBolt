<%-include("../partials/admin/header.ejs")%>

    <style>
        .pagination-container {
            text-align: center;
            margin-top: 20px;
        }
        .pagination {
            display: inline-block;
        }
        .pagination a,
        .pagination .current-page {
            display: inline-block;
            padding: 8px 12px;
            margin: 0 2px;
            border: 1px solid #ddd;
            text-decoration: none;
            color: #333;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .pagination a:hover {
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
        }
        .pagination .current-page{
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
            cursor: default;
        }
        .pagination .disabled{
            color: #6c757d;
            pointer-events: none;
            border-color: #6c757d;
            background-color: #f8f9fa;
        }
        .pagination-info{
            text-align: center;
            margin-bottom: 10px;
            color: #666;
            font-size: 12px;
        }
    </style>

        <section class="content-main">
            <div class="content-header">
                <h2 class="content-title">Customer List</h2>
            </div>
            <div class="card mb-4">
                <header class="card-header">
                    <div class="row gx-3">
                        <div class="col-lg-4 col-md-6 me-auto">
                            <form method="get" action="/admin/user">
                                <input 
                                type="text" 
                                name="search" 
                                placeholder="Search..." 
                                class="form-control"
                                value="<%= typeof search !== 'undefined' ? search : '' %>" >
                                <button type="submit" class="btn btn-primary mt-2">Search</button>
                            </form>
                        </div>
                    </div>
                </header>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Email</th>
                                    <th>Phone No</th>
                                    <th>Status</th>
                                    <th class="text-end"> Action </th>
                                </tr>
                            </thead>
                            <tbody>
                                <%for(let i=0;i<data.length;i++){%>
                                <tr>
                                    <td width="40%">
                                        <a href="#" class="itemside">
                                            <div class="info pl-3">
                                                <h6 class="mb-0 title"><%=data[i].name%></h6>
                                            </div>
                                        </a>
                                    </td>
                                    <td><%=data[i].email%></td>
                                    <td><%=data[i].phone%></td>
                                    <td>
                                        <%if(data[i].isBlocked === false){%>
                                            <span id="status-<%= data[i]._id %>" class="badge rounded-pill alert-success">Active</span>
                                            <button class="btn btn-danger user-status-btn" data-user-id="<%= data[i]._id %>" style="width: 70px; margin-left: 200px; ">
                                                <a href="#" style="font-size: 10px; color: aliceblue; ">Block</a>
                                            </button>
                                        <%}else{%>
                                            <span id="status-<%= data[i]._id %>" class="badge rounded-pill alert-danger">Blocked</span>
                                            <button class="btn btn-success user-status-btn" data-user-id="<%= data[i]._id %>" style="width: 80px; margin-left: 150px; ">
                                                <a href="#" style="font-size: 10px; color: aliceblue; ">Unblock</a>
                                            </button>
                                        <%}%>
                                    </td>
                                </tr>
                                <%}%>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% if(totalPages > 1){ %>
                <div class="pagination-info">
                    <%= ((currendPage-1)*5)+1 %> to <%= Math.min((currentPage*5,totalUsers)) %> of <%= totalUsers %> users
                </div>
                <div class="pagination-container">
                    <div class="pagination">
                        <% if(currentPage > 1){ %>
                            <a href="/admin/user?page=<%= currentPage - 1 %>&search<%= search %>">&laquo; Previous</a>
                        <% } else { %>
                            <span class="disabled">&laquo; Previous</span>
                        <% } %>

                        <% if(currentPage > 2){ %>
                            <% if(currentPage > 3){ %>
                                <a href="/admin/user?page=1">1</a>
                            <% } %>
                            <span class="disabled">...</span>
                        <%  } %>

                        <%
                        let startPage = Math.max(1,currentPage-3);
                        let endPage = Math.min(totalPages,currentPage+3);
                        %>

                        <% for(let i = startPage; i <= endPage; i++){ %>
                            <% if(i === currentPage){ %>
                                <span class="current-page"><%= i %></span>
                            <% } else { %>
                                <a href="/admin/user?page=<%= i %>&search<%= search %>"><%= i %></a>
                            <% } %>
                        <% } %>

                        <% if(currentPage < totalPages - 1){ %>
                            <% if(currentPage < totalPages - 2){ %>
                                <span class="disabled">...</span>
                            <% } %>
                            <a href="/admin/user?page=<%= totalPages %>"><%= totalPages %></a>
                        <% } %>

                        <% if(currentPage < totalPages){ %>
                            <a href="/admin/user?page=<%= currentPage + 1 %>&search<%= search %>">Next &raquo;</a>
                        <% } else { %>
                            <span class="disabled">Next &raquo;</span>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </section>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>

            document.querySelectorAll(".user-status-btn").forEach(btn => {
                btn.addEventListener("click",async () => {
                    const userId = btn.getAttribute("data-user-id");
                    const statusSpan = document.getElementById(`status-${userId}`);
                    const statusContent = statusSpan.textContent;

                    const uri = statusContent === "Active" ? `/admin/blockCustomer?id=${userId}` : `/admin/unBlockCustomer?id=${userId}`;
                    const confirmResult = await Swal.fire({
                        icon:"warning",
                        title:"Are you sure ?",
                        text:"This action will change user status.",
                        showCancelButton:true,
                        cancelButtonColor:"#d33",
                        confirmButtonColor:"#3085d6",
                        confirmButtonText:"Yes , Do it."
                    });
                    if(!confirmResult.isConfirmed)return
                    try {
                        const response = await fetch(uri,{
                            method:"PATCH"
                        });
                        const data = await response.json();
                        if(data.success){
                            Swal.fire({
                                icon:"success",
                                title:"Updated.",
                                text:data.message,
                                showConfirmButton:false,
                                timer:1500
                            }).then(() => window.location.reload())
                        }else{
                            Swal.fire({icon:error,title:"Failed!",text:data.message||"Failed to change the user status"});
                        }
                    } catch (error) {
                        Swal.fire({icon:error,title:"Oops!",text:"Something wrong while processing"});
                    }
                });
            });

        </script>
        
<%-include("../partials/admin/footer.ejs")%>