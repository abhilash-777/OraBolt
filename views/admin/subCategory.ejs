<%-include("../partials/admin/header.ejs")%>

    <style>
        .actions{
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin: 10px 10px;
        }
        .create{
            margin-left: 5px;
            background-color: #ca9c06;
            color: white;
            border: 1px solid #ca9c06;
            font-size: 10px;
            font-weight: bolder;
        }
        .create:hover{
            background-color: #f4d261;
            color: black;
            border: 1px solid #f4d261;
        }
        .pagination-container {
            text-align: center;
            margin-top: 20px;
        }
        .pagination {
            display: inline-block;
        }
        .pagination a,
        .pagination .current-page {
            display: inline-block;
            padding: 8px 12px;
            margin: 0 2px;
            border: 1px solid #ddd;
            text-decoration: none;
            color: #333;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .pagination a:hover {
            background-color: rgb(202, 156, 6);
            color: #ddd;
            border-color: rgb(202, 156, 6);
        }
        .error-message {
            color: red;
        }
        .pagination .current-page{
            background-color: rgb(202, 156, 6);
            color: #ddd;
            border-color: rgb(202, 156, 6);
            cursor: default;
        }
        .pagination .disabled{
            color: #6c757d;
            border-color: #6c757d;
            pointer-events: none;
            background-color: #ddd;
        }
        .pagination-info{
            text-align: center;
            margin-top: 10px;
            font-size: 12px;
            color: #666;
        }
        .offer-input {
            width: 100px;
            margin-right: 5px;
        }
    </style>

    <section class="content-main">
        <div class="content-header">
            <div>
                <h2 class="content-title card-title">Sub Categories </h2>
                <p>Add, edit or delete a Sub Category</p>
            </div>
            <div class="actions">
                <form method="get" action="/admin/subCategory">
                    <input type="text" 
                    name="search" 
                    value="<%= typeof search !== 'undefined' ? search : '' %>" 
                    placeholder="Search Sub Categories" 
                    class="form-control bg-white">
                    <button type="submit" class="btn btn-primary mt-2">Search</button>
                </form>
                <button type="button" class="btn btn-success create" data-bs-toggle="modal" data-bs-target="#addSubCategoryModal">
                    <i class="material-icons md-add"></i> Add SubCategory
                </button>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-9">
                        <div class="table-responsive">
                            <table class="table table-hover" id="productTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>isListed</th>
                                        <th>List/Unlist</th>
                                        <th>Timestamp</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <%cat.forEach((subCategory,index)=> {%>

                                        <tr data-id="<%= subCategory._id %>">
                                            <td><%= subCategory.name %></td>
                                            <td><%= subCategory.description %></td>
                                            <td class="list-cell">
                                                <% if(subCategory.isListed) { %>
                                                    <span class="badge rounded-pill alert-success">Listed</span>
                                                <% } else { %>
                                                    <span class="badge rounded-pill alert-danger">UnListed</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if(subCategory.isListed) { %>
                                                    <button class="btn btn-danger btn-unlist">Unlist</button>
                                                <% } else { %>
                                                    <button class="btn btn-success btn-list">List</button>
                                                <% } %>
                                            </td>
                                            <td><%= new Date(subCategory.createdAt).toLocaleString() %></td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <a href="#" data-bs-toggle="dropdown"
                                                        class="btn btn-light rounded btn-sm font-sm">
                                                        <i class="material-icons md-more_horiz"></i>
                                                    </a>
                                                    <div class="dropdown-menu">
                                                        <a class="dropdown-item btn-edit" href="#"
                                                        data-id="<%= subCategory._id %>" data-name="<%= subCategory.name %>"
                                                        data-description="<%= subCategory.description %>"
                                                        data-category-id="<%= subCategory.categoryId ? subCategory.categoryId._id:"" %>">Edit info</a>
                                                        <a class="dropdown-item text-danger btn-delete"
                                                            href="#" data-id="<%= subCategory._id %>">Delete</a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <% if(totalPages > 1){ %>
            <div class="pagination-info">
                <%= ((currentPage - 1) * 5) + 1 %> to <%= Math.min(currentPage * 5,totalSubCategory) %> of <%= totalSubCategory %> Sub Categories
            </div>
            <div class="pagination-container">
                <div class="pagination">
                    <% if(currentPage > 1){ %>
                        <a href="/admin/subCategory?page=<%= currentPage - 1 %>&search=<%= search %>">&laquo; Previous</a>
                    <% } else { %>
                        <span class="disabled">&laquo; Previous</span>
                    <% } %>
                    <% if(currentPage > 3){ %>
                        <a href="/admin/subCategory?page=1">1</a>
                        <% if(currentPage > 4){ %>
                            <span class="disabled">...</span>
                        <% } %>
                    <% } %>
                    <%
                        let startPage = Math.max(1,currentPage - 3);
                        let endPage = Math.min(totalPages,currentPage + 3);
                    %>
                    <% for(let i = startPage; i <= endPage; i++){ %>
                        <% if(i === currentPage){ %>
                            <span class="current-page"><%= i %></span>
                        <% } else { %>
                            <a href="/admin/subCategory?page=<%= i %>&search=<%= search %>"><%= i %></a>
                        <% } %>
                    <% } %>
                    <% if(currentPage < totalPages - 2){ %>
                        <% if(currentPage < totalPages - 3){ %>
                            <span class="disabled">...</span>
                        <% } %>
                        <a href="/admin/subCategory?page=<%= totalPages %>"><%= totalPages %></a>
                    <% } %>
                    <% if(currentPage < totalPages){ %>
                        <a href="/admin/subCategory?page=<%= currentPage + 1 %>&search=<%= search %>">Next &raquo;</a>
                    <% } else { %>
                        <span class="disabled">Next &raquo;</span>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- Add SubCategory Modal -->
        <div class="modal fade" id="addSubCategoryModal" tabindex="-1" aria-labelledby="addSubCategoryModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addSubCategoryModalLabel">Add New SubCategory</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addSubCategoryForm">
                            <div class="mb-3">
                                <label for="add_name" class="form-label">Name</label>
                                <input type="text" placeholder="Enter Sub Category" name="name" class="form-control"
                                    id="add_name" />
                                <div class="error-message" id="add-name-error" style="display:none;"></div>
                            </div>
                            <div class="mb-3">
                                <label for="add_description" class="form-label">Description</label>
                                <input type="text" placeholder="Enter Description" name="description" class="form-control"
                                    id="add_description" />
                                <div class="error-message" id="add-description-error" style="display:none;"></div>
                            </div>
                            <div class="mb-3">
                                <label for="add_category" class="form-label">Category</label>
                                <select id="add_category" name="categoryId" class="form-select">
                                    <option value="">Select Category</option>
                                    <% categories.forEach(category=> { %>
                                        <option value="<%= category._id %>">
                                            <%= category.name %>
                                        </option>
                                        <% }) %>
                                </select>
                                <div class="error-message" id="add-category-error" style="display:none;"></div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="addSubCategoryBtn">Create SubCategory</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit SubCategory Modal -->
        <div class="modal fade" id="editSubCategoryModal" tabindex="-1" aria-labelledby="editSubCategoryModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editSubCategoryModalLabel">Edit SubCategory</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="editSubCategoryForm">
                            <input type="hidden" id="edit_subcategory_id">
                            <div class="mb-3">
                                <label for="edit_name" class="form-label">Name</label>
                                <input type="text" placeholder="Enter Sub Category" name="name" class="form-control"
                                    id="edit_name" />
                                <div class="error-message" id="edit-name-error" style="display:none;"></div>
                            </div>
                            <div class="mb-3">
                                <label for="edit_description" class="form-label">Description</label>
                                <input type="text" placeholder="Enter Description" name="description" class="form-control"
                                    id="edit_description" />
                                <div class="error-message" id="edit-description-error" style="display:none;"></div>
                            </div>
                            <div class="mb-3">
                                <label for="edit_category" class="form-label">Category</label>
                                <select id="edit_category" name="categoryId" class="form-select">
                                    <option value="">Select Category</option>
                                    <% categories.forEach(category=> { %>
                                        <option value="<%= category._id %>">
                                            <%= category.name %>
                                        </option>
                                        <% }) %>
                                </select>
                                <div class="error-message" id="edit-category-error" style="display:none;"></div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="editSubCategoryBtn">Update SubCategory</button>
                    </div>
                </div>
            </div>
        </div>

    </section>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        document.getElementById("addSubCategoryBtn").addEventListener("click",function(event) {
            event.preventDefault();

            if (!validateForm("add"))return;

            const name = document.getElementById("add_name").value.trim();
            const description = document.getElementById("add_description").value.trim();
            const categoryId = document.getElementById("add_category").value;

            fetch('/admin/subCategory/add', {
                method: "POST",
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ name, description,categoryId })
            })
            .then((response) => response.json())
            .then((data) => {
                if(data.success){
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addSubCategoryModal'));
                    modal.hide();
                    Swal.fire({
                        icon: "success",
                        title: "Created.",
                        text: "SubCategory added successfully",
                        timer: 1500,
                        showConfirmButton: false
                    })
                    .then(() => window.location.reload())
                }else{
                    Swal.fire({
                        icon: "error",
                        title: "Failed!",
                        text: data.message || "Failed to add new category category",
                    });
                }
            })
            .catch((err) => {
                console.log("Somethig went wrong while processing");
                Swal.fire({
                    icon: "error",
                    title: "Oops",
                    text: err.error||"Somethig went wrong while processing",
                });
            });
        });

        // Edit SubCategory - Open Modal
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const subcategoryId = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                const description = this.getAttribute('data-description');
                const categoryId = this.getAttribute('data-category-id');

                document.getElementById('edit_subcategory_id').value = subcategoryId;
                document.getElementById('edit_name').value = name;
                document.getElementById('edit_description').value = description;
                document.getElementById('edit_category').value = categoryId;

                clearErrorMessage('edit');

                const editModal = new bootstrap.Modal(document.getElementById('editSubCategoryModal'));
                editModal.show();
            });
        });

        document.getElementById("editSubCategoryBtn").addEventListener("click",async function(event){
            event.preventDefault();

            if(!validateForm("edit"))return

            const subCategoryId = document.getElementById("edit_subcategory_id").value;
            const name = document.getElementById("edit_name").value.trim();
            const description = document.getElementById("edit_description").value.trim();
            const category = document.getElementById("edit_category").value;

            const confirmResult = await Swal.fire({
                icon:"warning",
                title:"Are you sure?",
                text:"This cannot be undone!",
                showCancelButton:true,
                confirmButtonColor:"#d33",
                cancelButtonColor:"#3085d6",
                confirmButtonText:"Yes! Update it."
            });
            if(!confirmResult.isConfirmed)return

            fetch(`/admin/subCategory/edit/${subCategoryId}`,{
                method:"POST",
                headers:{
                    'Content-Type':'application/json'
                },
                body:JSON.stringify({name,description,category})
            })
            .then((res) => res.json())
            .then((data) => {
                if(data.success){
                    const modal = bootstrap.Modal.getInstance(document.getElementById('editSubCategoryModal'));
                    modal.hide();
                    Swal.fire({
                        icon:"success",
                        title:"Updated.",
                        text:data.message||"Sub category updated successfully.",
                        showConfirmButton:false,
                        timer:1500
                    }).then(() => window.location.reload())
                }else{
                    Swal.fire("Failed!",data.message||"Falled to edit","error");
                }
            })
            .catch((error) => {
                console.error("Something wrong while proccessing:",error);
                Swal.fire("Error!","Something wrong while proccessing","error");
            })
        });

        function validateForm(type) {
            clearErrorMessage(type);

            const name = document.getElementById(`${type}_name`).value.trim();
            const description = document.getElementById(`${type}_description`).value.trim();
            const categoryId = document.getElementById(`${type}_category`).value;
            let isValid = true;

            if (name === ""||!/^[a-zA-Z\s]+$/.test(name)) {
                displayErrorMessage(`${type}-name-error`, "subCategory name should contain alphabetic characters");
                isValid = false;
            }else if (name.length < 3) {
                displayErrorMessage(`${type}-name-error`, "subCategory name atleast contain 3 characters");
                isValid = false;
            }else if (name.length > 20) {
                displayErrorMessage(`${type}-name-error`, "subCategory name must be less than 20 characters");
                isValid = false;
            }

            if (description === "") {
                displayErrorMessage(`${type}-description-error`, "Please enter a description");
                isValid = false;
            }else if (description.length < 5) {
                displayErrorMessage(`${type}-description-error`, "subCategory description atleast contain 5 characters");
                isValid = false;
            }else if (description.length > 50) {
                displayErrorMessage(`${type}-description-error`, "subCategory description must be less than 50 characters");
                isValid = false;
            }

            if(categoryId === ""){
                displayErrorMessage(`${type}-category-error`,"Please select one category");
                isValid = false
            }

            return isValid;
        }

        function displayErrorMessage(elementId, errorMessage) {
            let errorElement = document.getElementById(elementId);
            if (errorElement) {
                errorElement.innerText = errorMessage;
                errorElement.style.display = "block";
            }
        }

        function clearErrorMessage(type) {
            if(type){
                document.getElementById(`${type}-name-error`).style.display = 'none';
                document.getElementById(`${type}-description-error`).style.display = 'none';
                document.getElementById(`${type}-category-error`).style.display = 'none';
            }else{
                const errorElements = document.getElementsByClassName("error-message");
                Array.from(errorElements).forEach((element) => {
                    element.innerText = "";
                    element.style.display = "none";
                });
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("productTable").addEventListener("click",(event) => {
                if(event.target.classList.contains("btn-delete")){
                    event.preventDefault();

                    const subCategoryId = event.target.getAttribute("data-id");
                    if(!subCategoryId)return;
                    Swal.fire({
                        icon:"warning",
                        title:"Are you sure to delete!",
                        text:"This cannot be undone!",
                        showCancelButton:true,
                        confirmButtonColor:"#d33",
                        cancelButtonColor:"#3085d6",
                        confirmButtonText:"Yes! Delete it."
                    }).then(result => {
                        if(result.isConfirmed){
                            fetch(`/admin/subCategory/${subCategoryId}`,{
                                method:"DELETE"
                            }).then(res => res.json())
                            .then(data =>{
                                if(data.success){
                                    Swal.fire({
                                        icon:"success",
                                        title:"Deleted.",
                                        text:"SubCategory deleted successfully.",
                                        timer:1500,
                                        showConfirmButton:false
                                    }).then(() => window.location.reload())
                                }else{
                                    Swal.fire("Error",data.message||"Failed to delete!","error")
                                }
                            })
                            .catch(err => {
                                Swal.fire("Error",err.message||"Something went wrong","error")
                            })
                        }
                    })
                }
            })
        });

        document.addEventListener("DOMContentLoaded", () => {
            function setupToggleHandlers() {
                document.querySelectorAll(".btn-list , .btn-unlist").forEach((button) => {
                    button.addEventListener("click", async function () {
                        const row = button.closest("tr");
                        const subCategoryId = row.dataset.id;
                        const isListed = button.classList.contains("btn-list");

                        try {   
                            const confirmResult = await Swal.fire({
                                icon:"warning",
                                title:"Are you sure to update!",
                                text:"This cannot be undone!",
                                showCancelButton:true,
                                confirmButtonColor:"#d33",
                                cancelButtonColor:"#3085d6",
                                confirmButtonText:"Yes! update it."
                            });
                            if(!confirmResult.isConfirmed)return

                            const response = await fetch("/admin/SubCategory/toggleList", {
                                method: "PATCH",
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    subCategoryId,
                                    isListed: isListed
                                }),
                            });

                            const result = await response.json();
                            if (result.success) {
                                const listCell = row.querySelector(".list-cell");
                                listCell.innerHTML = isListed ? "<p>Listed</P>":"<p>Unlisted</p>";

                                button.textContent = isListed ? "unList" : "List";
                                button.classList = isListed ? "btn-unlist" : "btn-list"
                                location.reload();
                            } else {
                                Swal.fire({icon:'error',title:"Failed!",text:"Failed to update listing status"});
                            }
                        } catch (error) {
                            console.error("error listing toggle error", error);
                            Swal.fire({icon:'error',title:"Oops!",text:"Server error while updating listing"});
                        }
                    });
                });
            }
            setupToggleHandlers();
        });

    </script>

<%-include("../partials/admin/footer.ejs")%>