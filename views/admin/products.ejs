<%-include("../partials/admin/header.ejs") %>

<link href="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.css" rel="stylesheet">

<style>
    .pagination-container {
        text-align: center;
        margin-top: 20px;
    }
    .pagination {
        display: inline-block;
    }
    .pagination a,
    .pagination .current-page {
        display: inline-block;
        padding: 8px 12px;
        margin: 0 2px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: #ffffff;
        background-color: #ca9c06;
        border-radius: 4px;
        transition: all 0.3s ease;
    }
    .pagination a:hover {
        background-color: rgb(251, 212, 85);
        color: rgb(6, 6, 6);
        border-color: rgb(202, 156, 6);
    }
    .pagination .active {
        color: rgb(202, 156, 6);
        border-color: rgb(202, 156, 6);
        cursor: default;
    }
    .pagination .disabled {
        color: #6c757d;
        pointer-events: none;
        border-color: #6c757d;
        background-color: #f8f9fa;
    }
    .pagination-info {
        text-align: center;
        margin-bottom: 10px;
        color: #666;
        font-size: 12px;
    }
    .modal-xl {
        max-width: 900px;
    }
    #cropperContainer {
        display: none;
        margin-top: 15px;
    }
    #cropperContainer img {
        max-width: 100%;
        max-height: 400px;
    }
    .cropped-preview-item {
        position: relative;
        display: inline-block;
    }
    .cropped-preview-item img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 5px;
    }
    .cropped-preview-item .remove-image {
        position: absolute;
        top: -8px;
        right: -8px;
        background: red;
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
    }
    #productModal textarea.form-control { min-height: 100px !important; resize: vertical !important; }
    #productModal .form-select { font-weight: bold !important; }  /* Highlights selected */
</style>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Products List</h2>
        </div>
        <div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productModal" onclick="openAddModal()">
                <i class="material-icons md-plus"></i> Add New Product
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <header class="card-header">
            <form id="filterForm">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3 col-12 mb-md-0 mb-3">
                        <input type="text" class="form-control" name="search" 
                            placeholder="Search products..." value="<%= query.search || '' %>">
                    </div>
                    <div class="col-md-3 col-12 me-auto mb-md-0 mb-3">
                        <select class="form-select" name="category">
                            <option value="">All categories</option>
                            <% if(category && category.length > 0){ %>
                                <% category.forEach(c => { %>
                                    <option value="<%= c._id %>" <%= query.category == c._id ? "selected" : "" %>>
                                        <%= c.name %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-2 col-6">
                        <select class="form-select" name="status">
                            <option value="all">All Status</option>
                            <option value="Available" <%= query.status == "Available" ? "selected" : "" %>>Available</option>
                            <option value="Out of Stock" <%= query.status == "Out of Stock" ? "selected" : "" %>>Out of Stock</option>
                            <option value="Not Available" <%= query.status == "Not Available" ? "selected" : "" %>>Not Available</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-12">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                </div>
            </form>
        </header>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Sl.No</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Category</th>
                            <th>Stock</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>List/Unlist</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% product.forEach((product, index) => { %>
                            <tr data-id="<%= product._id %>">
                                <td><%= ((currentPage - 1) * 6) + index + 1 %></td>
                                <td>
                                    <% if(product.image && product.image.length > 0){ %>
                                        <img src="/uploads/productsImages/<%= product.image[0] %>" 
                                             alt="Product" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                                    <% } else { %>
                                        <span>No Image</span>
                                    <% } %>
                                </td>
                                <td><%= product.productName %></td>
                                <td><%= product.brand?.brandName %></td>
                                <td><%= product.category?.name %></td>
                                <td>
                                    <% if(product.quantity <= 0){ %>
                                        <span class="badge bg-danger">Out Of Stock</span>
                                    <% } else { %>
                                        <%= product.quantity %>
                                    <% } %>
                                </td>
                                <td>&#8377;<%= product.regularPrice %></td>
                                <td>
                                    <% if(product.isBlocked){ %>
                                        <span class="badge bg-danger">Unlisted</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Listed</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if(product.isBlocked){ %>
                                        <button class="btn btn-success btn-sm btn-toggle-list">List</button>
                                    <% } else { %>
                                        <button class="btn btn-danger btn-sm btn-toggle-list">Unlist</button>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <a href="#" data-bs-toggle="dropdown" class="btn btn-light rounded btn-sm">
                                            <i class="material-icons md-more_horiz"></i>
                                        </a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item btn-edit" href="#" 
                                               data-id="<%= product._id %>">Edit</a>
                                            <a class="dropdown-item text-danger btn-delete" href="#" 
                                               data-id="<%= product._id %>">Delete</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <% if(totalPages > 1){ %>
        <div class="pagination-info">
            <%= ((currentPage - 1) * 6) + 1 %> to <%= Math.min(currentPage * 6, totalProducts) %> of <%= totalProducts %> total products
        </div>
        <div class="pagination-container">
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="/admin/productLists?page=<%= currentPage - 1 %>">&laquo; Previous</a>
                <% } else { %>
                    <span class="disabled">&laquo; Previous</span>
                <% } %>
            
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="active"><%= i %></span>
                    <% } else { %>
                        <a href="/admin/productLists?page=<%= i %>"><%= i %></a>
                    <% } %>
                <% } %>
            
                <% if (currentPage < totalPages) { %>
                    <a href="/admin/productLists?page=<%= currentPage + 1 %>">Next &raquo;</a>
                <% } else { %>
                    <span class="disabled">Next &raquo;</span>
                <% } %>
            </div>
        </div>
    <% } %>
</section>

<!-- Product Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add New Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="productForm" enctype="multipart/form-data">
                    <input type="hidden" id="productId" name="productId">
                    <input type="hidden" id="deleteImages" name="deleteImages">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Product Name *</label>
                            <input type="text" name="productName" class="form-control">
                            <div class="error-message text-danger" id="nameError"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Brand *</label>
                            <select name="brand" class="form-select">
                                <option value="">Select Brand</option>
                                <% brand.forEach(b => { %>
                                    <option value="<%= b._id %>"><%= b.brandName %></option>
                                <% }) %>
                            </select>
                            <div class="error-message text-danger" id="brandError"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <textarea name="description" class="form-control"></textarea>
                        <div class="error-message text-danger" id="descriptionError"></div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Category *</label>
                            <select name="category" class="form-select">
                                <option value="">Select Category</option>
                                <% category.forEach(c => { %>
                                    <option value="<%= c._id %>"><%= c.name %></option>
                                <% }) %>
                            </select>
                            <div class="error-message text-danger" id="categoryError"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Sub Category *</label>
                            <select name="subcategory" class="form-select">
                                <option value="">Select Sub Category</option>
                                <% subcategory.forEach(s => { %>
                                    <option value="<%= s._id %>"><%= s.name %></option>
                                <% }) %>
                            </select>
                            <div class="error-message text-danger" id="subcategoryError"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Color *</label>
                            <input type="text" name="color" class="form-control">
                            <div class="error-message text-danger" id="colorError"></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Regular Price *</label>
                            <input type="number" name="regularPrice" class="form-control" step="1" min="0">
                            <div class="error-message text-danger" id="regularPriceError"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Sale Price *</label>
                            <input type="number" name="salePrice" class="form-control" step="1" min="0">
                            <div class="error-message text-danger" id="salePriceError"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Quantity *</label>
                            <input type="number" name="quantity" class="form-control" min="0">
                            <div class="error-message text-danger" id="quantityError"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Product Images * (Min 3 images)</label>
                        <input type="file" id="images" class="form-control" accept="image/jpeg,image/png,image/jpg">
                        <div class="error-message text-danger" id="image-error"></div>
                    </div>

                    <div id="cropperContainer">
                        <img id="imageToCrop">
                        <button type="button" id="saveCrop" class="btn btn-primary btn-sm mt-2">Save Crop</button>
                    </div>

                    <div id="croppedPreview" class="d-flex flex-wrap gap-3 mt-3"></div>
                    <div id="existingImages" class="d-flex flex-wrap gap-3 mt-3"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitProduct">Save Product</button>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    let cropper;
    let croppedImages = [];
    let imagesToDelete = [];
    let isEditMode = false;
    let currentProductId = null;

    const fileInput = document.getElementById("images");
    const cropperContainer = document.getElementById("cropperContainer");
    const imageToCrop = document.getElementById("imageToCrop");
    const saveCropBtn = document.getElementById("saveCrop");
    const croppedPreview = document.getElementById("croppedPreview");

    function openAddModal() {
        isEditMode = false;
        currentProductId = null;
        document.getElementById("modalTitle").textContent = "Add New Product";
        document.getElementById("productForm").reset();
        croppedImages = [];
        imagesToDelete = [];
        croppedPreview.innerHTML = "";
        document.getElementById("existingImages").innerHTML = "";
        clearErrors();
    }

    document.querySelectorAll(".btn-edit").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.preventDefault();
            isEditMode = true;
            const productId = btn.getAttribute("data-id");
            await loadProductData(productId);
            new bootstrap.Modal(document.getElementById("productModal")).show();
        });
    });

    async function loadProductData(productId) {
        try {
            const response = await fetch(`/admin/productLists/get/${productId}`);
            const data = await response.json();
        
            if (data.success) {
                isEditMode = true;
                currentProductId = productId;
                const product = data.product;

                document.getElementById("productForm").reset();
            
                document.getElementById("modalTitle").textContent = "Edit Product";
                document.getElementById("productId").value = productId;
            
                const productNameInput = document.querySelector('#productModal input[name="productName"]');
                const descriptionInput = document.querySelector('#productModal textarea[name="description"]');
                const brandSelect = document.querySelector('#productModal select[name="brand"]');
                const categorySelect = document.querySelector('#productModal select[name="category"]');
                const subcategorySelect = document.querySelector('#productModal select[name="subcategory"]');
                const colorInput = document.querySelector('#productModal input[name="color"]');
                const regularPriceInput = document.querySelector('#productModal input[name="regularPrice"]');
                const salePriceInput = document.querySelector('#productModal input[name="salePrice"]');
                const quantityInput = document.querySelector('#productModal input[name="quantity"]');
            
                productNameInput.value = product.productName || "";
                descriptionInput.value = product.description || "";
                colorInput.value = product.color || "";
                regularPriceInput.value = product.regularPrice || "";
                salePriceInput.value = product.salePrice || "";
                quantityInput.value = product.quantity || "";
            
                const setSelectPre = (select, val) => {
                    if (select && val) {
                        const strVal = val.toString();
                        select.value = strVal;
                        for (let option of select.options) {
                            if (option.value === strVal) {
                                option.selected = true;
                                select.selectedIndex = Array.from(select.options).indexOf(option);
                                break;
                            }
                        }
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                };
                setSelectPre(brandSelect, product.brand);
                setSelectPre(categorySelect, product.category);
                setSelectPre(subcategorySelect, product.subcategory);
            
                croppedImages = [];
                imagesToDelete = [];
                const existingImagesDiv = document.getElementById("existingImages");
                existingImagesDiv.innerHTML = "<h6 class='w-100'>Existing Images:</h6>";
                (product.image || []).forEach(img => {
                    const div = document.createElement("div");
                    div.className = "cropped-preview-item";
                    div.innerHTML = `
                        <img src="/uploads/productsImages/${img}" style="max-width: 100px; max-height: 100px; object-fit: cover;">
                        <button type="button" class="remove-image" onclick="removeExistingImage('${img}')">×</button>
                    `;
                    existingImagesDiv.appendChild(div);
                });
                document.getElementById("croppedPreview").innerHTML = "";
                clearErrors();
            
                const modalElement = document.getElementById("productModal");
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            
                modalElement.addEventListener('shown.bs.modal', function postShowHandler() {
                    this.removeEventListener('shown.bs.modal', postShowHandler);
                
                    setTimeout(() => {
                        const postDescInput = document.querySelector('#productModal textarea[name="description"]');
                        const postCatSelect = document.querySelector('#productModal select[name="category"]');
                        const postSubCatSelect = document.querySelector('#productModal select[name="subcategory"]');
                        const postBrandSelect = document.querySelector('#productModal select[name="brand"]');                   
                    
                        if (postDescInput && product.description) {
                            postDescInput.value = product.description;
                            postDescInput.innerHTML = product.description;
                        
                            postDescInput.rows = Math.max(4, Math.ceil(product.description.length / 40));
                            postDescInput.scrollTop = 0;
                            postDescInput.focus();
                            postDescInput.blur();
                        
                            postDescInput.style.display = 'none';
                            postDescInput.offsetHeight;
                            postDescInput.style.display = 'block';
                        }
                    
                        const setSelectPost = (select, val) => {
                            if (select && val) {
                                const strVal = val.toString();
                                select.value = strVal;
                                let matched = false;
                                for (let option of select.options) {
                                    option.selected = false;
                                    if (option.value === strVal) {
                                        option.selected = true;
                                        matched = true;
                                    }
                                }
                                if (matched) {
                                    select.selectedIndex = Array.from(select.options).findIndex(o => o.selected);
                                    select.dispatchEvent(new Event('change', { bubbles: true }));
                                    select.focus();
                                    select.blur();
                                }
                            }
                        };
                        setSelectPost(postBrandSelect, product.brand);
                        setSelectPost(postCatSelect, product.category);
                        setSelectPost(postSubCatSelect, product.subcategory);
                    
                        modalElement.querySelector('.modal-body').scrollTop = 0;
                    }, 300);
                }, { once: true });
            }
        } catch (error) {
            console.error("loadProductData error:", error);
            Swal.fire("Error", "Failed to load product data", "error");
        }
    }

    function removeExistingImage(imageName) {
        imagesToDelete.push(imageName);
        document.getElementById("deleteImages").value = JSON.stringify(imagesToDelete);
        event.target.closest(".cropped-preview-item").remove();
    }

    fileInput.addEventListener("change", (e) => {
        const file = e.target.files[0];
        document.getElementById("image-error").textContent = "";
        
        if (!file) return;

        const allowedTypes = ["image/png", "image/jpg", "image/jpeg"];
        if (!allowedTypes.includes(file.type)) {
            document.getElementById("image-error").textContent = "Only JPG, JPEG and PNG files are allowed.";
            return;
        }

        const maxSize = 5 * 1024 * 1024;
        if (file.size > maxSize) {
            document.getElementById("image-error").textContent = "Image size should not exceed 5MB.";
            return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
            imageToCrop.src = e.target.result;
            cropperContainer.style.display = "block";

            if (cropper) cropper.destroy();
            cropper = new Cropper(imageToCrop, {
                aspectRatio: NaN,
                viewMode: 0,
                autoCropArea: 1,
                responsive: true,
                movable: true,
                zoomable: true,
                scalable: true,
                cropBoxResizable: true
            });
        };
        reader.readAsDataURL(file);
    });

    saveCropBtn.addEventListener("click", () => {
        if (!cropper) return;

        cropper.getCroppedCanvas().toBlob((blob) => {
            const file = new File([blob], `Product-${Date.now()}.png`, { type: "image/png" });
            croppedImages.push(file);

            const imgURL = URL.createObjectURL(file);
            const div = document.createElement("div");
            div.className = "cropped-preview-item";
            div.innerHTML = `
                <img src="${imgURL}">
                <button type="button" class="remove-image" onclick="removeCroppedImage(${croppedImages.length - 1})">×</button>
            `;
            croppedPreview.appendChild(div);

            cropper.destroy();
            cropperContainer.style.display = "none";
            fileInput.value = "";
        });
    });

    function removeCroppedImage(index) {
        croppedImages.splice(index, 1);
        event.target.closest(".cropped-preview-item").remove();
    }

    document.getElementById("submitProduct").addEventListener("click", async () => {

        const existingImageCount = document.querySelectorAll("#existingImages .cropped-preview-item").length;
        const totalImages = existingImageCount + croppedImages.length;

        const formData = new FormData(document.getElementById("productForm"));
        const payload = Object.fromEntries(formData.entries());

        if(!validateForm(payload)){
            if (totalImages === 0||totalImages < 3) {
                document.getElementById("image-error").textContent = "Please upload at least 3 images";
                return;
            }
            return
        }
        if (totalImages < 3) {
            document.getElementById("image-error").textContent = "Please upload at least 3 images";
            return;
        }

        croppedImages.forEach(file => {
            formData.append("images", file);
        });
        
        const url = isEditMode ? `/admin/productLists/edit/${currentProductId}` : "/admin/addProduct";
        
        try {
            const response = await fetch(url, {
                method: "POST",
                body: formData
            });

            const data = await response.json();
            if (data.success) {
                Swal.fire({
                    icon: "success",
                    title: isEditMode ? "Updated" : "Added",
                    text: data.message,
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    bootstrap.Modal.getInstance(document.getElementById("productModal")).hide();
                    window.location.reload();
                });
            } else {
                Swal.fire("Error", data.message, "error");
            }
        } catch (error) {
            Swal.fire("Error", "Something went wrong", "error");
        }
    });

    function validateForm(payload) {
        clearErrors();
        let isValid = true;

        let errors = {
            nameError : "",
            brandError : "",
            descriptionError : "",
            quantityError : "",
            categoryError : "",
            subcategoryError : "",
            colorError : "",
            regularPriceError : "",
            salePriceError : "",
        }

        document.querySelectorAll(".error-message").forEach(elem => elem.textContent = "");

        if(!payload.productName){
            errors.nameError = "Please enter product name";
            isValid = false;
        }else if(!/^(?!-)(?!.*--)(?!.*'')(?!.*\s\s)[a-zA-Z0-9\s-']{2,100}$/.test(payload.productName)){
            errors.nameError = "Please enter a valid product name ,(eg: 'Samsung watch 3Pro')";
            isValid = false;
        }
        if(!payload.description){
            errors.descriptionError = "please fill description";
            isValid = false;
        }else if (!/^(?=.*[a-zA-Z])[a-zA-Z0-9\s\p{P}\p{S}]{10,2000}$/u.test(payload.description)){
            errors.descriptionError = "Description should contain in between 10 to 2000 characters";
            isValid = false;
        }
        if(!payload.brand){
            errors.brandError = "Please select a brand";
            isValid = false;
        }
        if(!payload.category){
            errors.categoryError = "Please select a category";
            isValid = false;
        }
        if(!payload.subcategory){
            errors.subcategoryError = "Please select a sub category";
            isValid = false;
        }
        if(!payload.color){
            errors.colorError = "Please enter colour";
            isValid = false;
        }
        if(!payload.quantity){
            errors.quantityError = "Please enter quantity";
            isValid = false;
        }else if(parseInt(payload.quantity) < 0){
            errors.quantityError = "Negative quantity not allowed";
            isValid = false;
        }

        if(!payload.regularPrice){
            errors.regularPriceError = "Regular price should require. Please add regular price";
            isValid = false;
        }else if(parseFloat(payload.regularPrice) <= 0){
            errors.regularPriceError = "Maintain minimum regular price 1 , should not allowed negative values";
            isValid = false;
        }else if(parseFloat(payload.salePrice) > parseFloat(payload.regularPrice)) {
            errors.salePriceError = "Regular price should grater than sale price";
            isValid = false;
        }

        if(!payload.salePrice){
            errors.salePriceError = "Sale price should require. Please add sale price";
            isValid = false;
        }else if(parseFloat(payload.salePrice) <= 0){
            errors.salePriceError = "Maintain minimum sale price 1 , should not allowed negative values";
            isValid = false;
        }else if(parseFloat(payload.salePrice) > parseFloat(payload.regularPrice)) {
            errors.salePriceError = "Sale price cannot be greater than regular price";
            isValid = false;
        }

        Object.keys(errors).forEach((id) => { 
            document.getElementById(id).textContent = errors[id];
            if(errors[id])isValid = false
        })

        return isValid;
    }

    function clearErrors() {
        document.querySelectorAll(".error-message").forEach(el => el.textContent = "");
    }

    document.querySelectorAll(".btn-toggle-list").forEach(btn => {
        btn.addEventListener("click", async function() {
            const row = btn.closest("tr");
            const productId = row.dataset.id;
            const isBlocked = btn.textContent.trim() === "Unlist";

            try {
                const response = await fetch("/admin/productLists/toggleList", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ productId, isBlocked })
                });

                const result = await response.json();
                if (result.success) {
                    location.reload();
                }
            } catch (error) {
                Swal.fire("Error", "Failed to update status", "error");
            }
        });
    });

    document.querySelectorAll(".btn-delete").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.preventDefault();
            const productId = btn.getAttribute("data-id");

            const result = await Swal.fire({
                icon: "warning",
                title: "Are you sure?",
                text: "This product will be permanently deleted.",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it"
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/admin/productLists/remove/${productId}`, {
                    method: "DELETE"
                });

                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Deleted",
                        text: data.message,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => window.location.reload());
                }
            } catch (error) {
                Swal.fire("Error", "Something went wrong", "error");
            }
        });
    });
</script>

