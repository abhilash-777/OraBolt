<%-include("../partials/admin/header.ejs") %>

    <style>
        .pagination-container {
            text-align: center;
            margin-top: 20px;
        }
        .pagination {
            display: inline-block;
        }
        .pagination a,
        .pagination .current-page {
            display: inline-block;
            padding: 8px 12px;
            margin: 0 2px;
            border: 1px solid #ddd;
            text-decoration: none;
            color: #333;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .pagination a:hover {
            background-color: rgb(251, 212, 85);
            color: rgb(6, 6, 6);
            border-color: rgb(202, 156, 6);
        }
        .pagination a, .current-page{
            background-color: rgb(202, 156, 6);
            color: white;
            border-color: rgb(202, 156, 6);
            cursor: default;
        }
        .pagination .disabled{
            color: #6c757d;
            pointer-events: none;
            border-color: #6c757d;
            background-color: #f8f9fa;
        }
        .pagination-info{
            text-align: center;
            margin-bottom: 10px;
            color: #666;
            font-size: 12px;
        }
    </style>

    <section class="content-main">
        <div class="content-header">
            <div>
                <h2 class="content-title card-title">Products List</h2>
            </div>
        </div>
        <div class="card mb-4">
            <header class="card-header">
                <form id="filterForm">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3 col-12 mb-md-0 mb-3">
                            <input type="text" class="form-control" name="search" 
                                placeholder="Search products..." value="<%= query.search || '' %>">
                        </div>
                        <div class="col-md-3 col-12 me-auto mb-md-0 mb-3">
                            <select class="form-select" name="category">
                                <option value="">All categories</option>
                                <% if(category && category.length > 0){ %>
                                    <% category.forEach(c => { %>
                                        <option value="<%= c._id %>" <%= query.category == c._id ? "selected" : "" %>>
                                            <%= c.name %>
                                        </option>
                                    <% }) %>
                                <% } else { %>
                                    <option disabled>No categories found</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-2 col-6">
                            <select class="form-select" name="status">
                                <option value="all">All Status</option>
                                <option value="Available" <%= query.status == "Available" ?"selected":"" %>>Available</option>
                                <option value="Out of Stock" <%= query.status == "Out of Stock" ?"selected":"" %>>Out of Stock</option>
                                <option value="Not Available" <%= query.status == "Not Available" ?"selected":"" %>>Not Available</option>
                            </select>
                        </div>
                        <div class="col-md-2 col-12">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                    </div>
                </form>
            </header> <!-- card-header end// -->
            <div class="col-md-9 table">
                <div class="table-responsive">
                    <table class="table table-hover" id="productTable">
                        <thead>
                            <tr>
                                <th>Sl.No</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Brand</th>
                                <th>Category</th>
                                <th>Stock</th>
                                <th>Price</th>
                                <th>isListed</th>
                                <th>List/Unlist</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% product.forEach((product,index) => { %>
                                <tr data-id="<%= product._id %>">
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <% if(product.image && product.image.length > 0){ %>
                                            <img src="/uploads/productsImages/<%= product.image[0] %>" alt="Product Image" style="width: 50px; height: 50px; object-fit: cover;  border-radius: 5px;">
                                        <% } else { %>
                                            <span>No Image</span>
                                        <% } %>
                                    </td>
                                    <td><%= product.productName %></td>
                                    <td><%= product.brand?.brandName %></td>
                                    <td><%= product.category?.name %></td>
                                    <td>
                                        <% if(product.quantity <= 0){ %>
                                            <span class="alert-danger">Out Of Stock</span>
                                        <% }else{ %>
                                            <%= product.quantity %>
                                        <% } %>
                                    </td>
                                    <td>&#8377;<%= product.regularPrice %></td>
                                    <td class="list-cell">
                                        <% if(product.isBlocked){ %>
                                            <span class="badge rounded-pill alert-danger">unlisted</span>
                                        <% } else { %>
                                            <span class=" badge rounded-pill alert-success">listed</span>
                                        <% } %>
                                    </td>
                                    <td class="list-cell">
                                        <% if(product.isBlocked){ %>
                                            <button class="btn btn-success btn-unblock">List</button>
                                        <% } else { %>
                                            <button class="btn btn-danger btn-block">UnList</button>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                                <a href="#" data-bs-toggle="dropdown" class="btn btn-light rounded btn-sm font-sm">
                                                    <i class="material-icons md-more_horiz"></i>
                                                </a>
                                            <div class="dropdown-menu">
                                                <a class="dropdown-item" href="/admin/productLists/edit/<%= product._id%>">Edit info</a>
                                                <a class="dropdown-item text-danger btn-delete" href="#" data-id="<%= product._id %>">Delete</a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div> 

        <% if(totalPages > 1){ %>
            <div class="pagination-info">
                <%= ((currentPage - 1) * 6) + 1 %> to <%= Math.min(currentPage * 6,totalProducts) %>  of <%= totalProducts %> total products
            </div>
            <div class="pagination-container">
                <div class="pagination">
                    <% if (currentPage> 1) { %>
                        <a href="/admin/productLists?page=<%= currentPage - 1 %>">&laquo; Previous</a>
                    <% } else { %>
                        <span class="disabled">&laquo; Previous</span>
                    <% } %>
                
                    <% for (let i=1; i <=totalPages; i++) { %>
                        <% if (i===currentPage) { %>
                            <span class="active"><%= i %></span>
                        <% } else { %>
                            <a href="/admin/productLists?page=<%= i %>"><%= i %></a>
                        <% } %>
                    <% } %>
                
                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/productLists?page=<%= currentPage + 1 %>">Next &raquo;</a>
                    <% } else { %>
                        <span class="disabled">Next &raquo;</span>
                    <% } %>
                </div>
            </div>
        <% } %> 
    </section>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll(".btn-delete").forEach(btn => {
            btn.addEventListener("click",async (event) => {
                event.preventDefault();
                
                const productId = btn.getAttribute("data-id");
                const confirmResult = await Swal.fire({
                    icon:"warning",
                    title:"Are you sure?",
                    text:"This product will permenantly delete from database.",
                    showCancelButton:true,
                    cancelButtonColor:"#d33",
                    confirmButtonColor:"#3085d6",
                    confirmButtonText:"Yes , Do it."
                });
                if(!confirmResult.isConfirmed)return
                try {
                    const response = await fetch(`/admin/productLists/remove/${productId}`,{
                        method:"DELETE"
                    });

                    const data = await response.json();
                    if(data.success){
                        Swal.fire({
                            icon:"success",
                            title:"Deleted.",
                            text:data.message||"Product deleted successfully.",
                            showConfirmButton:false,
                            timer:1500
                        })
                        .then(() => window.location.href = data.redirectUrl||"/admin/productLists")
                    }else{
                        Swal.fire({
                            icon:"error",
                            title:"Failed!",
                            text:data.message||"Failed to delete product",
                        })
                    }
                } catch (error) {
                    Swal.fire({
                        icon:"error",
                        title:"Oops!",
                        text:error.message||"Something went wrong"
                    })
                }
            })
        });

        document.addEventListener("DOMContentLoaded",() => {
            function setupToggleHandlers(){
                document.querySelectorAll(".btn-block , .btn-unblock").forEach((button) => {
                    button.addEventListener("click",async function() {
                        const row = button.closest("tr");
                        const productId = row.dataset.id;
                        const isBlocked = button.classList.contains("btn-block");
                        try {
                            const response = await fetch("/admin/productLists/toggleList",{
                                method:"POST",
                                headers:{
                                    "Content-Type":"application/json"
                                },
                                body:JSON.stringify({
                                    productId,
                                    isBlocked:isBlocked
                                })
                            });
                            const result = await response.json();
                            if(result.success){
                                const listCell = row.querySelector(".list-cell");
                                listCell.innerHTML = isBlocked?"<p>Listed</p>":"<p>UnListed</p>";

                                button.textContent = isBlocked?"UnList":"List";
                                button.classList = isBlocked?"btn-unlist":"btn-list";
                                location.reload();
                            }else{
                                alert("Failed to update listing status");
                            }
                        } catch (error) {
                            console.error("error occurs during product status updation:",error);
                            alert("server while updating product status!");
                        }
                    });
                });
            }
            setupToggleHandlers();
        });
    </script>
        
<%-include("../partials/admin/footer.ejs") %>