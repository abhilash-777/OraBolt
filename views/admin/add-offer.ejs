<%-include ("../partials/admin/header.ejs") %>

    <link rel="stylesheet" href="/css/offer.css">

    <div class="offers-container">
        <div class="card" id="add-offer-form">
            <div class="card-header">
                <h2 class="card-title"><i class="fas fa-plus-circle"></i> Add New Offer</h2>
            </div>
            
            <form id="offerForm">
                <div class="form-group">
                    <label for="offerName">Offer Name</label>
                    <input type="text" id="offerName" name="offerName" placeholder="Enter offer name" >
                    <small id="nameError" class="errorMsg"></small>
                </div>
                
                <div class="form-group">
                    <label for="offerType">Offer Type</label>
                    <select id="offerType" name="offerType" >
                        <option value="">Select offer type</option>
                        <option value="percentage">Percentage</option>
                    </select>
                    <small id="typeError" class="errorMsg"></small>
                </div>
                
                <div class="form-group">
                    <label for="offerValue">Offer Value (%)</label>
                    <input type="text" id="offerValue" name="offerValue" placeholder="Enter percentage" >
                    <small id="valueError" class="errorMsg"></small>
                </div>
                
                <div class="form-group">
                    <label for="offerAppliedTo">Offer Applied To</label>
                    <select id="offerAppliedTo" name="offerAppliedTo" >
                        <option value="">Select where to apply offer</option>
                        <option value="category">Category</option>
                        <option value="product">Product</option>
                    </select>
                    <small id="appliedToError" class="errorMsg"></small>
                </div>
                
                <div class="form-group" id="categoryField" style="display:none;">
                    <label>Select Category</label>
                    <select id="category" name="categories" multiple size="5">
                        <option value="">Select category</option>
                        <% categories.forEach(cat=> { %>
                            <option value="<%= cat._id %>">
                                <%= cat.name %>
                            </option>
                        <% }) %>
                    </select>
                    <small class="form-text">Hold ctrl (cmd on mac) to select multiple categories</small>
                    <small id="categoryError" class="errorMsg"></small>
                </div>
                
                <div class="form-group" id="productField" style="display:none;">
                    <label>Select Product</label>
                    <select id="product" name="products" multiple size="5">
                        <option value="">Select product</option>
                        <% products.forEach(prod=> { %>
                            <option value="<%= prod._id %>">
                                <%= prod.productName %>
                            </option>
                        <% }) %>
                    </select>
                    <small class="form-text">Hold ctrl (cmd on mac) to select multiple products</small>
                    <small id="productError" class="errorMsg"></small>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="startDate">Start Date</label>
                        <input type="date" id="startDate" name="startDate">
                        <small id="startDateError" class="errorMsg"></small>
                    </div>
                    
                    <div class="form-group">
                        <label for="endDate">End Date</label>
                        <input type="date" id="endDate" name="endDate" >
                        <small id="endDateError" class="errorMsg"></small>
                    </div>
                </div>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Add Offer
                    </button>
                    <a href="/admin/offers">
                        <button type="button" class="btn btn-secondary" id="cancelBtn">
                            <i class="fas fa-times"></i>Cancel
                        </button>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        const addOffer = document.getElementById("offerForm");
        const appliedTo = document.getElementById("offerAppliedTo");
        const categoryField = document.getElementById("categoryField");
        const productField = document.getElementById("productField");

        const startDateInput = document.getElementById("startDate");
        const endDateInput = document.getElementById("endDate");
        const today = new Date().toISOString().split('T')[0];
        startDateInput.min = today;

        startDateInput.addEventListener("change", () => {
            const start = startDateInput.value;
            if(start){
                endDateInput.min = start;
                if(endDateInput.value && endDateInput.value < start){
                    endDateInput.value =""
                }
            }else{
                endDateInput.min = today;
            }
        });

        appliedTo.addEventListener("change",() => {
            categoryField.style.display = appliedTo.value === "category" ? "block" : "none";
            productField.style.display = appliedTo.value === "product" ? "block" : "none";
        });

        function validation(payload){
            let isValid = true;
            const errors = {
                nameError : "",
                typeError : "",
                valueError : "",
                appliedToError : "",
                categoryError : "",
                productError : "",
                startDateError : "",
                endDateError : ""
            };

            if(!payload.offerName || !/^(?=.*[A-Za-z])[A-Za-z0-9\s._]+$/.test(payload.offerName.trim()))errors.nameError = "name Should start with characters";
            if(!payload.offerType)errors.typeError = "Offer type should required";
            if(!payload.offerValue.trim()||!/^\d+(\.\d+)?$/.test(payload.offerValue.trim())){
                errors.valueError = "Offer value should digits";
            }else{
                const value = Number(payload.offerValue);
                if (value < 1 || value > 100) {
                    errors.valueError = "Offer value should be between 1 and 100";
                    isValid = false;
                }
            }
            if(!payload.offerAppliedTo){
                errors.appliedToError = "Please select offer applied to";
            }else{
                if (payload.offerAppliedTo === "category") {
                    if (!Array.isArray(payload.categories) || payload.categories.length === 0) {
                        errors.categoryError = "Please select at least one category";
                    }
                }
                if (payload.offerAppliedTo === "product") {
                    if (!Array.isArray(payload.products) || payload.products.length === 0) {
                        errors.productError = "Please select at least one product";
                    }
                }
            }
            if(!payload.startDate)errors.startDateError = "Should required offer starting date";
            if(!payload.endDate)errors.endDateError = "Should required offer ending date";
            if (payload.startDate && payload.endDate) {
                const start = new Date(payload.startDate);
                const end = new Date(payload.endDate);
                if (end < start) {
                    errors.endDateError = "End date cannot be before start date";
                }
            }

            Object.keys(errors).forEach(id => {
                const ele = document.getElementById(id);
                if(ele && errors[id]){
                    ele.textContent = errors[id];
                    isValid = false
                }
            });
            return isValid
        };

        addOffer.addEventListener("submit",async (e) => {
            e.preventDefault();
            const formData = new FormData(addOffer);
            const payload = {};

            // Convert FormData to object and handle multiple select fields
            for (const [key, value] of formData.entries()) {
                if (key === "categories" || key === "products") {
                    // Handle multiple select fields as arrays
                    if (!payload[key]) {
                        payload[key] = formData.getAll(key).filter(val => val !== "");
                    }
                } else {
                    payload[key] = value;
                }
            }
            if(!validation(payload))return
            console.log("form validation success.");

            try {
                const response = await fetch("/admin/offers/add",{
                    method:"POST",
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify(payload)
                });

                const data = await response.json();
                if(data.success){
                    Swal.fire({
                        icon:"success",
                        title:"Added.",
                        text:data.message||"Offer added successfully.",
                        showConfirmButton:false,
                        timer:1500
                    })
                    then(() => window.location.href = "/admin/offers");
                }else{
                    Swal.fire({icon:"error",title:"Failed!",text:data.message||"Failed to create an offer"});
                }
            } catch (error) {
                console.log("something wrong while adding offer:",error);
                Swal.fire({icon:"error",title:"Oops!",text:"something wrong while adding offer"});
            }
        });

    </script>

<%-include ("../partials/admin/footer.ejs") %>