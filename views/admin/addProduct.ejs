<%-include("../partials/admin/header.ejs")%>

    <link  href="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.css" rel="stylesheet">

        <section class="content-main">
        <div class="row">
            <div class="col-6">
                <div class="content-header">
                    <h2 class="content-title">Add New Product</h2>
                </div>
            </div>
        </div>
            
        <form id="productForm" action="/admin/addProduct" method="post" enctype="multipart/form-data">

            <% if(typeof success !== 'undefined' && success){ %>
                <div class="alert alert-success alert-dismissible fade show" role="alert" >
                    <%= success %>
                    <button type="button" class="btn-closs" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if(typeof error !== 'undefined' && error){ %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert" >
                    <%= error %>
                    <button type="button" class="btn-closs" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="row">
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>1. General info</h6>
                                </div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Product Name</label>
                                        <input type="text" name="productName" placeholder="Enter product name" class="form-control"
                                            required>
                                        <div id="productName-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Description</label>
                                        <textarea name="description" placeholder="Enter description" class="form-control" rows="4"
                                            required></textarea>
                                        <div id="description-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Brand name</label>
                                        <select name="brand" class="form-select" required>
                                            <option value="">Select Brand</option>
                                            <% for(let i=0;i<brand.length;i++){ %>
                                                <option value="<%= brand[i].brandName %>">
                                                    <%= brand[i].brandName %>
                                                </option>
                                                <% } %>
                                        </select>
                                        <div id="brand-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Color</label>
                                        <input type="text" name="color" placeholder="Enter colour" class="form-control" required>
                                        <div id="color-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Quantity</label>
                                        <input type="text" name="quantity" placeholder="0" class="form-control" min="0" required>
                                        <div id="quantity-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>2. Pricing</h6>
                                </div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Regular Price</label>
                                        <input type="number" name="regularPrice" placeholder="0.00" step="0.01" min="0"
                                            class="form-control" required>
                                        <div id="regularPrice-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Sale Price</label>
                                        <input type="number" name="salePrice" placeholder="0.00" step="0.01" min="0"
                                            class="form-control" required>
                                        <div id="salePrice-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>3. Category</h6>
                                </div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <select name="category" class="form-select" required>
                                            <option value="">Select Category</option>
                                            <% for(let i=0;i<category.length;i++){ %>
                                                <option value="<%= category[i].name %>">
                                                    <%= category[i].name %>
                                                </option>
                                                <% } %>
                                        </select>
                                        <div id="category-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>4. Sub Category</h6>
                                </div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <select name="subcategory" class="form-select" required>
                                            <option value="">Select Sub Category</option>
                                            <% for(let i=0;i<subcategory.length;i++){ %>
                                                <option value="<%= subcategory[i].name %>">
                                                    <%= subcategory[i].name %>
                                                </option>
                                                <% } %>
                                        </select>
                                        <div id="subcategory-error" class="error-message text-danger" style="display: none;"></div>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>5. Media</h6>
                                </div>
                                <div class="col-md-9">
                                    <label for="images">Select product image</label>
                                    <input type="file" name="images" id="images" class="form-control" accept="image/jpeg,image/png,image/jpg">
                                    <div id="image-error" class="error-message text-danger" style="display: none;"></div>
                                </div>
                                <div id="cropperContainer">
                                    <img id="imageToCrop" style="max-width: 100%; max-height: 400px;">
                                    <button type="button" id="saveCrop" class="btn btn-primary btn-sm mt-2">Save Crop</button>
                                </div>
                                <h5 class="mt-3">Selected Images:</h5>
                                <div id="croppedPreview" class="d-flex flex-wrap gap-3"></div>
                                <div id="hiddenImages"></div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-12">
                                    <button type="button" id="publishButton" class="btn btn-primary">Add Product</button>
                                    <button type="reset" class="btn btn-secondary ms-2">Reset</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="imageDatas" name="imageDatas" value="" >

        </form>
    </section>

    <script src="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        document.addEventListener("DOMContentLoaded",() => {

            const form = document.getElementById("productForm");
            const submitBtn = document.getElementById("publishButton");

            let cropper;
            const fileInput = document.getElementById("images");
            const croppedPreview = document.getElementById("croppedPreview");
            const cropperContainer = document.getElementById("cropperContainer");
            const imageToCrop = document.getElementById("imageToCrop");
            const saveCropBtn = document.getElementById("saveCrop");
            let cropInstance = [];

            fileInput.addEventListener("change", (event) => {
                const file = event.target.files[0];
                const imageError = document.getElementById("image-error");
                if(imageError){
                    imageError.style.display = "none";
                    imageError.innerText = "";
                }
                if (!file) return;

                const allowedTypes = ["image/png","image/jpg","image/jpeg"];
                const fileExtension = file.name.toLowerCase().split(".").pop();
                const allowedExtension = ["jpeg","jpg","png"];

                if(!allowedTypes.includes(file.type) || !allowedExtension.includes(fileExtension)){
                    displayErrorMessage("image-error","Only JPG,JPEG and PNG files are allowed.");
                    return
                }
                const maxSize = 5 * 1024 * 1024;
                if(file.size > maxSize){
                    displayErrorMessage("image-error","Image size should not exeeed 5MB.");
                    return
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    imageToCrop.src = e.target.result;
                    cropperContainer.classList.remove("d-none");

                    if (cropper) cropper.destroy();
                    cropper = new Cropper(imageToCrop, {
                        aspectRatio: NaN,
                        viewMode: 0,
                        autoCropArea:1,
                        responsive:true,
                        movable:true,
                        zoomable:true,
                        scalable:true,
                        cropBoxResizable:true
                    });
                };
                reader.readAsDataURL(file);
            });

            saveCropBtn.addEventListener("click", () => {
                if (!cropper) return;

                cropper.getCroppedCanvas().toBlob((blob) => {
                    const file = new File([blob],`Product-${Date.now()}.png`,{type:"image/png"});
                    cropInstance.push(file);

                    const imgURL = URL.createObjectURL(file);
                    const img = document.createElement("img");
                    img.src = imgURL;
                    img.style.width = "80px";
                    img.style.height = "80px";
                    img.style.objectFit = "cover";
                    img.classList.add("border", "rounded");
                    croppedPreview.appendChild(img);

                    cropper.destroy();
                    cropperContainer.classList.add("d-none");
                    fileInput.value = "";
                });
            });

            submitBtn.addEventListener("click", (event) => {
                event.preventDefault();

                if (cropInstance.length < 3) {
                    validateAndSubmit();
                    displayErrorMessage("image-error","Please upload atleast 3 images");
                    return;
                }

                const formData = new FormData(form);
                
                cropInstance.forEach((file) => {
                    formData.append("images",file);
                });

                fetch(form.action,{
                    method:"POST",
                    body:formData
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success){
                        Swal.fire({
                            icon:"success",
                            title:"Added.",
                            text:"Product added successfully.",
                            showConfirmButton:false,
                            timer:1500
                        }).then(() => window.location.href = "/admin/productLists")
                    }else{
                        Swal.fire({icon:"error",title:"Failed!",text:"Failed to add a product"});
                    }
                })
                .catch(err => {
                    console.error("upload error:",err);
                    Swal.fire({icon:"error",title:"Oops!",text:"Something wrong while processing."});
                })
            });
        });

        function validateForm() {
           clearErrorMessages();
           let isValid = true;

            const name = document.getElementsByName('productName')[0].value;
            const description = document.getElementsByName('description')[0].value;
            const brand = document.getElementsByName('brand')[0].value;
            const regularPrice = document.getElementsByName('regularPrice')[0].value;
            const salePrice = document.getElementsByName('salePrice')[0].value;
            const color = document.getElementsByName('color')[0].value;
            const category = document.getElementsByName('category')[0].value;
            const subcategory = document.getElementsByName("subcategory")[0].value;
            const quantity=document.getElementsByName('quantity')[0].value;
            const images = document.getElementById("images");
            const hasImages = images && images.files && images.files.length > 0;

            if (name.trim() === "") {
                displayErrorMessage('productName-error', 'Please enter a product name.');
                isValid = false;
            }
          
            if (description === '') {
               displayErrorMessage('description-error', 'Please enter a product description.');
               isValid = false;
            }

            if(brand === ""){
                displayErrorMessage("brand-error","Please select brand");
                isValid = false;
            }

            if ( quantity === "" || parseInt(quantity) < 0 || isNaN(parseInt(quantity))) {
               displayErrorMessage('quantity-error', 'Please enter a valid non-negative quantity.');
               isValid = false;
            }

            if(color.trim() === ""){
                displayErrorMessage("color-error","please enter colour");
                isValid = false;
            }

            if(category === ""){
                displayErrorMessage("category-error", "please select a category");
                isValid = false;
            }

            if(subcategory === ""){
                displayErrorMessage("subcategory-error","please select sub category");
                isValid = false;
            }

            if (!/^\d+(\.\d{1,2})?$/.test(regularPrice) || parseFloat(regularPrice) < 0) {
               displayErrorMessage('regularPrice-error', 'Please enter a valid non-negative price.');
               isValid = false;
            }
            if (!/^\d+(\.\d{1,2})?$/.test(salePrice) || parseFloat(salePrice) < 0) {
               displayErrorMessage('salePrice-error', 'Please enter a valid non-negative price.');
               isValid = false;
            }

            if(parseFloat(salePrice) > parseFloat(regularPrice)){
                displayErrorMessage("salePrice-error","sale price cannot be grater than regular price");
                isValid = false;
            }
          
            if (!hasImages) {
               displayErrorMessage("images-error",'Please select an image.');
               isValid = false;
            }
           return isValid;
        }
       
        function displayErrorMessage(elementId, message) {
            var errorElement = document.getElementById(elementId);
            if(errorElement){
               errorElement.innerText = message;
               errorElement.style.display = "block";
            }else{
                console.error("Error element not found:",elementId);
            }
        }

        function clearErrorMessages() {
            const errorElements = document.getElementsByClassName('error-message');
            Array.from(errorElements).forEach(element => {
               element.innerText = '';
               element.style.display = 'none';
            });
        }

        function validateAndSubmit(){
            if(validateForm()){
                const form = document.getElementById("productForm");
                if(!form){
                    form = document.querySelector("form[action='/admin/addProduct']");
                }
                if(!form){
                    form = document.querySelector("form[method='post']");
                }
                if(!form){
                    form = document.querySelector("form");
                }
                if(!form){
                    form = document.forms[0];
                }
                console.log(form);
                if(form){
                    form.submit();
                }else{
                    console.error("form not found with any method");
                }
            }else{
                console.error("Form validation and submittion failed");
            }
        }

    </script>

<%-include("../partials/admin/footer.ejs")%>